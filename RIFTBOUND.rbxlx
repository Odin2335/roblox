builders.Rift_Crawler = function(m)
	local shell = Color3.fromRGB(46, 56, 66)
	P(m, Vector3.new(2.6, 1.2, 3.6), at(0, 1.3, 0), shell, { material = Enum.Material.Slate, name = "Torso" })
	P(m, Vector3.new(1.6, 0.9, 1.2), at(0, 1.3, -2.2), shell, { material = Enum.Material.Slate, name = "Head" })
	P(m, Vector3.new(0.3, 0.2, 0.1), at(-0.4, 1.4, -2.85), C.Rift, Neon)
	P(m, Vector3.new(0.3, 0.2, 0.1), at(0.4, 1.4, -2.85), C.Rift, Neon)
	for i = -1, 1 do
		for _, s in { -1, 1 } do
			P(m, Vector3.new(1.8, 0.3, 0.3), at(s * 1.8, 0.7, i * 1.1, 0, 0, s * -35), C.IronDark, {})
		end
	end
	for i = 1, 3 do
		P(m, Vector3.new(0.4, 1.2, 0.4), at((i - 2) * 0.6, 2.3, (i - 2) * 0.8, 15, 0, (i - 2) * 15), C.Rift, Neon)
	end
end

builders.Burrow_Mimic = function(m)
	builders.Storage_Chest(m)
	for _, part in m:GetChildren() do
		if part:IsA("BasePart") and part.Name == "Lid" then
			part.Name = "MimicLid"
		end
	end
	for i = -3, 3 do
		local t = P(m, Vector3.new(0.3, 0.45, 0.3), at(i * 0.5, 1.95, -1.25), Color3.fromRGB(240, 230, 210), { name = "Tooth" })
		t.Transparency = 1
	end
	local tongue = P(m, Vector3.new(0.9, 0.2, 1.4), at(0, 1.85, -0.2), Color3.fromRGB(190, 60, 80), { name = "Tongue" })
	tongue.Transparency = 1
end

builders.Hollow_Warden = function(m)
	local rock = Color3.fromRGB(70, 78, 88)
	P(m, Vector3.new(2, 4.2, 2), at(-1.7, 2.1, 0), rock, { material = Enum.Material.Slate })
	P(m, Vector3.new(2, 4.2, 2), at(1.7, 2.1, 0), rock, { material = Enum.Material.Slate })
	P(m, Vector3.new(2.6, 0.9, 3), at(-1.7, 0.45, -0.3), C.StoneDark, { material = Enum.Material.Slate })
	P(m, Vector3.new(2.6, 0.9, 3), at(1.7, 0.45, -0.3), C.StoneDark, { material = Enum.Material.Slate })
	P(m, Vector3.new(6.4, 4.6, 3.8), at(0, 6.4, 0), rock, { material = Enum.Material.Slate, name = "Torso" })
	P(m, Vector3.new(1.4, 1.8, 0.4), at(0, 6.6, -1.95), C.Rift, { material = Enum.Material.Neon, light = 16, name = "Core" })
	P(m, Vector3.new(2, 0.4, 0.4), at(0, 7.7, -2), C.Copper, { material = Enum.Material.Metal })
	P(m, Vector3.new(2.6, 2, 2.4), at(0, 9.7, 0), C.IronDark, { material = Enum.Material.Slate, name = "Head" })
	P(m, Vector3.new(1.6, 0.25, 0.1), at(0, 9.8, -1.22), C.Rift, Neon)
	P(m, Vector3.new(0.5, 2.2, 0.5), at(-1.3, 11.4, 0, 0, 0, 25), C.Copper, { shape = Enum.PartType.Block })
	P(m, Vector3.new(0.5, 2.2, 0.5), at(1.3, 11.4, 0, 0, 0, -25), C.Copper, { shape = Enum.PartType.Block })
	P(m, Vector3.new(2.6, 2.6, 2.6), at(-4.2, 7.8, 0), rock, { material = Enum.Material.Slate })
	P(m, Vector3.new(2.6, 2.6, 2.6), at(4.2, 7.8, 0), rock, { material = Enum.Material.Slate })
	P(m, Vector3.new(1.8, 4, 1.8), at(-4.4, 4.8, 0), rock, { material = Enum.Material.Slate, name = "LeftArm" })
	P(m, Vector3.new(1.8, 4, 1.8), at(4.4, 4.8, 0), rock, { material = Enum.Material.Slate, name = "RightArm" })
	P(m, Vector3.new(2.6, 2, 2.6), at(-4.4, 2.2, 0), C.IronDark, { material = Enum.Material.Slate })
	P(m, Vector3.new(2.6, 2, 2.6), at(4.4, 2.2, 0), C.IronDark, { material = Enum.Material.Slate })
	for i = 1, 3 do
		P(m, Vector3.new(0.5, 1.6, 0.5), at(-4.6 + i * 0.35, 9.6, (i - 2) * 0.6, 0, 0, 10 - i * 10), C.Rift, Neon)
		P(m, Vector3.new(0.5, 1.6, 0.5), at(3.9 + i * 0.35, 9.6, (i - 2) * 0.6, 0, 0, i * 10 - 10), C.Rift, Neon)
	end
end

builders.Stone_Sword = function(m)
	P(m, Vector3.new(0.3, 1.2, 0.3), at(0, 0.6, 0), C.WoodDark, {})
	P(m, Vector3.new(1.4, 0.3, 0.4), at(0, 1.3, 0), C.Copper, {})
	P(m, Vector3.new(0.6, 2.6, 0.15), at(0, 2.75, 0), C.Stone, { material = Enum.Material.Slate })
end

--------------------------------------------------------------------------------
-- Öffentliche API
--------------------------------------------------------------------------------
local function assetFolder(): Instance?
	return ServerStorage:FindFirstChild("RiftboundAssets")
end

function AssetLoader.HasImported(name: string): boolean
	local folder = assetFolder()
	return folder ~= nil and folder:FindFirstChild(name) ~= nil
end

-- Liefert ein Modell mit Ursprung Mitte unten; alle Parts sind verankert.
function AssetLoader.Model(name: string, height: number?): Model
	local targetHeight = height or AssetLoader.Heights[name]
	local folder = assetFolder()
	local template = folder and folder:FindFirstChild(name)
	local model: Model
	if template then
		local clone = template:Clone()
		if clone:IsA("Model") then
			model = clone
		else
			model = Instance.new("Model")
			clone.Parent = model
		end
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") then
				d.Anchored = true
			elseif d:IsA("Script") or d:IsA("LocalScript") then
				d:Destroy() -- Creator-Store-Modelle ohne fremde Skripte verwenden
			end
		end
		local yaw = template:GetAttribute("Yaw")
		local cf, size = model:GetBoundingBox()
		if targetHeight and size.Y > 0 then
			model:ScaleTo(model:GetScale() * (targetHeight / size.Y))
			cf, size = model:GetBoundingBox()
		end
		-- Pivot auf Mitte unten setzen
		local bottom = CFrame.new(cf.Position - Vector3.new(0, size.Y / 2, 0))
		if typeof(yaw) == "number" then
			bottom *= CFrame.Angles(0, math.rad(-yaw), 0)
		end
		model.WorldPivot = bottom
		model:SetAttribute("Imported", true)
	else
		model = Instance.new("Model")
		local builder = builders[name]
		if builder then
			builder(model)
		else
			P(model, Vector3.new(3, 3, 3), at(0, 1.5, 0), Color3.fromRGB(255, 0, 255), { name = "Missing_" .. name })
		end
		model.WorldPivot = CFrame.new()
	end
	model.Name = name
	return model
end

function AssetLoader.Place(name: string, cf: CFrame, parent: Instance, height: number?): Model
	local m = AssetLoader.Model(name, height)
	m:PivotTo(cf)
	m.Parent = parent
	return m
end

-- Waffenmodell für die Hand des Spielers. Griff liegt bei (0,0,0), Klinge zeigt nach +Y.
function AssetLoader.Weapon(form: string, colors: { Color3 }, quality: number): Model
	local m = Instance.new("Model")
	m.Name = "Weapon"
	local metal = C.Copper
	local accent = colors[1] or C.Iron
	local accent2 = colors[2] or accent
	local fine = quality >= 3
	local function trim(part: BasePart)
		if fine then
			part.Material = Enum.Material.Neon
		end
	end
	if form == "Hammer" then
		P(m, Vector3.new(0.35, 4.2, 0.35), at(0, 1.6, 0), C.WoodDark, { name = "Handle" })
		P(m, Vector3.new(2.4, 1.3, 1.3), at(0, 3.9, 0), metal, { material = Enum.Material.Metal })
		P(m, Vector3.new(0.35, 1.4, 1.4), at(-1.25, 3.9, 0), accent, { material = Enum.Material.Neon })
		P(m, Vector3.new(0.35, 1.4, 1.4), at(1.25, 3.9, 0), accent2, { material = Enum.Material.Neon })
		trim(P(m, Vector3.new(0.5, 0.3, 0.5), at(0, 0.4, 0), accent, {}))
	elseif form == "Spear" then
		P(m, Vector3.new(0.25, 7, 0.25), at(0, 2.6, 0), C.WoodDark, { name = "Handle" })
		P(m, Vector3.new(0.5, 1.6, 0.18), at(0, 6.9, 0), metal, { material = Enum.Material.Metal })
		P(m, Vector3.new(0.3, 0.9, 0.2), at(0, 7.9, 0), accent, { material = Enum.Material.Neon })
		P(m, Vector3.new(0.35, 0.35, 0.35), at(0, 6, 0), accent2, { material = Enum.Material.Neon })
		trim(P(m, Vector3.new(0.35, 0.25, 0.35), at(0, -0.8, 0), accent, {}))
	else
		P(m, Vector3.new(0.3, 1.2, 0.3), at(0, 0, 0), C.WoodDark, { name = "Handle" })
		P(m, Vector3.new(1.4, 0.3, 0.45), at(0, 0.7, 0), metal, { material = Enum.Material.Metal })
		P(m, Vector3.new(0.5, 3.2, 0.14), at(0, 2.45, 0), metal, { material = Enum.Material.Metal })
		P(m, Vector3.new(0.16, 3, 0.16), at(0, 2.4, 0), accent, { material = Enum.Material.Neon })
		if colors[2] then
			P(m, Vector3.new(0.3, 0.3, 0.3), at(0, 0.7, -0.25), accent2, { material = Enum.Material.Neon })
		end
		trim(P(m, Vector3.new(0.35, 0.35, 0.35), at(0, -0.7, 0), accent, {}))
	end
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.Massless = true
		end
	end
	m.PrimaryPart = m:FindFirstChild("Handle") :: BasePart
	return m
end

return AssetLoader
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Combat</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Kampf: Der Client sendet nur Absichten, der Server prüft Abklingzeiten und
-- Ausdauer, bestimmt Treffer, Schaden und alle Element-/Kombinationseffekte.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)

local Combat = {}
local ctx: any

local FxEvent = Net.Event("Fx")

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function has(w: any, el: string): boolean
	return w.e1 == el or w.e2 == el
end

local function elementsOf(w: any): { string }
	local list = {}
	if w.e1 then
		table.insert(list, w.e1)
	end
	if w.e2 then
		table.insert(list, w.e2)
	end
	return list
end

local function combo(w: any): string?
	return Config.ComboKey(w.e1, w.e2)
end

local function colorOf(w: any): Color3?
	return if w.e1 then Config.Elements[w.e1].color else nil
end

local function qualityMult(w: any): number
	local q = Config.Quality[w.quality or 1]
	return if q then q.mult else 1
end

--------------------------------------------------------------------------------
-- Kombinations-Bausteine
--------------------------------------------------------------------------------
local function areaDamage(player: Player, w: any, center: Vector3, radius: number, amount: number, color: Color3, exclude: any?, extra: ((any) -> ())?)
	local els = elementsOf(w)
	for _, e in ctx.Entities.InRadius(center, radius, exclude) do
		local dealt = ctx.Entities.Damage(e, amount, { player = player, elements = els, color = color })
		if dealt > 0 and extra then
			extra(e)
		end
	end
end

local function thermoBreak(player: Player, w: any, e: any)
	local s = e.status
	s.thermoCount += 1
	if s.thermoCount < 3 then
		return
	end
	s.thermoCount = 0
	s.thermoHot = not s.thermoHot
	local form = Config.Forms[w.form]
	local dmg = form.heavy * 0.3 * qualityMult(w)
	local pos = e.root.Position
	FxEvent:FireAllClients("Shards", pos, 8 * form.radiusMult)
	ctx.Entities.Damage(e, dmg, { player = player, elements = elementsOf(w), color = Color3.fromRGB(255, 200, 220) })
	areaDamage(player, w, pos, 8 * form.radiusMult, dmg * 0.6, Color3.fromRGB(255, 200, 220), e)
end

local function coldShock(player: Player, w: any, e: any)
	local form = Config.Forms[w.form]
	local r = 10 * form.radiusMult * form.reachMult
	FxEvent:FireAllClients("Nova", e.root.Position, r, Config.Elements.Frost.color)
	areaDamage(player, w, e.root.Position, r, 10 * qualityMult(w), Config.Elements.Frost.color, e, function(other)
		ctx.Entities.AddFrost(other, 2)
	end)
end

local function shadowEcho(player: Player, w: any, e: any)
	local form = Config.Forms[w.form]
	local dmg = form.heavy * 0.5 * qualityMult(w)
	task.delay(0.6, function()
		if e.dead then
			return
		end
		FxEvent:FireAllClients("Echo", e.root.Position, Config.Elements.Shadow.color)
		ctx.Entities.Damage(e, dmg, { player = player, elements = elementsOf(w), color = Config.Elements.Shadow.color })
	end)
end

local function fireTrail(player: Player, w: any, from: Vector3, to: Vector3)
	local form = Config.Forms[w.form]
	local points = {}
	local dir = flat(to - from)
	local len = math.max(dir.Magnitude, 6) * form.reachMult
	local unit = if dir.Magnitude > 0.1 then dir.Unit else Vector3.new(0, 0, -1)
	for i = 1, 4 do
		table.insert(points, from + unit * (len * i / 4))
	end
	FxEvent:FireAllClients("Trail", points, 3.5, 3)
	local t0 = os.clock()
	task.spawn(function()
		while os.clock() - t0 < 3 do
			for _, p in points do
				for _, e in ctx.Entities.InRadius(p, 3.5) do
					ctx.Entities.AddBurn(e, 1, player)
					ctx.Entities.Damage(e, 3, { player = player, elements = { "Ember" }, color = Config.Elements.Ember.color, silent = true })
				end
			end
			task.wait(0.5)
		end
	end)
end

local function stormDischarge(player: Player, w: any, primary: any)
	local form = Config.Forms[w.form]
	local q = qualityMult(w)
	local reach = 12 * form.reachMult
	local color = Config.Elements.Storm.color
	-- Sprung auf bis zu zwei nahe Gegner
	local others = ctx.Entities.InRadius(primary.root.Position, reach, primary)
	table.sort(others, function(a, b)
		return (a.root.Position - primary.root.Position).Magnitude < (b.root.Position - primary.root.Position).Magnitude
	end)
	for i = 1, math.min(2, #others) do
		local o = others[i]
		FxEvent:FireAllClients("Chain", primary.root.Position, o.root.Position, color)
		ctx.Entities.Damage(o, form.heavy * 0.4 * q, { player = player, elements = elementsOf(w), color = color })
	end
	if #others == 0 then
		FxEvent:FireAllClients("Chain", primary.root.Position + Vector3.new(0, 6, 0), primary.root.Position, color)
	end
	local key = combo(w)
	if key == "Ember+Storm" then
		local r = 8 * form.radiusMult
		FxEvent:FireAllClients("Explosion", primary.root.Position, r, Config.Elements.Ember.color)
		areaDamage(player, w, primary.root.Position, r, form.heavy * 0.35 * q, Config.Elements.Ember.color, nil, function(e)
			ctx.Entities.AddBurn(e, 2, player)
		end)
	elseif key == "Storm+Shadow" then
		local target = ctx.Entities.Nearest(primary.root.Position, 20 * form.reachMult, function(e)
			return ctx.Entities.IsMarked(e) and e ~= primary
		end) or primary
		local root = ctx.PlayerState.GetRoot(player)
		if root and not target.dead then
			local tPos = target.root.Position
			local dir = flat(tPos - root.Position)
			local unit = if dir.Magnitude > 0.1 then dir.Unit else root.CFrame.LookVector
			local dest = tPos - unit * (target.radius + 3)
			local ground = ctx.Entities.GroundAt(dest)
			local from = root.Position
			root.CFrame = CFrame.lookAt(ground + Vector3.new(0, 3, 0), Vector3.new(tPos.X, ground.Y + 3, tPos.Z))
			FxEvent:FireAllClients("Teleport", from, root.Position, color)
			ctx.Entities.Damage(target, form.heavy * 0.5 * q, { player = player, elements = elementsOf(w), color = color })
		end
	end
end

--------------------------------------------------------------------------------
-- Treffer anwenden
--------------------------------------------------------------------------------
local function hitEntity(player: Player, w: any, e: any, heavy: boolean, s: any): number
	local form = Config.Forms[w.form]
	local root = ctx.PlayerState.GetRoot(player) :: BasePart
	local amount = (if heavy then form.heavy else form.light) * qualityMult(w)
	local dist = (flat(e.root.Position) - flat(root.Position)).Magnitude - e.radius
	if w.form == "Spear" and dist < 2.5 then
		amount *= 0.7
	end
	if w.part == "PartMimicTooth" and e.pristine and e.isEnemy then
		amount *= 1.6
	end
	if w.part == "PartCrawlerClaw" and s.perfectDodgeUntil > os.clock() then
		amount *= 1.6
	end
	local consumedMark = false
	if heavy and has(w, "Shadow") and ctx.Entities.ConsumeMark(e) then
		amount *= 1.6
		consumedMark = true
		FxEvent:FireAllClients("Echo", e.root.Position, Config.Elements.Shadow.color)
	end
	local shieldMult = if heavy then 2 else 1
	if heavy and w.part == "PartWardenHorn" then
		shieldMult *= 3
	end
	local dealt = ctx.Entities.Damage(e, amount, {
		player = player,
		elements = elementsOf(w),
		heavy = heavy,
		color = colorOf(w),
		shieldMult = shieldMult,
	})
	if dealt <= 0 or e.dead and not e.isDummy then
		if dealt > 0 and consumedMark and combo(w) == "Ember+Shadow" then
			fireTrail(player, w, root.Position, e.root.Position)
		end
		return dealt
	end

	-- Unterbrechen / Betäuben
	if heavy and w.form == "Hammer" then
		ctx.Entities.Interrupt(e, 1)
	elseif heavy and w.part == "PartStalkerBark" then
		ctx.Entities.Interrupt(e, 0.5)
	end

	-- Grundelemente
	if has(w, "Ember") then
		ctx.Entities.AddBurn(e, if heavy then 2 else 1, player)
	end
	if has(w, "Frost") then
		local froze = ctx.Entities.AddFrost(e, if heavy then 2 else 1)
		if froze and combo(w) == "Frost+Storm" then
			coldShock(player, w, e)
		end
	end
	if has(w, "Shadow") and not heavy then
		ctx.Entities.Mark(e)
	end

	-- Kombinationen
	local key = combo(w)
	if key == "Ember+Frost" then
		thermoBreak(player, w, e)
	elseif key == "Frost+Shadow" and heavy then
		shadowEcho(player, w, e)
	elseif key == "Ember+Shadow" and consumedMark then
		fireTrail(player, w, root.Position, e.root.Position)
	end
	return dealt
end

local function swing(player: Player, heavy: boolean)
	local s = ctx.PlayerState.Get(player)
	local w = ctx.PlayerState.GetWeapon(player)
	local root = ctx.PlayerState.GetRoot(player)
	if not s or not w or not root then
		return
	end
	local form = Config.Forms[w.form]
	local look = flat(root.CFrame.LookVector)
	look = if look.Magnitude > 0.01 then look.Unit else Vector3.new(0, 0, -1)
	local range = form.range + (if heavy then 1 else 0)
	local width = form.width * (if heavy and w.form == "Hammer" then 1.3 else 1)
	local center = root.Position + look * (range / 2 - 0.5)
	local cf = CFrame.lookAt(center, center + look)
	local targets = ctx.Entities.InBox(cf, Vector3.new(width, 8, range + 1))

	local primary = nil
	local any = false
	for _, e in targets do
		local dealt = hitEntity(player, w, e, heavy, s)
		if dealt > 0 then
			any = true
			if not primary or (e.isEnemy and not primary.isEnemy) then
				primary = e
			end
		end
	end
	if w.part == "PartCrawlerClaw" and any then
		s.perfectDodgeUntil = 0
	end
	if not any then
		return
	end
	ctx.PlayerState.AddCharge(player, if heavy then Config.Player.ChargeHeavy else Config.Player.ChargeLight)
	if has(w, "Storm") and primary then
		s.stormCharge += if heavy then 2 else 1
		if s.stormCharge >= 4 then
			s.stormCharge = 0
			stormDischarge(player, w, primary)
		end
	end
end

--------------------------------------------------------------------------------
-- Elementfähigkeit
--------------------------------------------------------------------------------
local function ability(player: Player)
	local s = ctx.PlayerState.Get(player)
	local w = ctx.PlayerState.GetWeapon(player)
	local root = ctx.PlayerState.GetRoot(player)
	if not s or not w or not root or not w.e1 then
		return
	end
	if s.charge < 100 then
		return
	end
	s.charge = 0
	local form = Config.Forms[w.form]
	local q = qualityMult(w)
	local radius = Config.Player.AbilityRadius * form.radiusMult * (if w.part == "PartWraithCore" then 1.5 else 1)
	local pos = root.Position
	local el = w.e1
	local color = Config.Elements[el].color
	local els = elementsOf(w)
	local function secondary(e: any)
		if w.e2 == "Ember" then
			ctx.Entities.AddBurn(e, 2, player)
		elseif w.e2 == "Frost" then
			ctx.Entities.AddFrost(e, 2)
		elseif w.e2 == "Shadow" then
			ctx.Entities.Mark(e)
		elseif w.e2 == "Storm" then
			s.stormCharge += 1
		end
	end

	if el == "Ember" then
		FxEvent:FireAllClients("Nova", pos, radius, color)
		areaDamage(player, w, pos, radius, 30 * q, color, nil, function(e)
			ctx.Entities.AddBurn(e, 3, player)
			secondary(e)
		end)
	elseif el == "Frost" then
		FxEvent:FireAllClients("Nova", pos, radius, color)
		areaDamage(player, w, pos, radius, 18 * q, color, nil, function(e)
			ctx.Entities.Freeze(e, 2.2)
			secondary(e)
		end)
	elseif el == "Storm" then
		local list = ctx.Entities.InRadius(pos, radius * 1.6)
		table.sort(list, function(a, b)
			return (a.root.Position - pos).Magnitude < (b.root.Position - pos).Magnitude
		end)
		for i = 1, math.min(4, #list) do
			local e = list[i]
			FxEvent:FireAllClients("Chain", e.root.Position + Vector3.new(0, 25, 0), e.root.Position, color)
			local dealt = ctx.Entities.Damage(e, 42 * q, { player = player, elements = els, color = color })
			if dealt > 0 then
				secondary(e)
			end
		end
		if #list == 0 then
			FxEvent:FireAllClients("Nova", pos, 6, color)
		end
	elseif el == "Shadow" then
		local look = flat(root.CFrame.LookVector)
		look = if look.Magnitude > 0.01 then look.Unit else Vector3.new(0, 0, -1)
		local dist = 18 * (if w.part == "PartWraithCore" then 1.4 else 1)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { player.Character :: Model, workspace:FindFirstChild("Entities") :: Instance }
		local hit = workspace:Raycast(pos, look * dist, params)
		if hit then
			dist = math.max(0, hit.Distance - 2)
		end
		local dest = pos + look * dist
		local mid = pos + look * (dist / 2)
		local targets = ctx.Entities.InBox(CFrame.lookAt(mid, mid + look), Vector3.new(7, 8, dist + 4))
		root.CFrame = CFrame.lookAt(dest, dest + look)
		FxEvent:FireAllClients("Teleport", pos, dest, color)
		for _, e in targets do
			local dealt = ctx.Entities.Damage(e, 38 * q, { player = player, elements = els, color = color })
			if dealt > 0 then
				ctx.Entities.Mark(e)
				secondary(e)
			end
		end
	end
	FxEvent:FireAllClients("Ability", player, el)
end

--------------------------------------------------------------------------------
-- Eingang
--------------------------------------------------------------------------------
local function onAction(player: Player, action: any)
	if type(action) ~= "string" then
		return
	end
	local s = ctx.PlayerState.Get(player)
	if not s or not ctx.PlayerState.IsActive(player) then
		return
	end
	local now = os.clock()
	if s.rootedUntil > now and action == "Dodge" then
		return
	end
	if action == "Dodge" then
		if now - s.lastDodge < Config.Player.DodgeCooldown * 0.85 then
			return
		end
		if not ctx.PlayerState.UseStamina(player, Config.Player.DodgeStamina) then
			return
		end
		s.lastDodge = now
		s.iframesUntil = now + Config.Player.DodgeIFrames
		ctx.PlayerState.AddCharge(player, Config.Player.ChargeDodge)
		FxEvent:FireAllClients("Dodge", player)
		return
	end
	local w = ctx.PlayerState.GetWeapon(player)
	if not w then
		ctx.PlayerState.Notify(player, "Du hast keine Waffe. Schmiede zuerst eine!", "bad")
		return
	end
	if action == "Ability" then
		ability(player)
		return
	end
	if action ~= "Light" and action ~= "Heavy" then
		return
	end
	local heavy = action == "Heavy"
	if now < s.cooldownUntil then
		return
	end
	local form = Config.Forms[w.form]
	if not ctx.PlayerState.UseStamina(player, if heavy then Config.Player.HeavyStamina else Config.Player.LightStamina) then
		return
	end
	-- 10 % Toleranz für Latenz
	s.cooldownUntil = now + (if heavy then form.heavyCd else form.lightCd) * 0.9
	FxEvent:FireAllClients("Swing", player, heavy, w.form, colorOf(w))
	if heavy then
		task.delay(0.18, swing, player, true)
	else
		swing(player, false)
	end
end

function Combat.Init(context)
	ctx = context
end

function Combat.Start()
	Net.Event("Action").OnServerEvent:Connect(onAction)
end

return Combat
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Profile laden/speichern (DataStore) und Lagerbestand verwalten.
-- In Studio ohne API-Zugriff läuft das Spiel mit Sitzungsdaten weiter.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

export type Weapon = {
	id: string,
	form: string,
	e1: string?,
	e2: string?,
	part: string?,
	quality: number,
	forged: boolean,
}

export type Blueprint = { name: string, form: string, e1: string?, e2: string? }

export type Profile = {
	version: number,
	stash: { [string]: number },
	weapons: { Weapon },
	equipped: string?,
	nextWeaponId: number,
	unlocked: { [string]: boolean },
	blueprints: { Blueprint },
	milestones: { [string]: boolean },
	quests: { [string]: string }, -- "open" | "done" | "claimed"
	stats: { [string]: number },
}

local DataService = {}
local ctx: any

local STORE_NAME = "RIFTBOUND_v2"
local store: DataStore? = nil
local profiles: { [Player]: Profile } = {}
local dirty: { [Player]: boolean } = {}
local loaded: { [Player]: boolean } = {}

local function newProfile(): Profile
	local stash = {}
	for k, v in Config.StarterStash do
		stash[k] = v
	end
	return {
		version = 2,
		stash = stash,
		weapons = {},
		equipped = nil,
		nextWeaponId = 1,
		unlocked = { Sword = true },
		blueprints = {},
		milestones = {},
		quests = {},
		stats = {},
	}
end

local function reconcile(data: any): Profile
	local base = newProfile()
	if type(data) ~= "table" then
		return base
	end
	for k, v in base :: any do
		if data[k] == nil then
			data[k] = v
		end
	end
	return data :: Profile
end

function DataService.Init(context)
	ctx = context
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[RIFTBOUND] DataStore nicht verfügbar – Fortschritt wird nicht gespeichert:", result)
	end
end

function DataService.Get(player: Player): Profile?
	return profiles[player]
end

function DataService.MarkDirty(player: Player)
	dirty[player] = true
end

local function save(player: Player)
	local profile = profiles[player]
	if not profile or not store or not loaded[player] then
		return
	end
	local key = "u_" .. player.UserId
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			(store :: DataStore):UpdateAsync(key, function()
				return profile
			end)
		end)
		if ok then
			dirty[player] = nil
			return
		end
		warn("[RIFTBOUND] Speichern fehlgeschlagen (Versuch " .. attempt .. "):", err)
		task.wait(1.5 * attempt)
	end
end

local function load(player: Player)
	local profile: Profile = newProfile()
	local success = true
	if store then
		local key = "u_" .. player.UserId
		local ok, data = false, nil
		for _ = 1, 3 do
			ok, data = pcall(function()
				return (store :: DataStore):GetAsync(key)
			end)
			if ok then
				break
			end
			task.wait(1)
		end
		if ok then
			profile = reconcile(data)
		else
			success = false
			warn("[RIFTBOUND] Laden fehlgeschlagen – Sitzung wird nicht gespeichert:", data)
		end
	end
	if player.Parent ~= Players then
		return
	end
	profiles[player] = profile
	loaded[player] = success
	ctx.PlayerState.OnProfileLoaded(player)
end

-- Lagerbestand ---------------------------------------------------------------

function DataService.Has(player: Player, cost: { [string]: number }): boolean
	local p = profiles[player]
	if not p then
		return false
	end
	for item, n in cost do
		if (p.stash[item] or 0) < n then
			return false
		end
	end
	return true
end

function DataService.Take(player: Player, cost: { [string]: number }): boolean
	if not DataService.Has(player, cost) then
		return false
	end
	local p = profiles[player] :: Profile
	for item, n in cost do
		p.stash[item] -= n
		if p.stash[item] <= 0 then
			p.stash[item] = nil
		end
	end
	dirty[player] = true
	return true
end

function DataService.Give(player: Player, items: { [string]: number })
	local p = profiles[player]
	if not p then
		return
	end
	for item, n in items do
		if Config.Items[item] and n > 0 then
			p.stash[item] = (p.stash[item] or 0) + n
		end
	end
	dirty[player] = true
end

function DataService.Start()
	Players.PlayerAdded:Connect(load)
	for _, player in Players:GetPlayers() do
		task.spawn(load, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		save(player)
		profiles[player] = nil
		dirty[player] = nil
		loaded[player] = nil
	end)
	game:BindToClose(function()
		local threads = 0
		for player in profiles do
			threads += 1
			task.spawn(function()
				save(player)
				threads -= 1
			end)
		end
		local t = os.clock()
		while threads > 0 and os.clock() - t < 20 do
			task.wait(0.2)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(60)
			for player in dirty do
				task.spawn(save, player)
			end
		end
	end)
end

DataService.Save = save

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Entities</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Entities: alles, was Schaden nehmen kann (Gegner, Boss, Übungspuppen,
-- Barrieren, Riftkristalle) inkl. Statuseffekte und Gegner-KI.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)

local Entities = {}
local ctx: any

export type Entity = {
	id: number,
	kind: string,
	name: string,
	def: any?,
	model: Model,
	root: BasePart,
	humanoid: Humanoid?,
	hp: number,
	maxHp: number,
	dead: boolean,
	isEnemy: boolean,
	isBoss: boolean,
	isDummy: boolean,
	light: boolean,
	requires: { string }?,
	shield: boolean,
	dmgMult: number,
	lootMult: number,
	tag: string,
	home: Vector3,
	status: {
		burnStacks: number,
		burnUntil: number,
		nextBurn: number,
		frostStacks: number,
		slowUntil: number,
		frozenUntil: number,
		stunnedUntil: number,
		markUntil: number,
		thermoCount: number,
		thermoHot: boolean,
	},
	ai: { [string]: any },
	pristine: boolean,
	lastHitBy: Player?,
	onDeath: ((Entity, Player?) -> ())?,
	bar: Frame?,
	radius: number,
}

local FxEvent = Net.Event("Fx")

local entities: { [number]: Entity } = {}
local byModel: { [Model]: Entity } = {}
local nextId = 0

local folder: Folder
local telegraphFolder: Folder

--------------------------------------------------------------------------------
-- Hilfen
--------------------------------------------------------------------------------
local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Exclude

local function groundAt(pos: Vector3): Vector3
	local filter: { Instance } = { folder, telegraphFolder }
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(filter, p.Character)
		end
	end
	groundParams.FilterDescendantsInstances = filter
	local hit = workspace:Raycast(pos + Vector3.new(0, 8, 0), Vector3.new(0, -40, 0), groundParams)
	return if hit then hit.Position else Vector3.new(pos.X, 0, pos.Z)
end
Entities.GroundAt = groundAt

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function makeBar(e: Entity, height: number)
	local gui = Instance.new("BillboardGui")
	gui.Name = "HPBar"
	gui.Size = UDim2.fromOffset(if e.isBoss then 0 else 90, 22)
	gui.StudsOffsetWorldSpace = Vector3.new(0, height, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 90
	gui.Enabled = not e.isBoss
	local name = Instance.new("TextLabel")
	name.Size = UDim2.new(1, 0, 0, 12)
	name.BackgroundTransparency = 1
	name.Text = e.name
	name.TextColor3 = Color3.new(1, 1, 1)
	name.TextStrokeTransparency = 0.4
	name.Font = Enum.Font.GothamBold
	name.TextSize = 11
	name.Parent = gui
	local back = Instance.new("Frame")
	back.Position = UDim2.fromOffset(0, 14)
	back.Size = UDim2.new(1, 0, 0, 7)
	back.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
	back.BorderSizePixel = 0
	back.Parent = gui
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = if e.isDummy then Color3.fromRGB(200, 180, 110) else Color3.fromRGB(220, 70, 70)
	fill.BorderSizePixel = 0
	fill.Parent = back
	gui.Parent = e.root
	e.bar = fill
end

local function updateBar(e: Entity)
	if e.bar then
		e.bar.Size = UDim2.fromScale(math.clamp(e.hp / e.maxHp, 0, 1), 1)
	end
	if e.isBoss then
		ReplicatedStorage:SetAttribute("BossHP", math.max(0, math.floor(e.hp)))
		ReplicatedStorage:SetAttribute("BossMaxHP", math.floor(e.maxHp))
	end
end

local function setHighlight(e: Entity, color: Color3?)
	local h = e.model:FindFirstChild("StatusHighlight") :: Highlight?
	if not color then
		if h then
			h:Destroy()
		end
		return
	end
	if not h then
		local nh = Instance.new("Highlight")
		nh.Name = "StatusHighlight"
		nh.FillTransparency = 0.55
		nh.OutlineTransparency = 0
		nh.DepthMode = Enum.HighlightDepthMode.Occluded
		nh.Parent = e.model
		h = nh
	end
	local hl = h :: Highlight
	hl.FillColor = color
	hl.OutlineColor = color
end

local function register(e: Entity)
	entities[e.id] = e
	byModel[e.model] = e
	e.model:SetAttribute("EntityId", e.id)
end

local function newEntity(kind: string, name: string, model: Model, root: BasePart, hp: number): Entity
	nextId += 1
	local e: Entity = {
		id = nextId,
		kind = kind,
		name = name,
		def = nil,
		model = model,
		root = root,
		humanoid = nil,
		hp = hp,
		maxHp = hp,
		dead = false,
		isEnemy = false,
		isBoss = false,
		isDummy = false,
		light = false,
		requires = nil,
		shield = false,
		dmgMult = 1,
		lootMult = 1,
		tag = "",
		home = root.Position,
		status = {
			burnStacks = 0,
			burnUntil = 0,
			nextBurn = 0,
			frostStacks = 0,
			slowUntil = 0,
			frozenUntil = 0,
			stunnedUntil = 0,
			markUntil = 0,
			thermoCount = 0,
			thermoHot = false,
		},
		ai = {},
		pristine = true,
		lastHitBy = nil,
		onDeath = nil,
		bar = nil,
		radius = math.max(root.Size.X, root.Size.Z) / 2,
	}
	return e
end

--------------------------------------------------------------------------------
-- Erzeugen
--------------------------------------------------------------------------------
export type SpawnOpts = {
	tag: string?,
	hpMult: number?,
	dmgMult: number?,
	lootMult: number?,
	onDeath: ((Entity, Player?) -> ())?,
	dormant: boolean?,
	yaw: number?,
}

function Entities.SpawnEnemy(kind: string, pos: Vector3, opts: SpawnOpts?): Entity
	local o = opts or {} :: SpawnOpts
	local def = Config.Enemies[kind]
	assert(def, "Unbekannter Gegner " .. kind)
	local ground = groundAt(pos)
	local scale = def.height / 5
	local model = Instance.new("Model")
	model.Name = kind

	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1) * math.max(scale, 0.5)
	root.Transparency = 1
	root.CanCollide = true
	root.CanQuery = true
	root.CanTouch = false
	local yaw = CFrame.Angles(0, math.rad(o.yaw or math.random(0, 359)), 0)
	root.CFrame = CFrame.new(ground + Vector3.new(0, def.hip + root.Size.Y / 2, 0)) * yaw
	root.Parent = model

	local visual = ctx.AssetLoader.Model(kind, def.height)
	local lift = if kind == "Lantern_Wraith" then def.hip - 1.2 else 0
	visual:PivotTo(CFrame.new(ground + Vector3.new(0, lift, 0)) * yaw)
	for _, d in visual:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.CanCollide = false
			d.CanQuery = true
			d.CanTouch = false
			d.Massless = true
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = d
			weld.Parent = d
		end
	end
	visual.Name = "Visual"
	visual.Parent = model

	local hum = Instance.new("Humanoid")
	hum.RigType = Enum.HumanoidRigType.R15
	hum.HipHeight = def.hip
	hum.WalkSpeed = if o.dormant then 0 else def.speed
	hum.MaxHealth = 1e6
	hum.Health = 1e6
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.BreakJointsOnDeath = false
	hum.Parent = model
	hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
	hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
	hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)

	model.PrimaryPart = root
	model.Parent = folder
	pcall(function()
		root:SetNetworkOwner(nil)
	end)

	local hp = def.hp * (o.hpMult or 1)
	local e = newEntity(kind, def.name, model, root, hp)
	e.def = def
	e.humanoid = hum
	e.isEnemy = true
	e.isBoss = kind == "Hollow_Warden"
	e.light = def.light
	e.dmgMult = o.dmgMult or 1
	e.lootMult = o.lootMult or 1
	e.tag = o.tag or ""
	e.home = ground
	e.onDeath = o.onDeath
	e.radius = if e.isBoss then 4 else e.radius
	e.ai = { nextAttack = os.clock() + 1, token = 0, busyUntil = 0, dormant = o.dormant or false, side = if math.random() < 0.5 then -1 else 1 }
	if kind == "Lantern_Wraith" then
		hum.HipHeight = def.hip
	end
	makeBar(e, root.Size.Y / 2 + def.height - def.hip + 1)
	register(e)
	return e
end

export type StaticOpts = {
	kind: string,
	name: string,
	hp: number,
	requires: { string }?,
	shield: boolean?,
	dummy: boolean?,
	tag: string?,
	onDeath: ((Entity, Player?) -> ())?,
	barHeight: number?,
}

-- Registriert ein vorhandenes Modell als beschädigbares Objekt (ohne KI).
function Entities.RegisterStatic(model: Model, o: StaticOpts): Entity
	local root = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true) :: BasePart
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanQuery = true
		end
	end
	local e = newEntity(o.kind, o.name, model, root, o.hp)
	e.requires = o.requires
	e.shield = o.shield or false
	e.isDummy = o.dummy or false
	e.light = true
	e.tag = o.tag or ""
	e.onDeath = o.onDeath
	local _, size = model:GetBoundingBox()
	e.radius = math.max(size.X, size.Z) / 2
	if model.Parent ~= folder then
		model.Parent = folder
	end
	makeBar(e, o.barHeight or (size.Y / 2 + 1.5))
	register(e)
	return e
end

--------------------------------------------------------------------------------
-- Abfragen
--------------------------------------------------------------------------------
function Entities.FromPart(part: Instance): Entity?
	local node: Instance? = part
	while node and node ~= folder do
		if node:IsA("Model") and byModel[node] then
			return byModel[node]
		end
		node = node.Parent
	end
	return nil
end

local overlap = OverlapParams.new()
overlap.FilterType = Enum.RaycastFilterType.Include

function Entities.InBox(cf: CFrame, size: Vector3): { Entity }
	overlap.FilterDescendantsInstances = { folder }
	local found: { [Entity]: boolean } = {}
	local list = {}
	for _, part in workspace:GetPartBoundsInBox(cf, size, overlap) do
		local e = Entities.FromPart(part)
		if e and not e.dead and not found[e] then
			found[e] = true
			table.insert(list, e)
		end
	end
	return list
end

function Entities.InRadius(pos: Vector3, radius: number, exclude: Entity?): { Entity }
	local list = {}
	for _, e in entities do
		if not e.dead and e ~= exclude then
			local d = (flat(e.root.Position) - flat(pos)).Magnitude - e.radius
			if d <= radius and math.abs(e.root.Position.Y - pos.Y) < 25 then
				table.insert(list, e)
			end
		end
	end
	return list
end

function Entities.Nearest(pos: Vector3, radius: number, filter: ((Entity) -> boolean)?): Entity?
	local best, bestD = nil, radius
	for _, e in entities do
		if not e.dead and (not filter or filter(e)) then
			local d = (e.root.Position - pos).Magnitude - e.radius
			if d < bestD then
				best, bestD = e, d
			end
		end
	end
	return best
end

--------------------------------------------------------------------------------
-- Schaden & Tod
--------------------------------------------------------------------------------
local function rollDrops(e: Entity): { [string]: number }
	local items = {}
	if not e.def then
		return items
	end
	for _, d in e.def.drops do
		local chance = math.min(1, d.chance * (if Config.Items[d.item].kind == "Basic" then 1 else e.lootMult))
		if math.random() <= chance then
			local n = math.random(d.min, d.max)
			if Config.Items[d.item].kind == "Basic" then
				n = math.max(1, math.floor(n * e.lootMult + 0.5))
			end
			items[d.item] = (items[d.item] or 0) + n
		end
	end
	return items
end

local function die(e: Entity, killer: Player?)
	if e.dead then
		return
	end
	e.dead = true
	e.hp = 0
	updateBar(e)
	e.ai.token = (e.ai.token or 0) + 1
	FxEvent:FireAllClients("Death", e.root.Position, e.isBoss)
	if e.isEnemy then
		local participants = ctx.Expedition.Participants()
		for _, p in participants do
			if ctx.PlayerState.IsActive(p) or p == killer then
				local drops = rollDrops(e)
				ctx.PlayerState.AddLoot(p, drops, e.isBoss)
			end
		end
	end
	if e.onDeath then
		task.spawn(e.onDeath, e, killer)
	end
	entities[e.id] = nil
	byModel[e.model] = nil
	for _, d in e.model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanQuery = false
			d.CanCollide = false
			TweenService:Create(d, TweenInfo.new(0.5), { Transparency = 1 }):Play()
		end
	end
	task.delay(0.6, function()
		e.model:Destroy()
	end)
end

export type DamageInfo = {
	player: Player?,
	elements: { string }?,
	heavy: boolean?,
	color: Color3?,
	silent: boolean?,
	shieldMult: number?,
}

-- Fügt Schaden zu und liefert den tatsächlich verursachten Wert.
function Entities.Damage(e: Entity, amount: number, info: DamageInfo?): number
	local i = info or {} :: DamageInfo
	if e.dead or amount <= 0 then
		return 0
	end
	if e.requires then
		local ok = false
		for _, el in i.elements or {} do
			if table.find(e.requires, el) then
				ok = true
			end
		end
		if not ok then
			if i.player then
				local names = {}
				for _, el in e.requires do
					table.insert(names, Config.Elements[el].name)
				end
				ctx.PlayerState.Notify(i.player, e.name .. ": braucht eine Waffe mit " .. table.concat(names, " oder "), "bad")
			end
			FxEvent:FireAllClients("Immune", e.root.Position)
			return 0
		end
	end
	if e.shield and i.shieldMult then
		amount *= i.shieldMult
	end
	e.pristine = false
	e.lastHitBy = i.player or e.lastHitBy
	e.hp -= amount
	if not i.silent then
		FxEvent:FireAllClients("Damage", e.root.Position + Vector3.new(0, e.root.Size.Y / 2 + 1, 0), math.floor(amount + 0.5), i.color)
	end
	if e.isDummy then
		if e.hp <= 0 then
			e.hp = e.maxHp
		end
		updateBar(e)
		return amount
	end
	if e.ai.dormant then
		Entities.Wake(e)
	end
	updateBar(e)
	if e.hp <= 0 then
		die(e, i.player)
	end
	return amount
end

function Entities.Kill(e: Entity)
	die(e, nil)
end

--------------------------------------------------------------------------------
-- Statuseffekte (werden vom Kampfsystem gesetzt)
--------------------------------------------------------------------------------
function Entities.Interrupt(e: Entity, stun: number)
	if e.dead or e.isBoss then
		return
	end
	e.ai.token = (e.ai.token or 0) + 1
	if e.ai.telegraph then
		e.ai.telegraph:Destroy()
		e.ai.telegraph = nil
	end
	e.status.stunnedUntil = math.max(e.status.stunnedUntil, os.clock() + stun)
end

function Entities.AddBurn(e: Entity, stacks: number, player: Player?)
	local s = e.status
	s.burnStacks = math.min(6, s.burnStacks + stacks)
	s.burnUntil = os.clock() + 3.5
	if s.nextBurn < os.clock() then
		s.nextBurn = os.clock() + 0.5
	end
	e.lastHitBy = player or e.lastHitBy
	if not e.root:FindFirstChild("BurnFire") then
		local f = Instance.new("Fire")
		f.Name = "BurnFire"
		f.Size = 3
		f.Heat = 4
		f.Parent = e.root
	end
end

-- Liefert true, wenn das Ziel durch diesen Treffer eingefroren wurde.
function Entities.AddFrost(e: Entity, stacks: number): boolean
	local s = e.status
	local now = os.clock()
	s.slowUntil = now + 2.5
	if s.frozenUntil > now then
		return false
	end
	s.frostStacks += stacks
	if s.frostStacks >= 4 then
		s.frostStacks = 0
		if e.light then
			s.frozenUntil = now + 1.6
			Entities.Interrupt(e, 0)
			setHighlight(e, Color3.fromRGB(150, 220, 255))
			FxEvent:FireAllClients("Freeze", e.root.Position)
			return true
		end
	end
	return false
end

function Entities.Mark(e: Entity)
	e.status.markUntil = os.clock() + 6
end

function Entities.IsMarked(e: Entity): boolean
	return e.status.markUntil > os.clock()
end

function Entities.ConsumeMark(e: Entity): boolean
	if e.status.markUntil > os.clock() then
		e.status.markUntil = 0
		return true
	end
	return false
end

function Entities.Freeze(e: Entity, duration: number)
	if not e.light then
		e.status.slowUntil = os.clock() + duration
		return
	end
	e.status.frozenUntil = os.clock() + duration
	e.status.frostStacks = 0
	Entities.Interrupt(e, 0)
	setHighlight(e, Color3.fromRGB(150, 220, 255))
end

--------------------------------------------------------------------------------
-- Telegraphen (angekündigte Angriffe)
--------------------------------------------------------------------------------
local TELEGRAPH_COLOR = Color3.fromRGB(255, 70, 50)

function Entities.TelegraphCircle(center: Vector3, radius: number, duration: number, color: Color3?): BasePart
	local g = groundAt(center)
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(0.15, radius * 2, radius * 2)
	p.CFrame = CFrame.new(g + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, 0, math.rad(90))
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Material = Enum.Material.Neon
	p.Color = color or TELEGRAPH_COLOR
	p.Transparency = 0.75
	p.Parent = telegraphFolder
	TweenService:Create(p, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Transparency = 0.35 }):Play()
	return p
end

function Entities.TelegraphRect(from: Vector3, dir: Vector3, width: number, length: number, duration: number): BasePart
	local g = groundAt(from)
	local d = flat(dir).Unit
	local center = g + d * (length / 2) + Vector3.new(0, 0.12, 0)
	local p = Instance.new("Part")
	p.Size = Vector3.new(width, 0.15, length)
	p.CFrame = CFrame.lookAt(center, center + d)
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Material = Enum.Material.Neon
	p.Color = TELEGRAPH_COLOR
	p.Transparency = 0.75
	p.Parent = telegraphFolder
	TweenService:Create(p, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Transparency = 0.35 }):Play()
	return p
end

local function playersInCircle(center: Vector3, radius: number): { Player }
	local list = {}
	for _, p in ctx.Expedition.Participants() do
		local root = ctx.PlayerState.GetRoot(p)
		if root and (flat(root.Position) - flat(center)).Magnitude <= radius + 1 and math.abs(root.Position.Y - center.Y) < 12 then
			table.insert(list, p)
		end
	end
	return list
end

local function playersInRect(part: BasePart): { Player }
	local list = {}
	for _, p in ctx.Expedition.Participants() do
		local root = ctx.PlayerState.GetRoot(p)
		if root then
			local rel = part.CFrame:PointToObjectSpace(root.Position)
			if math.abs(rel.X) <= part.Size.X / 2 + 1 and math.abs(rel.Z) <= part.Size.Z / 2 + 1 and math.abs(rel.Y) < 12 then
				table.insert(list, p)
			end
		end
	end
	return list
end

--------------------------------------------------------------------------------
-- KI
--------------------------------------------------------------------------------
local function canAct(e: Entity): boolean
	local now = os.clock()
	return not e.dead and e.status.frozenUntil < now and e.status.stunnedUntil < now
end

local function face(e: Entity, pos: Vector3)
	local from = e.root.Position
	local to = Vector3.new(pos.X, from.Y, pos.Z)
	if (to - from).Magnitude > 0.1 then
		e.root.CFrame = CFrame.lookAt(from, to)
	end
end

local function stop(e: Entity)
	if e.humanoid then
		e.humanoid:Move(Vector3.zero)
		e.humanoid.WalkSpeed = 0
	end
end

-- Führt einen angekündigten Angriff aus; bricht ab, wenn der Gegner unterbrochen wird.
local function windupAttack(e: Entity, windup: number, telegraph: BasePart, resolve: () -> ())
	local token = e.ai.token
	e.ai.telegraph = telegraph
	e.ai.busyUntil = os.clock() + windup + 0.3
	FxEvent:FireAllClients("Windup", e.model, windup)
	task.delay(windup, function()
		if telegraph.Parent then
			telegraph:Destroy()
		end
		if e.ai.telegraph == telegraph then
			e.ai.telegraph = nil
		end
		if e.ai.token ~= token or not canAct(e) then
			return
		end
		FxEvent:FireAllClients("EnemyStrike", e.model)
		resolve()
	end)
end

local function meleeAttack(e: Entity, target: Player)
	local def = e.def
	local root = ctx.PlayerState.GetRoot(target)
	if not root then
		return
	end
	face(e, root.Position)
	stop(e)
	local center = e.root.Position + e.root.CFrame.LookVector * (def.attackRange * 0.55)
	local radius = def.attackRange * 0.65 + 1
	local tel = Entities.TelegraphCircle(center, radius, def.windup)
	windupAttack(e, def.windup, tel, function()
		for _, p in playersInCircle(center, radius) do
			ctx.PlayerState.Damage(p, def.damage * e.dmgMult, e.kind)
		end
	end)
end

local function rootAttack(e: Entity, target: Player)
	local root = ctx.PlayerState.GetRoot(target)
	if not root then
		return
	end
	face(e, root.Position)
	stop(e)
	local center = root.Position
	local tel = Entities.TelegraphCircle(center, 5.5, 1.1, Color3.fromRGB(120, 200, 80))
	windupAttack(e, 1.1, tel, function()
		FxEvent:FireAllClients("Roots", groundAt(center), 5.5)
		for _, p in playersInCircle(center, 5.5) do
			if ctx.PlayerState.Damage(p, e.def.damage * e.dmgMult, e.kind) then
				ctx.PlayerState.Root(p, 1.5)
			end
		end
	end)
end

local function projectileAttack(e: Entity, target: Player)
	local root = ctx.PlayerState.GetRoot(target)
	if not root then
		return
	end
	face(e, root.Position)
	stop(e)
	local token = e.ai.token
	e.ai.busyUntil = os.clock() + 1
	FxEvent:FireAllClients("Windup", e.model, 0.6)
	task.delay(0.6, function()
		if e.ai.token ~= token or not canAct(e) then
			return
		end
		local tRoot = ctx.PlayerState.GetRoot(target)
		if not tRoot then
			return
		end
		local start = e.root.Position + Vector3.new(0, 0.5, 0)
		local orb = Instance.new("Part")
		orb.Shape = Enum.PartType.Ball
		orb.Size = Vector3.new(1.4, 1.4, 1.4)
		orb.Material = Enum.Material.Neon
		orb.Color = Color3.fromRGB(255, 220, 120)
		orb.Anchored = true
		orb.CanCollide = false
		orb.CanQuery = false
		orb.CFrame = CFrame.new(start)
		local light = Instance.new("PointLight")
		light.Color = orb.Color
		light.Range = 10
		light.Parent = orb
		orb.Parent = telegraphFolder
		local speed = 34
		local vel = (tRoot.Position - start).Unit * speed
		local t0 = os.clock()
		local conn
		conn = RunService.Heartbeat:Connect(function(dt)
			if os.clock() - t0 > 3 or not orb.Parent then
				conn:Disconnect()
				orb:Destroy()
				return
			end
			-- leichtes Nachsteuern
			local cur = ctx.PlayerState.GetRoot(target)
			if cur and os.clock() - t0 < 0.8 then
				local desired = (cur.Position - orb.Position).Unit * speed
				vel = vel:Lerp(desired, math.min(1, dt * 1.5))
			end
			orb.CFrame = orb.CFrame + vel * dt
			for _, p in ctx.Expedition.Participants() do
				local pr = ctx.PlayerState.GetRoot(p)
				if pr and (pr.Position - orb.Position).Magnitude < 2.6 then
					ctx.PlayerState.Damage(p, e.def.damage * e.dmgMult, e.kind)
					conn:Disconnect()
					orb:Destroy()
					return
				end
			end
		end)
	end)
end

-- Boss: Hollow Warden -------------------------------------------------------

local function bossSlam(e: Entity)
	stop(e)
	local center = e.root.Position
	local tel = Entities.TelegraphCircle(center, 16, 1.5)
	windupAttack(e, 1.5, tel, function()
		FxEvent:FireAllClients("Slam", groundAt(center), 16)
		for _, p in playersInCircle(center, 16) do
			ctx.PlayerState.Damage(p, 24 * e.dmgMult, "Bodenstoß")
		end
	end)
end

local function bossRootStrike(e: Entity, target: Player)
	local root = ctx.PlayerState.GetRoot(target)
	if not root then
		return
	end
	face(e, root.Position)
	stop(e)
	local tel = Entities.TelegraphRect(e.root.Position, e.root.CFrame.LookVector, 7, 44, 1.2)
	windupAttack(e, 1.2, tel, function()
		FxEvent:FireAllClients("RootLine", tel.CFrame, 44)
		for _, p in playersInRect(tel) do
			if ctx.PlayerState.Damage(p, 20 * e.dmgMult, "Wurzelschlag") then
				ctx.PlayerState.Root(p, 1)
			end
		end
	end)
end

local function bossBurst(e: Entity)
	local arena = e.ai.arenaCenter :: Vector3
	local participants = ctx.Expedition.Participants()
	local party = math.max(1, #participants)
	e.ai.busyUntil = os.clock() + 2.5
	stop(e)
	ctx.PlayerState.NotifyAll(participants, "Rift-Ausbruch! Zerstört die Riftkristalle, bevor sie explodieren!", "boss")
	FxEvent:FireAllClients("BossRoar", e.root.Position)
	local crystals: { Entity } = {}
	local remaining = 3
	local startAngle = math.random() * math.pi * 2
	for i = 1, 3 do
		local a = startAngle + (i / 3) * math.pi * 2
		local pos = arena + Vector3.new(math.cos(a) * 28, 0, math.sin(a) * 28)
		local g = groundAt(pos)
		local m = Instance.new("Model")
		m.Name = "RiftCrystal"
		local p = Instance.new("Part")
		p.Size = Vector3.new(2.4, 6, 2.4)
		p.CFrame = CFrame.new(g + Vector3.new(0, 3, 0)) * CFrame.Angles(0, a, math.rad(8))
		p.Color = Config.Colors.Rift
		p.Material = Enum.Material.Neon
		p.Anchored = true
		p.Parent = m
		local l = Instance.new("PointLight")
		l.Color = Config.Colors.Rift
		l.Range = 16
		l.Parent = p
		m.PrimaryPart = p
		local ce = Entities.RegisterStatic(m, {
			kind = "WardenCrystal",
			name = "Riftkristall",
			hp = Config.Boss.BurstCrystalHP * (1 + 0.5 * (party - 1)),
			shield = true,
			tag = e.tag,
			onDeath = function()
				remaining -= 1
			end,
		})
		table.insert(crystals, ce)
	end
	-- kleine Gegner passend zur Gruppengröße
	for i = 1, math.min(4, party) do
		local a = math.random() * math.pi * 2
		Entities.SpawnEnemy("Riftling", arena + Vector3.new(math.cos(a) * 36, 0, math.sin(a) * 36), { tag = e.tag, dmgMult = e.dmgMult, lootMult = 0.5 })
	end
	local token = e.ai.token
	local t0 = os.clock()
	task.spawn(function()
		while os.clock() - t0 < Config.Boss.BurstTime and remaining > 0 and not e.dead do
			ReplicatedStorage:SetAttribute("BossBurst", math.ceil(Config.Boss.BurstTime - (os.clock() - t0)))
			task.wait(0.25)
		end
		ReplicatedStorage:SetAttribute("BossBurst", 0)
		if e.dead then
			for _, c in crystals do
				Entities.Kill(c)
			end
			return
		end
		if remaining <= 0 then
			ctx.PlayerState.NotifyAll(ctx.Expedition.Participants(), "Alle Kristalle zerstört – der Warden taumelt!", "good")
			e.status.stunnedUntil = os.clock() + 3.5
			setHighlight(e, Color3.fromRGB(255, 255, 255))
			task.delay(3.5, function()
				if not e.dead then
					setHighlight(e, nil)
				end
			end)
		else
			FxEvent:FireAllClients("Slam", arena, Config.Boss.ArenaRadius)
			for _, p in playersInCircle(arena, Config.Boss.ArenaRadius + 4) do
				ctx.PlayerState.Damage(p, Config.Boss.BurstDamage * remaining * e.dmgMult, "Rift-Ausbruch")
			end
			for _, c in crystals do
				if not c.dead then
					c.dead = true
					entities[c.id] = nil
					byModel[c.model] = nil
					c.model:Destroy()
				end
			end
		end
		if e.ai.token == token then
			e.ai.busyUntil = 0
		end
	end)
	e.ai.busyUntil = os.clock() + Config.Boss.BurstTime + 0.5
end

local function nearestTarget(e: Entity, range: number): (Player?, number)
	local best, bestD = nil, range
	for _, p in ctx.Expedition.Participants() do
		if ctx.PlayerState.IsActive(p) then
			local root = ctx.PlayerState.GetRoot(p)
			if root then
				local d = (root.Position - e.root.Position).Magnitude
				if d < bestD then
					best, bestD = p, d
				end
			end
		end
	end
	return best, bestD
end

function Entities.Wake(e: Entity)
	if not e.ai.dormant then
		return
	end
	e.ai.dormant = false
	e.ai.nextAttack = os.clock() + 0.4
	if e.kind == "Burrow_Mimic" then
		FxEvent:FireAllClients("MimicReveal", e.model)
		e.name = e.def.name
		local gui = e.root:FindFirstChild("HPBar") :: BillboardGui?
		if gui then
			gui.Enabled = true
			local label = gui:FindFirstChildOfClass("TextLabel")
			if label then
				label.Text = e.name
			end
		end
		for _, d in e.model:GetDescendants() do
			if d:IsA("BasePart") and (d.Name == "Tooth" or d.Name == "Tongue") then
				d.Transparency = 0
			elseif d:IsA("BasePart") and d.Name == "MimicLid" then
				local weld = d:FindFirstChildOfClass("WeldConstraint")
				if weld then
					weld.Enabled = false
					d.CFrame = d.CFrame * CFrame.new(0, 0.8, 0.9) * CFrame.Angles(math.rad(-50), 0, 0)
					weld.Enabled = true
				end
			elseif d:IsA("ProximityPrompt") then
				d:Destroy()
			end
		end
	end
	if e.isBoss then
		ReplicatedStorage:SetAttribute("BossActive", true)
		ReplicatedStorage:SetAttribute("BossName", e.name)
		updateBar(e)
		ctx.PlayerState.NotifyAll(ctx.Expedition.Participants(), "Der Hollow Warden erwacht!", "boss")
		FxEvent:FireAllClients("BossRoar", e.root.Position)
	end
end

local function think(e: Entity, now: number)
	local def = e.def
	local hum = e.humanoid :: Humanoid
	if not def or not hum then
		return
	end
	if not canAct(e) then
		hum:Move(Vector3.zero)
		hum.WalkSpeed = 0
		return
	end
	if e.ai.dormant then
		local target, dist = nearestTarget(e, if e.isBoss then 999 else 7)
		if target then
			if e.isBoss then
				local root = ctx.PlayerState.GetRoot(target)
				if root and (flat(root.Position) - flat(e.ai.arenaCenter)).Magnitude < Config.Boss.ArenaRadius - 4 then
					Entities.Wake(e)
				end
			elseif dist <= 7 then
				Entities.Wake(e)
			end
		end
		return
	end
	if now < e.ai.busyUntil then
		hum:Move(Vector3.zero)
		return
	end
	local speed = def.speed * (if e.status.slowUntil > now then 0.5 else 1)
	hum.WalkSpeed = speed

	local aggro = if e.isBoss then 120 else 55
	local target, dist = nearestTarget(e, aggro)
	if not target then
		-- zurück nach Hause
		if (flat(e.root.Position) - flat(e.home)).Magnitude > 6 then
			hum:MoveTo(e.home)
		else
			hum:Move(Vector3.zero)
		end
		return
	end
	local tRoot = ctx.PlayerState.GetRoot(target) :: BasePart
	local tPos = tRoot.Position
	local ready = now >= e.ai.nextAttack

	if e.isBoss then
		if ready then
			local hpFrac = e.hp / e.maxHp
			local thresholds = e.ai.burstThresholds
			if thresholds[1] and hpFrac <= thresholds[1] then
				table.remove(thresholds, 1)
				e.ai.nextAttack = now + Config.Boss.BurstTime + 2
				bossBurst(e)
				return
			end
			if dist <= 13 then
				e.ai.nextAttack = now + def.cooldown + 1.2
				bossSlam(e)
				return
			elseif dist <= 40 then
				e.ai.nextAttack = now + def.cooldown + 0.8
				bossRootStrike(e, target)
				return
			end
		end
		hum:MoveTo(tPos)
		return
	end

	if e.kind == "Lantern_Wraith" then
		if dist < 14 then
			local away = flat(e.root.Position - tPos)
			if away.Magnitude < 0.1 then
				away = Vector3.new(1, 0, 0)
			end
			hum:MoveTo(e.root.Position + away.Unit * 10)
		elseif dist > 24 then
			hum:MoveTo(tPos)
		else
			hum:Move(Vector3.zero)
			face(e, tPos)
		end
		if ready and dist <= def.attackRange + 4 then
			e.ai.nextAttack = now + def.cooldown
			projectileAttack(e, target)
		end
		return
	end

	if e.kind == "Rootstalker" and ready and dist > 7 and dist < 28 and now >= (e.ai.nextRoot or 0) then
		e.ai.nextRoot = now + 5
		e.ai.nextAttack = now + def.cooldown
		rootAttack(e, target)
		return
	end

	if dist <= def.attackRange + 1 then
		if ready then
			e.ai.nextAttack = now + def.cooldown
			meleeAttack(e, target)
		else
			hum:Move(Vector3.zero)
			face(e, tPos)
		end
		return
	end

	if e.kind == "Rift_Crawler" and dist > 11 then
		-- Flankieren: seitlich um den Spieler herum
		local toTarget = flat(tPos - e.root.Position).Unit
		local side = Vector3.new(-toTarget.Z, 0, toTarget.X) * e.ai.side
		hum:MoveTo(tPos + side * 9)
		return
	end
	hum:MoveTo(tPos)
end

function Entities.SetupBoss(e: Entity, arenaCenter: Vector3)
	e.ai.dormant = true
	e.ai.arenaCenter = arenaCenter
	e.ai.burstThresholds = { 0.7, 0.4, 0.15 }
	ReplicatedStorage:SetAttribute("BossActive", false)
end

--------------------------------------------------------------------------------
-- Aufräumen
--------------------------------------------------------------------------------
function Entities.ClearTag(tag: string)
	for id, e in entities do
		if e.tag == tag then
			e.dead = true
			entities[id] = nil
			byModel[e.model] = nil
			e.model:Destroy()
		end
	end
	telegraphFolder:ClearAllChildren()
	ReplicatedStorage:SetAttribute("BossActive", false)
	ReplicatedStorage:SetAttribute("BossBurst", 0)
end

function Entities.All(): { [number]: Entity }
	return entities
end

--------------------------------------------------------------------------------
-- Start
--------------------------------------------------------------------------------
function Entities.Init(context)
	ctx = context
	folder = Instance.new("Folder")
	folder.Name = "Entities"
	folder.Parent = workspace
	telegraphFolder = Instance.new("Folder")
	telegraphFolder.Name = "Telegraphs"
	telegraphFolder.Parent = workspace
end

function Entities.Start()
	local accum = 0
	RunService.Heartbeat:Connect(function(dt)
		accum += dt
		if accum < 0.1 then
			return
		end
		accum = 0
		local now = os.clock()
		for _, e in entities do
			if e.dead then
				continue
			end
			local s = e.status
			-- Brand
			if s.burnStacks > 0 then
				if now > s.burnUntil then
					s.burnStacks = 0
					local f = e.root:FindFirstChild("BurnFire")
					if f then
						f:Destroy()
					end
				elseif now >= s.nextBurn then
					s.nextBurn = now + 0.5
					Entities.Damage(e, 2.5 * s.burnStacks, { player = e.lastHitBy, color = Config.Elements.Ember.color, elements = { "Ember" } })
					if e.dead then
						continue
					end
				end
			end
			-- Frost-Highlight entfernen
			if s.frozenUntil > 0 and s.frozenUntil < now then
				s.frozenUntil = 0
				setHighlight(e, if s.markUntil > now then Config.Elements.Shadow.color else nil)
			elseif s.frozenUntil < now then
				local marked = s.markUntil > now
				local h = e.model:FindFirstChild("StatusHighlight") :: Highlight?
				if marked and not h then
					setHighlight(e, Config.Elements.Shadow.color)
				elseif not marked and h and not (e.isBoss and s.stunnedUntil > now) then
					setHighlight(e, nil)
				end
			end
			if e.isEnemy then
				think(e, now)
			end
		end
	end)
end

return Entities
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Expedition</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Expeditionen: Lobby an der Tafel, Start, zufällige Bestückung von
-- Verdant Scar, Rückkehr/Beutesicherung, Niederschlag, Wiederbeleben, Teamwipe.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)

local Expedition = {}
local ctx: any

local MAX_PARTY = 4
local LOBBY_TIME = 20
local TAG = "Run"

local phase: string = "Idle"
local difficulty = "Normal"
local leader: Player? = nil
local members: { Player } = {}
local participants: { Player } = {}
local lobbyEnds = 0
local runStart = 0
local bossDead = false
local runFolder: Folder? = nil
local arenaPortalPrompt: ProximityPrompt? = nil
local arenaSurface: BasePart? = nil
local disconnected: { [number]: { backpack: { [string]: number }, protectedLoot: { [string]: number } } } = {}
local revivePrompts: { [Player]: ProximityPrompt } = {}

--------------------------------------------------------------------------------
-- Öffentliche Infos
--------------------------------------------------------------------------------
local function names(list: { Player }): { string }
	local out = {}
	for _, p in list do
		table.insert(out, p.DisplayName)
	end
	return out
end

function Expedition.PublicInfo()
	return {
		phase = phase,
		difficulty = difficulty,
		leader = if leader then leader.DisplayName else nil,
		leaderId = if leader then leader.UserId else nil,
		members = names(members),
		participants = names(participants),
		lobbyEnds = lobbyEnds,
		runStart = runStart,
		bossDead = bossDead,
	}
end

function Expedition.Participants(): { Player }
	return participants
end

local function isParticipant(p: Player): boolean
	return table.find(participants, p) ~= nil
end

local function removeFrom(list: { Player }, p: Player)
	local i = table.find(list, p)
	if i then
		table.remove(list, i)
	end
end

local function teleport(player: Player, pos: Vector3)
	local char = player.Character
	if char then
		local offset = Vector3.new(math.random(-4, 4), 3.5, math.random(-4, 4))
		char:PivotTo(CFrame.new(pos + offset) * CFrame.Angles(0, math.pi, 0))
	end
end

local function hasWeapon(player: Player): boolean
	return ctx.PlayerState.GetWeapon(player) ~= nil
end

--------------------------------------------------------------------------------
-- Lauf bestücken
--------------------------------------------------------------------------------
local function shuffle<T>(list: { T }): { T }
	local copy = table.clone(list)
	for i = #copy, 2, -1 do
		local j = math.random(1, i)
		copy[i], copy[j] = copy[j], copy[i]
	end
	return copy
end

local function jitter(pos: Vector3, amount: number): Vector3
	return pos + Vector3.new(math.random(-amount, amount), 0, math.random(-amount, amount))
end

local function lootAll(items: { [string]: number }, protected: boolean?)
	for _, p in participants do
		ctx.PlayerState.AddLoot(p, table.clone(items), protected)
	end
end

local function scaleLoot(items: { [string]: number }): { [string]: number }
	local mult = Config.Difficulties[difficulty].loot
	for k, v in items do
		if Config.Items[k].kind == "Basic" then
			items[k] = math.max(1, math.floor(v * mult + 0.5))
		end
	end
	return items
end

local function randomCore(): string
	local el = Config.ElementOrder[math.random(1, #Config.ElementOrder)]
	return Config.Elements[el].core
end

local function randomPart(): string
	local parts = { "PartCrawlerClaw", "PartWraithCore", "PartStalkerBark", "PartMimicTooth" }
	return parts[math.random(1, #parts)]
end

local NODE_YIELD: { [string]: { string | number } } = {
	Copper_Deposit = { "CopperOre", 3, 4 },
	Stone_Deposit = { "Stone", 2, 3 },
	Timber_Pile = { "Wood", 2, 3 },
	Rift_Deposit = { "RiftCrystal", 2, 3 },
}

local function spawnNode(kind: string, pos: Vector3)
	local folder = runFolder :: Folder
	local m = ctx.WorldBuilder.Place(kind, pos, math.random(0, 359), nil, folder)
	local prompt = ctx.WorldBuilder.Prompt(ctx.WorldBuilder.PromptAnchor(m), "Abbauen", Config.Items[NODE_YIELD[kind][1] :: string].name, 1.1)
	local used = false
	prompt.Triggered:Connect(function(player)
		if used or not isParticipant(player) or not ctx.PlayerState.IsActive(player) then
			return
		end
		used = true
		local y = NODE_YIELD[kind]
		local item = y[1] :: string
		ctx.PlayerState.AddLoot(player, scaleLoot({ [item] = math.random(y[2] :: number, y[3] :: number) }))
		Net.Event("Fx"):FireAllClients("Harvest", pos)
		for _, d in m:GetDescendants() do
			if d:IsA("BasePart") then
				TweenService:Create(d, TweenInfo.new(0.4), { Transparency = 1 }):Play()
			end
		end
		task.delay(0.45, function()
			m:Destroy()
		end)
	end)
end

local function spawnChest(pos: Vector3, rare: boolean, mimic: boolean)
	local diff = Config.Difficulties[difficulty]
	if mimic then
		local e = ctx.Entities.SpawnEnemy(
			"Burrow_Mimic",
			pos,
			{ tag = TAG, dormant = true, hpMult = diff.hp, dmgMult = diff.damage, lootMult = diff.loot, yaw = math.random(0, 359) }
		)
		e.name = "Truhe"
		local label = e.root:FindFirstChild("HPBar") :: BillboardGui?
		if label then
			label.Enabled = false
		end
		local prompt = ctx.WorldBuilder.Prompt(e.root, "Öffnen", "Truhe")
		prompt.Triggered:Connect(function()
			ctx.Entities.Wake(e)
		end)
		return
	end
	local folder = runFolder :: Folder
	local m = ctx.WorldBuilder.Place("Storage_Chest", pos, math.random(0, 359), 2.4, folder)
	local prompt = ctx.WorldBuilder.Prompt(ctx.WorldBuilder.PromptAnchor(m), "Öffnen", if rare then "Seltene Truhe" else "Truhe", 0.5)
	prompt.Triggered:Connect(function(player)
		if not isParticipant(player) or not ctx.PlayerState.IsActive(player) or not prompt.Parent then
			return
		end
		prompt:Destroy()
		local loot: { [string]: number }
		if rare then
			loot = { RiftCrystal = math.random(2, 3) }
			if math.random() < 0.45 then
				loot[randomCore()] = 1
			end
			if math.random() < 0.3 then
				loot[randomPart()] = 1
			end
		else
			loot = { CopperBar = math.random(1, 2), RiftCrystal = math.random(1, 2) }
			if math.random() < 0.15 then
				loot[randomCore()] = 1
			end
		end
		lootAll(scaleLoot(loot))
		Net.Event("Fx"):FireAllClients("ChestOpen", m)
		task.delay(1.5, function()
			m:Destroy()
		end)
	end)
end

local function forParticipants(fn: (Player) -> ())
	for _, p in participants do
		fn(p)
	end
end

local function buildBarriers()
	local folder = runFolder :: Folder
	-- Rift-Barriere vor dem Schrein (jede Waffe, schwere Angriffe wirken doppelt)
	local seal = Instance.new("Model")
	seal.Name = "RiftSeal"
	local sp = Instance.new("Part")
	sp.Size = Vector3.new(2, 15, 17)
	sp.CFrame = CFrame.new(ctx.WorldBuilder.Points.RiftSeal + Vector3.new(0, 7.5, 0))
	sp.Anchored = true
	sp.Material = Enum.Material.ForceField
	sp.Color = Config.Colors.Rift
	sp.Parent = seal
	seal.PrimaryPart = sp
	seal.Parent = folder
	ctx.Entities.RegisterStatic(seal, {
		kind = "RiftSeal",
		name = "Rift-Barriere",
		hp = 160,
		shield = true,
		tag = TAG,
		barHeight = 9,
		onDeath = function()
			ctx.PlayerState.NotifyAll(participants, "Die Rift-Barriere ist gebrochen! Der Schrein ist offen.", "good")
			forParticipants(function(p)
				ctx.Progress.Milestone(p, "Barrier")
			end)
		end,
	})

	-- Frostsiegel vor dem Versteck (nur Glut oder Frost)
	local frost = Instance.new("Model")
	frost.Name = "FrostSeal"
	local fp = Instance.new("Part")
	fp.Size = Vector3.new(3, 15, 15)
	fp.CFrame = CFrame.new(ctx.WorldBuilder.Points.FrostSeal + Vector3.new(0, 7.5, 0))
	fp.Anchored = true
	fp.Material = Enum.Material.Ice
	fp.Color = Color3.fromRGB(160, 220, 255)
	fp.Transparency = 0.15
	fp.Parent = frost
	frost.PrimaryPart = fp
	frost.Parent = folder
	ctx.Entities.RegisterStatic(frost, {
		kind = "FrostSeal",
		name = "Frostsiegel",
		hp = 120,
		requires = { "Ember", "Frost" },
		tag = TAG,
		barHeight = 9,
		onDeath = function()
			ctx.PlayerState.NotifyAll(participants, "Das Frostsiegel ist offen – ein verborgenes Versteck!", "good")
			forParticipants(function(p)
				ctx.Progress.Milestone(p, "Barrier")
				ctx.Progress.CompleteQuest(p, "Explore")
			end)
		end,
	})

	-- Schrein: jeder Teilnehmer darf einmal einen Kern bergen
	local taken: { [number]: boolean } = {}
	local anchor = Instance.new("Part")
	anchor.Size = Vector3.new(1.4, 1.4, 1.4)
	anchor.Shape = Enum.PartType.Ball
	anchor.Material = Enum.Material.Neon
	anchor.Color = Color3.fromRGB(255, 255, 255)
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CFrame = CFrame.new(ctx.WorldBuilder.Points.Shrine + Vector3.new(0, 3, 0))
	anchor.Parent = folder
	local light = Instance.new("PointLight")
	light.Range = 12
	light.Parent = anchor
	local prompt = ctx.WorldBuilder.Prompt(anchor, "Kern bergen", "Elementschrein", 1)
	prompt.Triggered:Connect(function(player)
		if not isParticipant(player) or taken[player.UserId] then
			return
		end
		taken[player.UserId] = true
		ctx.PlayerState.AddLoot(player, { [randomCore()] = 1 })
		ctx.PlayerState.Notify(player, "Bring den Kern sicher zurück, um ihn zu behalten!", "info")
	end)

	-- Versteck hinter dem Frostsiegel
	spawnChest(ctx.WorldBuilder.Points.Cache, true, false)
	spawnChest(ctx.WorldBuilder.Points.Cache + Vector3.new(6, 0, 8), true, false)
end

local function buildPortals()
	local folder = runFolder :: Folder
	local points = ctx.WorldBuilder.Points
	-- Außenposten: Beute sichern oder zurückkehren
	local outpost = ctx.WorldBuilder.Place("Return_Portal", points.OutpostPortal, 90, nil, folder)
	local anchor = ctx.WorldBuilder.PromptAnchor(outpost)
	local secure = ctx.WorldBuilder.Prompt(anchor, "Beute sichern", "Außenposten", 0.5, Enum.KeyCode.G)
	secure.Triggered:Connect(function(player)
		if isParticipant(player) and ctx.PlayerState.IsActive(player) then
			if not ctx.PlayerState.SecureLoot(player) then
				ctx.PlayerState.Notify(player, "Dein Rucksack ist leer.", "info")
			end
		end
	end)
	local back = ctx.WorldBuilder.Prompt(anchor, "Zurück ins Camp", "Rückkehrportal", 1)
	back.Triggered:Connect(function(player)
		if isParticipant(player) and ctx.PlayerState.IsActive(player) then
			Expedition.ReturnPlayer(player, true)
		end
	end)

	-- Rift-Kammer: öffnet nach dem Boss
	local arena = ctx.WorldBuilder.Place("Return_Portal", points.ArenaPortal, 0, nil, folder)
	arenaSurface = arena:FindFirstChild("Surface", true) :: BasePart?
	if arenaSurface then
		arenaSurface.Transparency = 1
	end
	arenaPortalPrompt = ctx.WorldBuilder.Prompt(ctx.WorldBuilder.PromptAnchor(arena), "Zurück ins Camp", "Rückkehrportal", 1)
	local ap = arenaPortalPrompt :: ProximityPrompt
	ap.Enabled = false
	ap.Triggered:Connect(function(player)
		if bossDead and isParticipant(player) and ctx.PlayerState.IsActive(player) then
			Expedition.ReturnPlayer(player, true)
		end
	end)
end

local function spawnBoss(partySize: number)
	local diff = Config.Difficulties[difficulty]
	local hpMult = diff.hp * (1 + Config.Boss.HPPerExtraPlayer * (partySize - 1))
	local points = ctx.WorldBuilder.Points
	local boss = ctx.Entities.SpawnEnemy("Hollow_Warden", points.ArenaCenter, {
		tag = TAG,
		hpMult = hpMult,
		dmgMult = diff.damage,
		lootMult = diff.loot,
		yaw = 0,
		onDeath = function()
			bossDead = true
			ReplicatedStorage:SetAttribute("BossActive", false)
			ctx.PlayerState.NotifyAll(participants, "Der Hollow Warden ist besiegt! Das Rückkehrportal ist offen.", "milestone")
			forParticipants(function(p)
				ctx.Progress.Milestone(p, "Warden")
				local w = ctx.PlayerState.GetWeapon(p)
				if w and w.forged then
					ctx.Progress.CompleteQuest(p, "Boss")
				end
			end)
			if arenaPortalPrompt then
				arenaPortalPrompt.Enabled = true
			end
			if arenaSurface then
				arenaSurface.Transparency = 0.25
			end
			ctx.PlayerState.SyncAll()
		end,
	})
	ctx.Entities.SetupBoss(boss, points.ArenaCenter)
end

local function populate(partySize: number)
	local diff = Config.Difficulties[difficulty]
	for _, section in ctx.WorldBuilder.Spawns do
		local hpMult = diff.hp * (section.hpMult or 1)
		for i, entry in shuffle(section.enemies) do
			if i > section.enemyCount then
				break
			end
			ctx.Entities.SpawnEnemy(entry[1], jitter(entry[2], 5), { tag = TAG, hpMult = hpMult, dmgMult = diff.damage, lootMult = diff.loot })
		end
		-- Zusätzliche Gegner für größere Gruppen
		for i = 1, partySize - 1 do
			local entry = section.enemies[math.random(1, #section.enemies)]
			if i <= 2 then
				ctx.Entities.SpawnEnemy(entry[1], jitter(entry[2], 8), { tag = TAG, hpMult = hpMult, dmgMult = diff.damage, lootMult = diff.loot })
			end
		end
		for i, pos in shuffle(section.nodes) do
			if i > section.nodeCount then
				break
			end
			spawnNode(section.nodeKinds[math.random(1, #section.nodeKinds)], jitter(pos, 3))
		end
		if section.chests then
			local mimics = section.mimicCount or 0
			for i, pos in shuffle(section.chests) do
				if i > section.chestCount then
					break
				end
				local mimic = mimics > 0 or math.random() < (section.mimicChance or 0)
				if mimics > 0 then
					mimics -= 1
				end
				spawnChest(pos, section.rare == true, mimic)
			end
		end
	end
	buildBarriers()
	buildPortals()
	spawnBoss(partySize)
end

--------------------------------------------------------------------------------
-- Ablauf
--------------------------------------------------------------------------------
local function endRun(reason: string?)
	ctx.Entities.ClearTag(TAG)
	if runFolder then
		runFolder:Destroy()
		runFolder = nil
	end
	for p, prompt in revivePrompts do
		prompt:Destroy()
		revivePrompts[p] = nil
	end
	phase = "Idle"
	participants = {}
	members = {}
	leader = nil
	bossDead = false
	arenaPortalPrompt = nil
	arenaSurface = nil
	disconnected = {}
	runStart = 0
	ReplicatedStorage:SetAttribute("RunStart", 0)
	if reason then
		ctx.PlayerState.NotifyAll(Players:GetPlayers(), reason, "info")
	end
	ctx.PlayerState.SyncAll()
end

local function joinRun(player: Player)
	local s = ctx.PlayerState.Get(player)
	if not s then
		return
	end
	if not isParticipant(player) then
		table.insert(participants, player)
	end
	s.inRun = true
	s.backpack = {}
	s.protectedLoot = {}
	ctx.PlayerState.ResetVitals(player)
	teleport(player, ctx.WorldBuilder.Points.ZoneArrival)
	ctx.PlayerState.Sync(player)
end

local function launch()
	if phase ~= "Lobby" then
		return
	end
	local ready = {}
	for _, p in members do
		if p.Parent == Players and hasWeapon(p) and ctx.PlayerState.Get(p) then
			table.insert(ready, p)
		end
	end
	if #ready == 0 then
		endRun("Expedition abgebrochen – niemand ist bereit.")
		return
	end
	phase = "Running"
	participants = {}
	runStart = workspace:GetServerTimeNow()
	ReplicatedStorage:SetAttribute("RunStart", runStart)
	local folder = Instance.new("Folder")
	folder.Name = "RunObjects"
	folder.Parent = workspace
	runFolder = folder
	populate(#ready)
	for _, p in ready do
		joinRun(p)
	end
	ctx.PlayerState.NotifyAll(
		participants,
		"Verdant Scar (" .. Config.Difficulties[difficulty].name .. "). Sammle Beute, finde Elementkerne – und kehre rechtzeitig zurück!",
		"boss"
	)
	ctx.PlayerState.SyncAll()
end

-- Spieler verlässt die Expedition. secure = Beute sichern.
function Expedition.ReturnPlayer(player: Player, secure: boolean)
	local s = ctx.PlayerState.Get(player)
	if not s then
		return
	end
	if secure then
		ctx.PlayerState.SecureLoot(player)
	end
	removeFrom(participants, player)
	local prompt = revivePrompts[player]
	if prompt then
		prompt:Destroy()
		revivePrompts[player] = nil
	end
	s.inRun = false
	s.backpack = {}
	s.protectedLoot = {}
	local hum = ctx.PlayerState.GetHumanoid(player)
	if hum and hum.Health > 0 then
		ctx.PlayerState.ResetVitals(player)
		teleport(player, ctx.WorldBuilder.Points.CampArrival)
	end
	ctx.PlayerState.Sync(player)
	if phase == "Running" and #participants == 0 then
		endRun(nil)
	end
end

local function checkWipe()
	if phase ~= "Running" or #participants == 0 then
		return
	end
	for _, p in participants do
		local s = ctx.PlayerState.Get(p)
		if s and not s.downed then
			return
		end
	end
	-- Teamwipe
	local list = table.clone(participants)
	ctx.PlayerState.NotifyAll(list, "Das Team ist gefallen. Ein Teil der ungesicherten Grundmaterialien ist verloren.", "bad")
	task.wait(2.5)
	for _, p in list do
		local s = ctx.PlayerState.Get(p)
		if s and s.inRun then
			ctx.PlayerState.LoseLoot(p, 0.5)
			Expedition.ReturnPlayer(p, true)
		end
	end
end

function Expedition.OnPlayerDowned(player: Player)
	if not isParticipant(player) then
		return
	end
	ctx.PlayerState.Notify(player, "Du bist niedergeschlagen! Ein Teammitglied kann dich wiederbeleben.", "bad")
	for _, p in participants do
		if p ~= player then
			ctx.PlayerState.Notify(p, player.DisplayName .. " ist niedergeschlagen – belebe ihn/sie wieder (E halten)!", "bad")
		end
	end
	local root = ctx.PlayerState.GetRoot(player)
	if root then
		local prompt = ctx.WorldBuilder.Prompt(root, "Wiederbeleben", player.DisplayName, Config.Player.ReviveTime)
		prompt.Triggered:Connect(function(helper)
			if helper == player or not isParticipant(helper) or not ctx.PlayerState.IsActive(helper) then
				return
			end
			prompt:Destroy()
			revivePrompts[player] = nil
			ctx.PlayerState.Revive(player, Config.Player.ReviveHealth)
			ctx.PlayerState.Notify(player, helper.DisplayName .. " hat dich wiederbelebt!", "good")
		end)
		revivePrompts[player] = prompt
	end
	local s = ctx.PlayerState.Get(player)
	local downedAt = s and s.downedAt
	task.delay(Config.Player.BleedoutTime, function()
		local cur = ctx.PlayerState.Get(player)
		if cur and cur.downed and cur.inRun and cur.downedAt == downedAt then
			Expedition.OnPlayerOut(player, "bleedout")
		end
	end)
	task.spawn(checkWipe)
end

-- Spieler scheidet aus (Ausbluten, Sturz): Teilverlust, zurück ins Camp.
function Expedition.OnPlayerOut(player: Player, reason: string)
	if not isParticipant(player) then
		return
	end
	ctx.PlayerState.LoseLoot(player, 0.5)
	ctx.PlayerState.Notify(player, if reason == "fall" then "Du bist abgestürzt." else "Du hast es nicht geschafft und kehrst ins Camp zurück.", "bad")
	Expedition.ReturnPlayer(player, true)
	task.spawn(checkWipe)
end

function Expedition.OnPlayerLeft(player: Player, s: any)
	disconnected[player.UserId] = { backpack = s.backpack, protectedLoot = s.protectedLoot }
	removeFrom(participants, player)
	removeFrom(members, player)
	local prompt = revivePrompts[player]
	if prompt then
		prompt:Destroy()
		revivePrompts[player] = nil
	end
	if phase == "Running" and #participants == 0 then
		endRun(nil)
	else
		task.spawn(checkWipe)
	end
end

-- Nach Verbindungsabbruch: zurück in den laufenden Lauf, Rucksack bleibt erhalten.
function Expedition.TryRestore(player: Player)
	local saved = disconnected[player.UserId]
	if not saved or phase ~= "Running" or #participants >= MAX_PARTY then
		return
	end
	disconnected[player.UserId] = nil
	joinRun(player)
	local s = ctx.PlayerState.Get(player)
	if s then
		s.backpack = saved.backpack
		s.protectedLoot = saved.protectedLoot
	end
	ctx.PlayerState.Notify(player, "Willkommen zurück – dein Rucksack ist noch da.", "good")
	ctx.PlayerState.Sync(player)
end

--------------------------------------------------------------------------------
-- Anfragen von der Tafel
--------------------------------------------------------------------------------
function Expedition.Handle(player: Player, action: string, a: any): boolean
	if action == "ExpCreate" then
		if phase ~= "Idle" then
			ctx.PlayerState.Notify(player, "Es läuft bereits eine Expedition.", "bad")
		elseif not hasWeapon(player) then
			ctx.PlayerState.Notify(player, "Schmiede zuerst eine Waffe!", "bad")
		else
			difficulty = if a == "Hard" then "Hard" else "Normal"
			phase = "Lobby"
			leader = player
			members = { player }
			lobbyEnds = workspace:GetServerTimeNow() + LOBBY_TIME
			local myEnds = lobbyEnds
			ctx.PlayerState.NotifyAll(
				Players:GetPlayers(),
				player.DisplayName .. " plant eine Expedition (" .. Config.Difficulties[difficulty].name .. "). An der Tafel beitreten!",
				"info"
			)
			task.delay(LOBBY_TIME, function()
				if phase == "Lobby" and lobbyEnds == myEnds then
					launch()
				end
			end)
		end
	elseif action == "ExpJoin" then
		if not hasWeapon(player) then
			ctx.PlayerState.Notify(player, "Schmiede zuerst eine Waffe!", "bad")
		elseif phase == "Lobby" then
			if not table.find(members, player) and #members < MAX_PARTY then
				table.insert(members, player)
			end
		elseif phase == "Running" then
			local s = ctx.PlayerState.Get(player)
			if s and not s.inRun and #participants < MAX_PARTY then
				joinRun(player)
				ctx.PlayerState.NotifyAll(participants, player.DisplayName .. " ist der Expedition beigetreten.", "info")
			end
		end
	elseif action == "ExpLeave" then
		removeFrom(members, player)
		if phase == "Lobby" then
			if #members == 0 then
				endRun(nil)
			elseif leader == player then
				leader = members[1]
			end
		end
	elseif action == "ExpLaunch" then
		if phase == "Lobby" and leader == player then
			launch()
		end
	elseif action == "ExpDifficulty" then
		if phase == "Lobby" and leader == player then
			difficulty = if a == "Hard" then "Hard" else "Normal"
		end
	elseif action == "ExpAbandon" then
		-- Expedition freiwillig verlassen (ohne Portal): wie Ausscheiden
		local s = ctx.PlayerState.Get(player)
		if s and s.inRun then
			Expedition.OnPlayerOut(player, "abandon")
		end
	else
		return false
	end
	ctx.PlayerState.SyncAll()
	return true
end

function Expedition.Init(context)
	ctx = context
end

function Expedition.Start()
	Players.PlayerRemoving:Connect(function(player)
		removeFrom(members, player)
		if phase == "Lobby" and #members == 0 then
			endRun(nil)
		elseif leader == player then
			leader = members[1]
		end
	end)
end

return Expedition
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Forge</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Schmiede, Schmelzofen, Forschungstisch, Arsenal und Lagerkiste.
-- Alle Aktionen sind nur im Camp möglich und werden serverseitig geprüft.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)

local Forge = {}
local ctx: any

type Recipe = { form: string, e1: string?, e2: string?, part: string?, blueprint: number? }
type Session = { recipe: Recipe, start: number, created: number }

local sessions: { [Player]: Session } = {}

local function inCamp(player: Player): boolean
	local s = ctx.PlayerState.Get(player)
	return s ~= nil and not s.inRun
end

-- Prüft ein Rezept und liefert die Gesamtkosten (oder nil + Grund).
local function validate(player: Player, raw: any): (Recipe?, { [string]: number }?, string?)
	if type(raw) ~= "table" then
		return nil, nil, "Ungültiges Rezept"
	end
	local profile = ctx.DataService.Get(player)
	if not profile then
		return nil, nil, "Profil lädt noch"
	end
	local form = raw.form
	if type(form) ~= "string" or not Config.Forms[form] then
		return nil, nil, "Unbekannte Waffenform"
	end
	if not profile.unlocked[form] then
		return nil, nil, Config.Forms[form].name .. " ist noch nicht erforscht"
	end
	local e1 = if type(raw.e1) == "string" and Config.Elements[raw.e1] then raw.e1 else nil
	local e2 = if type(raw.e2) == "string" and Config.Elements[raw.e2] then raw.e2 else nil
	if not e1 and e2 then
		e1, e2 = e2, nil
	end
	if e1 and e1 == e2 then
		return nil, nil, "Zwei verschiedene Elemente wählen"
	end
	local part = if type(raw.part) == "string" and Config.Items[raw.part] and Config.Items[raw.part].kind == "Part" then raw.part else nil
	if #profile.weapons >= Config.MaxWeapons then
		return nil, nil, "Arsenal voll (max. " .. Config.MaxWeapons .. "). Schmelze eine Waffe ein."
	end
	local cost: { [string]: number } = {}
	for k, v in Config.Forms[form].cost do
		cost[k] = (cost[k] or 0) + v
	end
	for _, el in { e1, e2 } do
		if el then
			local core = Config.Elements[el].core
			cost[core] = (cost[core] or 0) + 1
			for k, v in Config.ElementCost do
				cost[k] = (cost[k] or 0) + v
			end
		end
	end
	if part then
		cost[part] = (cost[part] or 0) + 1
	end
	if not ctx.DataService.Has(player, cost) then
		return nil, nil, "Nicht genug Materialien"
	end
	local bp = if type(raw.blueprint) == "number" then raw.blueprint else nil
	return { form = form, e1 = e1, e2 = e2, part = part, blueprint = bp }, cost, nil
end

local function finish(player: Player, session: Session, times: { number }): (boolean, string, number?)
	local recipe, cost, err = validate(player, session.recipe)
	if not recipe or not cost then
		return false, err or "Fehler"
	end
	-- Timing auswerten (Serverzeit-Stempel; Werte außerhalb des Fensters zählen nicht)
	local now = workspace:GetServerTimeNow()
	local score = 0
	local last = session.start
	for i = 1, math.min(#times, Config.Hardening.Strikes) do
		local t = times[i]
		if type(t) == "number" and t >= last and t <= now + 0.1 then
			last = t
			local pos = Config.HardeningPos(t - session.start)
			local off = math.abs(pos - 0.5)
			if off <= Config.Hardening.Perfect then
				score += 2
			elseif off <= Config.Hardening.Good then
				score += 1
			end
		end
	end
	local quality = Config.QualityFromScore(score)
	if not ctx.DataService.Take(player, cost) then
		return false, "Nicht genug Materialien"
	end
	local profile = ctx.DataService.Get(player)
	local id = "w" .. profile.nextWeaponId
	profile.nextWeaponId += 1
	local weapon = {
		id = id,
		form = recipe.form,
		e1 = recipe.e1,
		e2 = recipe.e2,
		part = recipe.part,
		quality = quality,
		forged = true,
	}
	table.insert(profile.weapons, weapon)
	profile.equipped = id
	ctx.DataService.MarkDirty(player)

	ctx.Progress.Milestone(player, "FirstWeapon")
	if recipe.e1 then
		ctx.Progress.Milestone(player, "ElementWeapon")
	end
	if recipe.e1 and recipe.e2 then
		ctx.Progress.CompleteQuest(player, "Smith")
	end
	if recipe.part then
		ctx.Progress.Milestone(player, "MonsterPart")
	end
	if recipe.blueprint then
		local bp = profile.blueprints[recipe.blueprint]
		if bp and bp.form == recipe.form and (bp.e1 ~= recipe.e1 or bp.e2 ~= recipe.e2) and recipe.e1 then
			ctx.Progress.Milestone(player, "Rebuild")
		end
	end
	ctx.PlayerState.AttachWeapon(player)
	ctx.PlayerState.Sync(player)
	return true, "Geschmiedet: " .. Forge.WeaponName(weapon) .. " (" .. Config.Quality[quality].name .. ")", quality
end

function Forge.WeaponName(w: any): string
	local name = Config.Forms[w.form].name
	local key = Config.ComboKey(w.e1, w.e2)
	if key then
		return Config.Combos[key].name .. "-" .. name
	elseif w.e1 then
		return Config.Elements[w.e1].name .. "-" .. name
	end
	return name
end

--------------------------------------------------------------------------------
-- Weitere Stationen (über das "Request"-Remote)
--------------------------------------------------------------------------------
local handlers: { [string]: (Player, any, any) -> () } = {}

handlers.Smelt = function(player, amount)
	local n = if type(amount) == "number" then math.clamp(math.floor(amount), 1, 999) else 1
	local profile = ctx.DataService.Get(player)
	local have = profile.stash[Config.Smelt.input] or 0
	n = math.min(n, math.floor(have / Config.Smelt.inputAmount))
	if n <= 0 then
		ctx.PlayerState.Notify(player, "Du brauchst " .. Config.Smelt.inputAmount .. " Kupfererz pro Barren.", "bad")
		return
	end
	ctx.DataService.Take(player, { [Config.Smelt.input] = n * Config.Smelt.inputAmount })
	ctx.DataService.Give(player, { [Config.Smelt.output] = n })
	ctx.PlayerState.Notify(player, n .. " Kupferbarren geschmolzen.", "good")
	Net.Event("Fx"):FireAllClients("Smelt", player)
end

handlers.Research = function(player, form)
	local def = type(form) == "string" and Config.Forms[form]
	local profile = ctx.DataService.Get(player)
	if not def or not def.research or profile.unlocked[form] then
		return
	end
	if not ctx.DataService.Take(player, def.research) then
		ctx.PlayerState.Notify(player, "Nicht genug Materialien für die Forschung.", "bad")
		return
	end
	profile.unlocked[form] = true
	ctx.PlayerState.Notify(player, "Neue Waffenform erforscht: " .. def.name, "milestone")
end

handlers.Equip = function(player, id)
	local profile = ctx.DataService.Get(player)
	for _, w in profile.weapons do
		if w.id == id then
			profile.equipped = id
			ctx.PlayerState.AttachWeapon(player)
			ctx.PlayerState.Notify(player, "Ausgerüstet: " .. Forge.WeaponName(w), "info")
		end
	end
end

handlers.Scrap = function(player, id)
	local profile = ctx.DataService.Get(player)
	for i, w in profile.weapons do
		if w.id == id then
			if w.part then
				ctx.DataService.Give(player, { [w.part] = 1 })
			end
			ctx.DataService.Give(player, { CopperBar = 1 })
			table.remove(profile.weapons, i)
			if profile.equipped == id then
				profile.equipped = nil
				ctx.PlayerState.AttachWeapon(player)
			end
			ctx.PlayerState.Notify(player, "Eingeschmolzen (+1 Kupferbarren" .. (if w.part then ", Monsterteil zurück" else "") .. ").", "info")
			return
		end
	end
end

handlers.SetPart = function(player, id, part)
	local profile = ctx.DataService.Get(player)
	if part ~= nil and not (type(part) == "string" and Config.Items[part] and Config.Items[part].kind == "Part") then
		return
	end
	for _, w in profile.weapons do
		if w.id == id then
			if part and (profile.stash[part] or 0) < 1 then
				ctx.PlayerState.Notify(player, "Dieses Monsterteil hast du nicht im Lager.", "bad")
				return
			end
			if w.part then
				ctx.DataService.Give(player, { [w.part] = 1 })
			end
			w.part = nil
			if part then
				ctx.DataService.Take(player, { [part] = 1 })
				w.part = part
				ctx.Progress.Milestone(player, "MonsterPart")
			end
			ctx.PlayerState.Notify(player, if part then Config.Items[part].name .. " eingesetzt." else "Monsterteil entfernt.", "info")
			return
		end
	end
end

handlers.SaveBlueprint = function(player, id)
	local profile = ctx.DataService.Get(player)
	if #profile.blueprints >= 12 then
		ctx.PlayerState.Notify(player, "Maximal 12 Baupläne.", "bad")
		return
	end
	for _, w in profile.weapons do
		if w.id == id then
			for _, bp in profile.blueprints do
				if bp.form == w.form and bp.e1 == w.e1 and bp.e2 == w.e2 then
					ctx.PlayerState.Notify(player, "Diesen Bauplan hast du schon.", "info")
					return
				end
			end
			table.insert(profile.blueprints, { name = Forge.WeaponName(w), form = w.form, e1 = w.e1, e2 = w.e2 })
			ctx.PlayerState.Notify(player, "Bauplan gespeichert: " .. Forge.WeaponName(w), "good")
		end
	end
end

handlers.DeleteBlueprint = function(player, index)
	local profile = ctx.DataService.Get(player)
	if type(index) == "number" and profile.blueprints[index] then
		table.remove(profile.blueprints, index)
	end
end

handlers.GiveItem = function(player, targetUserId, item)
	local target = type(targetUserId) == "number" and Players:GetPlayerByUserId(targetUserId)
	if not target or target == player or type(item) ~= "string" or not Config.Items[item] then
		return
	end
	if not inCamp(target) then
		ctx.PlayerState.Notify(player, target.DisplayName .. " ist gerade auf Expedition.", "bad")
		return
	end
	if not ctx.DataService.Take(player, { [item] = 1 }) then
		return
	end
	ctx.DataService.Give(target, { [item] = 1 })
	ctx.PlayerState.Notify(player, "1 " .. Config.Items[item].name .. " an " .. target.DisplayName .. " gegeben.", "info")
	ctx.PlayerState.Notify(target, player.DisplayName .. " hat dir 1 " .. Config.Items[item].name .. " gegeben.", "good")
	ctx.PlayerState.Sync(target)
end

handlers.ClaimQuest = function(player, id)
	if type(id) == "string" then
		ctx.Progress.Claim(player, id)
	end
end

-- Aktionen, die auch während einer Expedition erlaubt sind
local ANYWHERE = { ClaimQuest = true }

function Forge.Handle(player: Player, action: string, a: any, b: any)
	local handler = handlers[action]
	if not handler or not ctx.DataService.Get(player) then
		return false
	end
	if not ANYWHERE[action] and not inCamp(player) then
		ctx.PlayerState.Notify(player, "Das geht nur im Camp.", "bad")
		return true
	end
	handler(player, a, b)
	ctx.DataService.MarkDirty(player)
	ctx.PlayerState.Sync(player)
	return true
end

function Forge.Init(context)
	ctx = context
end

function Forge.Start()
	Net.Function("ForgeBegin").OnServerInvoke = function(player, raw)
		if not inCamp(player) then
			return { ok = false, msg = "Schmieden geht nur im Camp." }
		end
		local recipe, _, err = validate(player, raw)
		if not recipe then
			return { ok = false, msg = err }
		end
		local start = workspace:GetServerTimeNow() + 0.6
		sessions[player] = { recipe = recipe, start = start, created = os.clock() }
		return { ok = true, start = start, period = Config.Hardening.Period }
	end
	Net.Function("ForgeFinish").OnServerInvoke = function(player, times)
		local session = sessions[player]
		sessions[player] = nil
		if not session then
			return { ok = false, msg = "Kein Schmiedevorgang aktiv." }
		end
		if os.clock() - session.created > Config.Hardening.Timeout + 5 then
			times = {}
		end
		local list = {}
		if type(times) == "table" then
			for i = 1, Config.Hardening.Strikes do
				if type(times[i]) == "number" then
					table.insert(list, times[i])
				end
			end
		end
		local ok, msg, quality = finish(player, session, list)
		return { ok = ok, msg = msg, quality = quality }
	end
	Players.PlayerRemoving:Connect(function(player)
		sessions[player] = nil
	end)
end

return Forge
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">PlayerState</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Laufzeitzustand der Spieler: Leben, Ausdauer, Elementladung, Rucksack,
-- ausgerüstete Waffe und Synchronisation zum Client.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)

export type State = {
	hp: number,
	stamina: number,
	charge: number,
	lastStaminaUse: number,
	iframesUntil: number,
	lastDodge: number,
	cooldownUntil: number,
	downed: boolean,
	downedAt: number,
	rootedUntil: number,
	stormCharge: number,
	perfectDodgeUntil: number,
	inRun: boolean,
	backpack: { [string]: number },
	protectedLoot: { [string]: number },
}

local PlayerState = {}
local ctx: any

local states: { [Player]: State } = {}
local syncQueued: { [Player]: boolean } = {}

local StateEvent = Net.Event("State")
local NotifyEvent = Net.Event("Notify")

local function newState(): State
	return {
		hp = Config.Player.MaxHP,
		stamina = Config.Player.MaxStamina,
		charge = 0,
		lastStaminaUse = 0,
		iframesUntil = 0,
		lastDodge = 0,
		cooldownUntil = 0,
		downed = false,
		downedAt = 0,
		rootedUntil = 0,
		stormCharge = 0,
		perfectDodgeUntil = 0,
		inRun = false,
		backpack = {},
		protectedLoot = {},
	}
end

function PlayerState.Init(context)
	ctx = context
end

function PlayerState.Get(player: Player): State?
	return states[player]
end

function PlayerState.Notify(player: Player, text: string, kind: string?)
	NotifyEvent:FireClient(player, text, kind or "info")
end

function PlayerState.NotifyAll(players: { Player }, text: string, kind: string?)
	for _, p in players do
		NotifyEvent:FireClient(p, text, kind or "info")
	end
end

function PlayerState.GetRoot(player: Player): BasePart?
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function PlayerState.GetHumanoid(player: Player): Humanoid?
	local char = player.Character
	return char and char:FindFirstChildOfClass("Humanoid")
end

function PlayerState.IsActive(player: Player): boolean
	local s = states[player]
	local hum = PlayerState.GetHumanoid(player)
	return s ~= nil and not s.downed and hum ~= nil and hum.Health > 0
end

--------------------------------------------------------------------------------
-- Waffe
--------------------------------------------------------------------------------
function PlayerState.GetWeapon(player: Player): any?
	local profile = ctx.DataService.Get(player)
	if not profile or not profile.equipped then
		return nil
	end
	for _, w in profile.weapons do
		if w.id == profile.equipped then
			return w
		end
	end
	return nil
end

function PlayerState.WeaponColors(w: any): { Color3 }
	local colors = {}
	if w.e1 then
		table.insert(colors, Config.Elements[w.e1].color)
	end
	if w.e2 then
		table.insert(colors, Config.Elements[w.e2].color)
	end
	if #colors == 0 then
		table.insert(colors, Color3.fromRGB(150, 160, 170))
	end
	return colors
end

function PlayerState.AttachWeapon(player: Player)
	local char = player.Character
	if not char then
		return
	end
	local old = char:FindFirstChild("Weapon")
	if old then
		old:Destroy()
	end
	local w = PlayerState.GetWeapon(player)
	if not w then
		return
	end
	local hand = (char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")) :: BasePart?
	if not hand then
		return
	end
	local model = ctx.AssetLoader.Weapon(w.form, PlayerState.WeaponColors(w), w.quality)
	local handle = model.PrimaryPart :: BasePart
	local weld = Instance.new("Weld")
	weld.Part0 = hand
	weld.Part1 = handle
	local down = if hand.Name == "RightHand" then -0.15 else -0.9
	weld.C0 = CFrame.new(0, down, 0) * CFrame.Angles(math.rad(-90), 0, 0)
	weld.Parent = handle
	model:SetAttribute("Form", w.form)
	model.Parent = char
end

--------------------------------------------------------------------------------
-- Synchronisation
--------------------------------------------------------------------------------
function PlayerState.Sync(player: Player)
	if syncQueued[player] then
		return
	end
	syncQueued[player] = true
	task.defer(function()
		syncQueued[player] = nil
		local profile = ctx.DataService.Get(player)
		local s = states[player]
		if not profile or not s or player.Parent ~= Players then
			return
		end
		StateEvent:FireClient(player, {
			stash = profile.stash,
			weapons = profile.weapons,
			equipped = profile.equipped,
			unlocked = profile.unlocked,
			blueprints = profile.blueprints,
			milestones = profile.milestones,
			quests = profile.quests,
			backpack = s.backpack,
			protectedLoot = s.protectedLoot,
			inRun = s.inRun,
			expedition = ctx.Expedition.PublicInfo(),
		})
	end)
end

function PlayerState.SyncAll()
	for player in states do
		PlayerState.Sync(player)
	end
end

--------------------------------------------------------------------------------
-- Leben, Schaden, Niederschlag
--------------------------------------------------------------------------------
local function applyAttributes(player: Player, s: State)
	player:SetAttribute("HP", math.floor(s.hp + 0.5))
	player:SetAttribute("MaxHP", Config.Player.MaxHP)
	player:SetAttribute("Stamina", math.floor(s.stamina))
	player:SetAttribute("Charge", math.floor(s.charge))
	player:SetAttribute("Downed", s.downed)
	player:SetAttribute("InRun", s.inRun)
	player:SetAttribute(
		"HasElement",
		(function()
			local w = PlayerState.GetWeapon(player)
			return w ~= nil and w.e1 ~= nil
		end)()
	)
end

local function updateMovement(player: Player, s: State)
	local hum = PlayerState.GetHumanoid(player)
	if not hum then
		return
	end
	local speed = Config.Player.WalkSpeed
	if s.downed then
		speed = 4
	elseif s.rootedUntil > os.clock() then
		speed = 0
	end
	hum.WalkSpeed = speed
	hum.JumpPower = if s.downed or s.rootedUntil > os.clock() then 0 else 50
	hum.UseJumpPower = true
end

-- Liefert true, wenn der Schaden wirklich getroffen hat.
function PlayerState.Damage(player: Player, amount: number, _source: string?): boolean
	local s = states[player]
	if not s or s.downed or not s.inRun then
		return false
	end
	local now = os.clock()
	if s.iframesUntil > now then
		-- Perfektes Ausweichen
		s.perfectDodgeUntil = now + 2
		Net.Event("Fx"):FireAllClients("PerfectDodge", player)
		return false
	end
	s.hp = math.max(0, s.hp - amount)
	local hum = PlayerState.GetHumanoid(player)
	if hum then
		hum.Health = math.max(1, (s.hp / Config.Player.MaxHP) * hum.MaxHealth)
	end
	Net.Event("Fx"):FireAllClients("PlayerHit", player, amount)
	if s.hp <= 0 then
		s.downed = true
		s.downedAt = now
		s.charge = 0
		ctx.Expedition.OnPlayerDowned(player)
	end
	applyAttributes(player, s)
	updateMovement(player, s)
	return true
end

function PlayerState.Heal(player: Player, fraction: number)
	local s = states[player]
	if not s then
		return
	end
	s.hp = math.min(Config.Player.MaxHP, s.hp + Config.Player.MaxHP * fraction)
	local hum = PlayerState.GetHumanoid(player)
	if hum then
		hum.Health = math.max(1, (s.hp / Config.Player.MaxHP) * hum.MaxHealth)
	end
	applyAttributes(player, s)
end

function PlayerState.Revive(player: Player, fraction: number)
	local s = states[player]
	if not s then
		return
	end
	s.downed = false
	s.hp = 0
	PlayerState.Heal(player, fraction)
	updateMovement(player, s)
	applyAttributes(player, s)
end

function PlayerState.ResetVitals(player: Player)
	local s = states[player]
	if not s then
		return
	end
	s.downed = false
	s.hp = Config.Player.MaxHP
	s.stamina = Config.Player.MaxStamina
	s.rootedUntil = 0
	s.stormCharge = 0
	local hum = PlayerState.GetHumanoid(player)
	if hum then
		hum.Health = hum.MaxHealth
	end
	updateMovement(player, s)
	applyAttributes(player, s)
end

function PlayerState.Root(player: Player, duration: number)
	local s = states[player]
	if not s then
		return
	end
	s.rootedUntil = os.clock() + duration
	updateMovement(player, s)
	task.delay(duration + 0.05, function()
		if states[player] == s then
			updateMovement(player, s)
		end
	end)
end

function PlayerState.UseStamina(player: Player, amount: number): boolean
	local s = states[player]
	if not s or s.stamina < amount then
		return false
	end
	s.stamina -= amount
	s.lastStaminaUse = os.clock()
	return true
end

function PlayerState.AddCharge(player: Player, amount: number)
	local s = states[player]
	local w = PlayerState.GetWeapon(player)
	if not s or not w or not w.e1 then
		return
	end
	local mult = Config.Forms[w.form].chargeMult
	s.charge = math.min(100, s.charge + amount * mult)
end

--------------------------------------------------------------------------------
-- Rucksack (ungesicherte Expeditionsbeute)
--------------------------------------------------------------------------------
function PlayerState.AddLoot(player: Player, items: { [string]: number }, protected: boolean?)
	local s = states[player]
	if not s then
		return
	end
	local bag = if protected then s.protectedLoot else s.backpack
	local parts = {}
	for item, n in items do
		if n > 0 and Config.Items[item] then
			bag[item] = (bag[item] or 0) + n
			table.insert(parts, "+" .. n .. " " .. Config.Items[item].name)
		end
	end
	if #parts > 0 then
		PlayerState.Notify(player, table.concat(parts, "   "), if protected then "loot_protected" else "loot")
	end
	PlayerState.Sync(player)
end

-- Verschiebt den Rucksack ins dauerhafte Lager.
function PlayerState.SecureLoot(player: Player): boolean
	local s = states[player]
	if not s then
		return false
	end
	local any = next(s.backpack) ~= nil or next(s.protectedLoot) ~= nil
	ctx.DataService.Give(player, s.backpack)
	ctx.DataService.Give(player, s.protectedLoot)
	if (s.backpack.PartStalkerBark or 0) > 0 or (s.protectedLoot.PartStalkerBark or 0) > 0 then
		ctx.Progress.CompleteQuest(player, "Hunter")
	end
	local hasCore = false
	for _, e in Config.Elements do
		if (s.backpack[e.core] or 0) > 0 or (s.protectedLoot[e.core] or 0) > 0 then
			hasCore = true
		end
	end
	if hasCore then
		ctx.Progress.Milestone(player, "FirstCore")
	end
	s.backpack = {}
	s.protectedLoot = {}
	if any then
		PlayerState.Notify(player, "Beute gesichert!", "good")
	end
	PlayerState.Sync(player)
	return any
end

-- Verlust bei Niederlage: ein Teil der ungesicherten Grundmaterialien geht verloren.
function PlayerState.LoseLoot(player: Player, fraction: number)
	local s = states[player]
	if not s then
		return
	end
	local lost = 0
	for item, n in s.backpack do
		if Config.Items[item].kind == "Basic" then
			local loss = math.floor(n * fraction + 0.5)
			s.backpack[item] = n - loss
			lost += loss
			if s.backpack[item] <= 0 then
				s.backpack[item] = nil
			end
		end
	end
	if lost > 0 then
		PlayerState.Notify(player, lost .. " Grundmaterialien verloren. Kerne, Monsterteile und Bossbeute bleiben erhalten.", "bad")
	end
	PlayerState.Sync(player)
end

--------------------------------------------------------------------------------
-- Lebenszyklus
--------------------------------------------------------------------------------
local function onCharacter(player: Player, char: Model)
	local s = states[player]
	if not s then
		return
	end
	local hum = char:WaitForChild("Humanoid", 10) :: Humanoid?
	if not hum then
		return
	end
	s.inRun = false
	s.charge = 0
	PlayerState.ResetVitals(player)
	hum.BreakJointsOnDeath = false
	hum.Died:Connect(function()
		if states[player] == s and s.inRun then
			ctx.Expedition.OnPlayerOut(player, "fall")
		end
	end)
	task.defer(PlayerState.AttachWeapon, player)
	task.defer(ctx.Expedition.TryRestore, player)
	PlayerState.Sync(player)
end

function PlayerState.OnProfileLoaded(player: Player)
	states[player] = newState()
	player.CharacterAdded:Connect(function(char)
		onCharacter(player, char)
	end)
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end
	ctx.Progress.OnLoaded(player)
	PlayerState.Sync(player)
end

function PlayerState.Start()
	Players.PlayerRemoving:Connect(function(player)
		local s = states[player]
		if s and s.inRun then
			ctx.Expedition.OnPlayerLeft(player, s)
		end
		states[player] = nil
	end)

	local accum = 0
	RunService.Heartbeat:Connect(function(dt)
		local now = os.clock()
		for player, s in states do
			if not s.downed and now - s.lastStaminaUse > Config.Player.StaminaDelay then
				s.stamina = math.min(Config.Player.MaxStamina, s.stamina + Config.Player.StaminaRegen * dt)
			end
		end
		accum += dt
		if accum >= 0.1 then
			accum = 0
			for player, s in states do
				applyAttributes(player, s)
				if s.rootedUntil > 0 and s.rootedUntil < now then
					s.rootedUntil = 0
					updateMovement(player, s)
				end
			end
		end
	end)
end

return PlayerState
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Progress</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Meilensteine und Aufgaben.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local Progress = {}
local ctx: any

function Progress.Init(context)
	ctx = context
end

function Progress.OnLoaded(player: Player)
	local profile = ctx.DataService.Get(player)
	if not profile then
		return
	end
	for _, q in Config.Quests do
		if not profile.quests[q.id] then
			profile.quests[q.id] = "open"
		end
	end
end

function Progress.Milestone(player: Player, id: string)
	local profile = ctx.DataService.Get(player)
	if not profile or profile.milestones[id] then
		return
	end
	profile.milestones[id] = true
	ctx.DataService.MarkDirty(player)
	for _, m in Config.Milestones do
		if m.id == id then
			ctx.PlayerState.Notify(player, "Meilenstein: " .. m.text, "milestone")
		end
	end
	ctx.PlayerState.Sync(player)
end

function Progress.CompleteQuest(player: Player, id: string)
	local profile = ctx.DataService.Get(player)
	if not profile or profile.quests[id] ~= "open" then
		return
	end
	profile.quests[id] = "done"
	ctx.DataService.MarkDirty(player)
	for _, q in Config.Quests do
		if q.id == id then
			ctx.PlayerState.Notify(player, "Aufgabe erfüllt: " .. q.title .. " – Belohnung im Aufgabenmenü abholen (J).", "milestone")
		end
	end
	ctx.PlayerState.Sync(player)
end

function Progress.Claim(player: Player, id: string)
	local profile = ctx.DataService.Get(player)
	if not profile or profile.quests[id] ~= "done" then
		return
	end
	for _, q in Config.Quests do
		if q.id == id then
			profile.quests[id] = "claimed"
			ctx.DataService.Give(player, q.reward)
			ctx.PlayerState.Notify(player, "Belohnung erhalten: " .. q.title, "good")
		end
	end
	ctx.PlayerState.Sync(player)
end

return Progress
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">WorldBuilder</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Baut beim Serverstart die Welt: das Rift Camp und das Expeditionsgebiet
-- "Verdant Scar" (Außenposten, Ruinen, Kupfermine mit zwei Routen, Rift-Kammer).
-- Eigene Deko kannst du in Studio einfach dazubauen; Stationen und Spawnpunkte
-- kommen aus diesem Skript.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)

local WorldBuilder = {}
local ctx: any

local world: Model
local terrain = workspace.Terrain

--------------------------------------------------------------------------------
-- Wichtige Punkte (werden von Expedition genutzt)
--------------------------------------------------------------------------------
local V = Vector3.new
WorldBuilder.Points = {
	CampSpawn = V(0, 0, 26),
	CampArrival = V(0, 0, -26),
	ZoneArrival = V(0, 0, -590),
	OutpostPortal = V(-22, 0, -592),
	RiftSeal = V(78, 0, -740),
	Shrine = V(108, 0, -740),
	FrostSeal = V(70, 0, -910),
	Cache = V(108, 0, -910),
	ArenaCenter = V(0, 0, -1050),
	ArenaPortal = V(0, 0, -1094),
}

-- Kandidaten für zufällige Platzierung pro Lauf
WorldBuilder.Spawns = {
	Outpost = {
		enemies = { { "Riftling", V(-10, 0, -650) }, { "Riftling", V(12, 0, -655) }, { "Riftling", V(0, 0, -668) }, { "Riftling", V(-22, 0, -662) } },
		enemyCount = 3,
		nodes = { V(25, 0, -600), V(-35, 0, -625), V(30, 0, -640), V(-32, 0, -590), V(12, 0, -662) },
		nodeKinds = { "Copper_Deposit", "Stone_Deposit", "Timber_Pile" },
		nodeCount = 3,
	},
	Ruins = {
		enemies = {
			{ "Riftling", V(-30, 0, -715) },
			{ "Riftling", V(-24, 0, -722) },
			{ "Riftling", V(30, 0, -745) },
			{ "Riftling", V(38, 0, -752) },
			{ "Rootstalker", V(-45, 0, -770) },
			{ "Rootstalker", V(20, 0, -792) },
			{ "Rift_Crawler", V(0, 0, -805) },
			{ "Rift_Crawler", V(-50, 0, -740) },
		},
		enemyCount = 6,
		nodes = { V(-55, 0, -700), V(50, 0, -705), V(-62, 0, -760), V(55, 0, -780), V(-10, 0, -742), V(15, 0, -815), V(-40, 0, -812) },
		nodeKinds = { "Copper_Deposit", "Stone_Deposit", "Timber_Pile", "Rift_Deposit" },
		nodeCount = 4,
		chests = { V(-58, 0, -730), V(45, 0, -725), V(-22, 0, -800), V(52, 0, -810) },
		chestCount = 2,
		mimicChance = 0.25,
	},
	SafeMine = {
		enemies = { { "Riftling", V(-40, 0, -870) }, { "Riftling", V(-30, 0, -930) }, { "Rootstalker", V(-45, 0, -955) }, { "Riftling", V(-26, 0, -890) } },
		enemyCount = 3,
		nodes = { V(-50, 0, -850), V(-26, 0, -870), V(-52, 0, -895), V(-22, 0, -912), V(-50, 0, -935), V(-24, 0, -955), V(-50, 0, -975) },
		nodeKinds = { "Copper_Deposit", "Copper_Deposit", "Stone_Deposit", "Copper_Deposit", "Stone_Deposit", "Timber_Pile" },
		nodeCount = 5,
	},
	RiskyMine = {
		enemies = {
			{ "Lantern_Wraith", V(35, 0, -880) },
			{ "Lantern_Wraith", V(45, 0, -948) },
			{ "Rift_Crawler", V(25, 0, -900) },
			{ "Rift_Crawler", V(42, 0, -918) },
			{ "Riftling", V(30, 0, -962) },
			{ "Rootstalker", V(48, 0, -860) },
		},
		enemyCount = 5,
		hpMult = 1.25,
		nodes = { V(25, 0, -850), V(52, 0, -872), V(22, 0, -932), V(52, 0, -902), V(50, 0, -968) },
		nodeKinds = { "Rift_Deposit", "Rift_Deposit", "Copper_Deposit" },
		nodeCount = 3,
		chests = { V(50, 0, -855), V(24, 0, -975), V(52, 0, -932) },
		chestCount = 2,
		mimicCount = 1,
		rare = true,
	},
}

--------------------------------------------------------------------------------
-- Hilfen
--------------------------------------------------------------------------------
local function fill(center: Vector3, size: Vector3, material: Enum.Material)
	terrain:FillBlock(CFrame.new(center), size, material)
end

local function place(name: string, pos: Vector3, yaw: number?, height: number?, parent: Instance?): Model
	return ctx.AssetLoader.Place(name, CFrame.new(pos) * CFrame.Angles(0, math.rad(yaw or 0), 0), parent or world, height)
end

local function part(size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, parent: Instance?): Part
	local p = Instance.new("Part")
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent or world
	return p
end

local function label(model: Model, text: string, height: number, color: Color3?)
	local _, size = model:GetBoundingBox()
	local anchor = Instance.new("Part")
	anchor.Name = "LabelAnchor"
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.Transparency = 1
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CFrame = model:GetPivot() + Vector3.new(0, math.max(size.Y, height), 0)
	anchor.Parent = model
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(200, 34)
	gui.StudsOffset = Vector3.new(0, 1.5, 0)
	gui.MaxDistance = 70
	gui.Parent = anchor
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Text = text
	t.TextColor3 = color or Color3.fromRGB(235, 240, 245)
	t.TextStrokeTransparency = 0.3
	t.Font = Enum.Font.GothamBlack
	t.TextSize = 18
	t.Parent = gui
end

function WorldBuilder.Prompt(parentPart: BasePart, action: string, object: string, hold: number?, key: Enum.KeyCode?): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = action
	prompt.ObjectText = object
	prompt.HoldDuration = hold or 0
	prompt.MaxActivationDistance = 11
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = key or Enum.KeyCode.E
	if key and key ~= Enum.KeyCode.E then
		-- zweite Aktion am selben Objekt: eigene Controller-Taste
		prompt.GamepadKeyCode = Enum.KeyCode.DPadUp
	end
	prompt.Parent = parentPart
	return prompt
end

local function promptAnchor(model: Model, offsetY: number?): Part
	local cf, size = model:GetBoundingBox()
	local anchor = Instance.new("Part")
	anchor.Name = "PromptAnchor"
	anchor.Size = Vector3.new(1, 1, 1)
	anchor.Transparency = 1
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CFrame = CFrame.new(cf.Position.X, model:GetPivot().Y + (offsetY or math.min(size.Y * 0.5, 3)), cf.Position.Z)
	anchor.Parent = model
	return anchor
end
WorldBuilder.PromptAnchor = promptAnchor

local function station(name: string, asset: string, pos: Vector3, yaw: number, title: string, ui: string)
	local m = place(asset, pos, yaw)
	label(m, title, 5, Color3.fromRGB(63, 224, 197))
	local prompt = WorldBuilder.Prompt(promptAnchor(m), "Öffnen", title)
	prompt.Triggered:Connect(function(player)
		Net.Event("OpenUI"):FireClient(player, ui)
	end)
	m:SetAttribute("Station", name)
	return m
end

local function scatter(name: string, center: Vector3, radius: number, count: number, seed: number, minRadius: number?)
	local rng = Random.new(seed)
	for _ = 1, count do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(minRadius or 0, radius)
		local h = ctx.AssetLoader.Heights[name] * rng:NextNumber(0.8, 1.25)
		place(name, center + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r), rng:NextNumber(0, 360), h)
	end
end

--------------------------------------------------------------------------------
-- Camp
--------------------------------------------------------------------------------
local function buildCamp()
	fill(V(0, -6, 0), V(260, 12, 260), Enum.Material.Grass)
	fill(V(0, -0.5, -8), V(12, 1, 60), Enum.Material.Ground)
	fill(V(0, -0.5, 30), V(40, 1, 12), Enum.Material.Ground)
	-- Hügel rundherum
	local rng = Random.new(4)
	for i = 0, 23 do
		local a = i / 24 * math.pi * 2
		local r = 118 + rng:NextNumber(-6, 6)
		terrain:FillBall(V(math.cos(a) * r, 0, math.sin(a) * r), rng:NextNumber(16, 26), Enum.Material.Rock)
	end
	scatter("Tree", V(0, 0, 0), 100, 36, 21, 70)
	scatter("Rock", V(0, 0, 0), 95, 10, 22, 65)

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "CampSpawn"
	spawn.Size = V(10, 1, 10)
	spawn.CFrame = CFrame.new(WorldBuilder.Points.CampSpawn + V(0, 0.5, 0))
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Material = Enum.Material.Slate
	spawn.Color = Color3.fromRGB(70, 78, 88)
	spawn.Parent = world

	station("Forge", "Workbench", V(-26, 0, -6), 90, "Schmiede", "Forge")
	station("Furnace", "Smelting_Furnace", V(-42, 0, 16), 60, "Schmelzofen", "Furnace")
	station("Research", "Research_Table", V(26, 0, -6), -90, "Forschungstisch", "Research")
	station("Chest", "Storage_Chest", V(42, 0, 16), -60, "Lagerkiste", "Chest")
	station("Board", "Expedition_Board", V(0, 0, -36), 180, "Expeditionstafel", "Board")
	local gate = place("Return_Portal", V(0, 0, -52), 0)
	label(gate, "Rift-Tor → Verdant Scar", 11, Color3.fromRGB(63, 224, 197))

	place("Campfire", V(0, 0, 6))
	place("Tent", V(-24, 0, 38), 30)
	place("Tent", V(24, 0, 40), -30)
	place("Timber_Pile", V(-34, 0, 30), 20)
	for _, p in { V(-14, 0, -20), V(14, 0, -20), V(-34, 0, 2), V(34, 0, 2), V(-12, 0, 44), V(12, 0, 44) } do
		place("Lantern", p)
	end

	-- Trainingsplatz
	local yard = V(0, 0, 62)
	fill(yard - V(0, 0.5, 0), V(44, 1, 26), Enum.Material.Sand)
	for x = -22, 22, 4 do
		part(V(0.5, 3, 0.5), CFrame.new(yard + V(x, 1.5, 13)), Color3.fromRGB(95, 66, 44), Enum.Material.Wood)
	end
	part(V(44, 0.4, 0.3), CFrame.new(yard + V(0, 2.6, 13)), Color3.fromRGB(125, 82, 50), Enum.Material.Wood)
	local sign = Instance.new("Model")
	sign.Name = "TrainingSign"
	sign.WorldPivot = CFrame.new(yard + V(0, 0, -12))
	sign.Parent = world
	label(sign, "Trainingsplatz", 4, Color3.fromRGB(240, 200, 80))
	for i, x in { -12, 0, 12 } do
		local dummy = place("Training_Dummy", yard + V(x, 0, if i == 2 then 4 else 0), 180)
		ctx.Entities.RegisterStatic(dummy, { kind = "Dummy", name = "Übungspuppe", hp = 500, dummy = true, barHeight = 7 })
	end
end

--------------------------------------------------------------------------------
-- Verdant Scar
--------------------------------------------------------------------------------
local function mineGate(xMin: number, xMax: number, z: number)
	local wood = Color3.fromRGB(80, 52, 34)
	part(V(1.4, 14, 1.4), CFrame.new(xMin + 1, 7, z), wood, Enum.Material.Wood)
	part(V(1.4, 14, 1.4), CFrame.new(xMax - 1, 7, z), wood, Enum.Material.Wood)
	part(V(xMax - xMin, 1.4, 1.6), CFrame.new((xMin + xMax) / 2, 14.2, z), Color3.fromRGB(125, 82, 50), Enum.Material.Wood)
	local lamp = part(V(0.8, 1, 0.8), CFrame.new((xMin + xMax) / 2, 13, z), Color3.fromRGB(255, 150, 60), Enum.Material.Neon)
	local l = Instance.new("PointLight")
	l.Color = lamp.Color
	l.Range = 24
	l.Brightness = 2
	l.Parent = lamp
end

local function sign(pos: Vector3, text: string, color: Color3)
	part(V(0.5, 5, 0.5), CFrame.new(pos + V(0, 2.5, 0)), Color3.fromRGB(80, 52, 34), Enum.Material.Wood)
	local board = part(V(6, 2, 0.3), CFrame.new(pos + V(0, 4.6, 0)), Color3.fromRGB(168, 112, 66), Enum.Material.WoodPlanks)
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.CanvasSize = Vector2.new(300, 100)
		gui.Parent = board
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundTransparency = 1
		t.Text = text
		t.TextColor3 = color
		t.Font = Enum.Font.GothamBlack
		t.TextScaled = true
		t.Parent = gui
	end
end

local function buildZone()
	-- Grundfläche und Begrenzung
	fill(V(0, -6, -850), V(280, 12, 640), Enum.Material.Grass)
	fill(V(-148, 18, -850), V(24, 48, 640), Enum.Material.Rock)
	fill(V(148, 18, -850), V(24, 48, 640), Enum.Material.Rock)
	fill(V(0, 18, -540), V(300, 48, 20), Enum.Material.Rock)
	fill(V(0, 18, -1160), V(300, 48, 20), Enum.Material.Rock)
	-- Wege
	fill(V(0, -0.5, -700), V(16, 1, 260), Enum.Material.Ground)

	-- 1. Verlassener Außenposten
	local outpost = V(0, 0, -612)
	for i = 0, 27 do
		local a = i / 28 * math.pi * 2
		local open = (a > math.rad(80) and a < math.rad(100)) or (a > math.rad(260) and a < math.rad(280))
		if not open then
			local h = 7 + (i % 3)
			part(
				V(1.6, h, 1.6),
				CFrame.new(outpost + V(math.cos(a) * 36, h / 2, math.sin(a) * 36)) * CFrame.Angles(0, -a, math.rad(4)),
				Color3.fromRGB(95, 66, 44),
				Enum.Material.Wood
			)
		end
	end
	place("Tent", outpost + V(-20, 0, -8), 70)
	place("Tent", outpost + V(20, 0, -12), -80)
	place("Campfire", outpost + V(0, 0, 4))
	place("Lantern", outpost + V(-8, 0, 30))
	place("Lantern", outpost + V(8, 0, 30))
	sign(outpost + V(6, 0, 34), "Außenposten", Color3.fromRGB(40, 25, 15))

	-- 2. Überwucherte Ruinen
	local rng = Random.new(77)
	for _, p in { V(-40, 0, -700), V(40, 0, -698), V(-48, 0, -748), V(46, 0, -770), V(-30, 0, -790), V(26, 0, -812), V(-60, 0, -805), V(60, 0, -735) } do
		place("Ruin_Pillar", p, rng:NextNumber(0, 360), rng:NextNumber(8, 14))
	end
	for _, p in { V(-20, 0, -732), V(28, 0, -720), V(-66, 0, -780), V(8, 0, -782) } do
		place("Ruin_Wall", p, rng:NextNumber(0, 360))
	end
	scatter("Tree", V(0, 0, -750), 110, 22, 31, 60)
	scatter("Rock", V(0, 0, -750), 100, 10, 32, 30)

	-- Schrein hinter der Rift-Barriere
	fill(V(100, 18, -740), V(60, 48, 76), Enum.Material.Rock)
	fill(V(104, 9, -740), V(30, 18, 40), Enum.Material.Air)
	fill(V(79, 8, -740), V(22, 16, 16), Enum.Material.Air)
	fill(V(104, -0.5, -740), V(30, 1, 40), Enum.Material.Slate)
	local altarBase = part(V(4, 2, 4), CFrame.new(WorldBuilder.Points.Shrine + V(0, 1, 0)), Color3.fromRGB(62, 70, 80), Enum.Material.Slate)
	altarBase.Name = "ShrineAltar"
	for i = 0, 3 do
		local a = i * math.pi / 2
		local c = part(
			V(1, 5, 1),
			CFrame.new(WorldBuilder.Points.Shrine + V(math.cos(a) * 8, 2.5, math.sin(a) * 8)) * CFrame.Angles(0, a, math.rad(10)),
			Color3.fromRGB(63, 224, 197),
			Enum.Material.Neon
		)
		local l = Instance.new("PointLight")
		l.Color = c.Color
		l.Range = 14
		l.Parent = c
	end

	-- 3. Gabelung und Kupfermine
	sign(V(-30, 0, -826), "← Sicherer Pfad", Color3.fromRGB(40, 90, 40))
	sign(V(30, 0, -826), "Riskanter Pfad →", Color3.fromRGB(140, 30, 20))
	fill(V(-101, 18, -910), V(82, 48, 160), Enum.Material.Rock)
	fill(V(101, 18, -910), V(82, 48, 160), Enum.Material.Rock)
	fill(V(0, 18, -906), V(30, 48, 132), Enum.Material.Slate)
	fill(V(-38, -0.5, -910), V(46, 1, 160), Enum.Material.Slate)
	fill(V(38, -0.5, -910), V(46, 1, 160), Enum.Material.Slate)
	for z = -845, -985, -35 do
		mineGate(-60, -15, z)
		mineGate(15, 60, z)
	end
	-- Versteck hinter dem Frostsiegel
	fill(V(104, 9, -910), V(30, 18, 34), Enum.Material.Air)
	fill(V(76, 8, -910), V(30, 16, 14), Enum.Material.Air)
	fill(V(104, -0.5, -910), V(30, 1, 34), Enum.Material.Glacier)

	-- 4. Rift-Kammer
	local arena = WorldBuilder.Points.ArenaCenter
	fill(V(0, 18, -1075), V(300, 48, 150), Enum.Material.Rock)
	terrain:FillCylinder(CFrame.new(arena + V(0, 12, 0)), 24, 50, Enum.Material.Air)
	terrain:FillCylinder(CFrame.new(arena + V(0, -1, 0)), 2, 50, Enum.Material.Slate)
	fill(V(0, 10, -998), V(26, 20, 16), Enum.Material.Air)
	for i = 0, 11 do
		local a = i / 12 * math.pi * 2
		local deg = math.deg(a)
		if math.abs(deg - 90) > 20 and math.abs(deg - 270) > 20 then
			local c = part(
				V(2, 9, 2),
				CFrame.new(arena + V(math.cos(a) * 47, 4, math.sin(a) * 47)) * CFrame.Angles(math.rad(10), a, math.rad(-8)),
				Color3.fromRGB(63, 224, 197),
				Enum.Material.Neon
			)
			local l = Instance.new("PointLight")
			l.Color = c.Color
			l.Range = 20
			l.Parent = c
		end
	end
	sign(V(14, 0, -990), "Rift-Kammer", Color3.fromRGB(63, 224, 197))
end

--------------------------------------------------------------------------------
-- Licht
--------------------------------------------------------------------------------
local function setupLighting()
	Lighting.ClockTime = 16.8
	Lighting.Brightness = 2.2
	Lighting.Ambient = Color3.fromRGB(70, 80, 90)
	Lighting.OutdoorAmbient = Color3.fromRGB(120, 130, 140)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.4
	if not Lighting:FindFirstChildOfClass("Atmosphere") then
		local atm = Instance.new("Atmosphere")
		atm.Density = 0.32
		atm.Offset = 0.1
		atm.Color = Color3.fromRGB(190, 215, 220)
		atm.Decay = Color3.fromRGB(90, 120, 130)
		atm.Glare = 0.2
		atm.Haze = 1.4
		atm.Parent = Lighting
	end
	if not Lighting:FindFirstChildOfClass("BloomEffect") then
		local bloom = Instance.new("BloomEffect")
		bloom.Intensity = 0.6
		bloom.Size = 20
		bloom.Threshold = 1.6
		bloom.Parent = Lighting
	end
	if not Lighting:FindFirstChildOfClass("ColorCorrectionEffect") then
		local cc = Instance.new("ColorCorrectionEffect")
		cc.Saturation = 0.08
		cc.Contrast = 0.06
		cc.Parent = Lighting
	end
end

function WorldBuilder.Init(context)
	ctx = context
end

function WorldBuilder.Start()
	setupLighting()
	local old = workspace:FindFirstChild("RiftboundWorld")
	if old then
		old:Destroy()
	end
	world = Instance.new("Model")
	world.Name = "RiftboundWorld"
	world.Parent = workspace
	buildCamp()
	buildZone()
end

function WorldBuilder.Place(name: string, pos: Vector3, yaw: number?, height: number?, parent: Instance?): Model
	return place(name, pos, yaw, height, parent)
end

return WorldBuilder
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="18">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterCharacterScripts" referent="19">
      <Properties>
        <string name="Name">StarterCharacterScripts</string>
      </Properties>
      <Item class="Script" referent="20">
        <Properties>
          <string name="Name">Health</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Ersetzt das Standard-Regenerationsskript von Roblox.
-- Leben wird ausschließlich vom Server (PlayerState) verwaltet.
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="StarterPlayerScripts" referent="21">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="22">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Fx</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Rein visuelle Effekte (lokal): Schwünge, Schadenszahlen, Elementeffekte, Boss.

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)

local player = Players.LocalPlayer

local Fx = {}

local folder = Instance.new("Folder")
folder.Name = "ClientFx"
folder.Parent = workspace

local flash: (Color3) -> () = function() end

local function part(size: Vector3, cf: CFrame, color: Color3, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = Enum.Material.Neon
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	if shape then
		p.Shape = shape
	end
	p.Parent = folder
	return p
end

local function fade(p: BasePart, t: number, props: { [string]: any }?)
	local goal: { [string]: any } = { Transparency = 1 }
	if props then
		for k, v in props do
			goal[k] = v
		end
	end
	TweenService:Create(p, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal):Play()
	Debris:AddItem(p, t + 0.05)
end

local function ring(pos: Vector3, radius: number, color: Color3, t: number?)
	local p = part(Vector3.new(0.3, 1, 1), CFrame.new(pos + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90)), color, Enum.PartType.Cylinder)
	p.Transparency = 0.2
	fade(p, t or 0.45, { Size = Vector3.new(0.3, radius * 2, radius * 2) })
end

local function sphere(pos: Vector3, radius: number, color: Color3, t: number?)
	local p = part(Vector3.new(1, 1, 1), CFrame.new(pos), color, Enum.PartType.Ball)
	p.Transparency = 0.3
	p.Material = Enum.Material.ForceField
	fade(p, t or 0.4, { Size = Vector3.one * radius * 2 })
end

local function burst(pos: Vector3, color: Color3, count: number, speed: number)
	for _ = 1, count do
		local dir = Vector3.new(math.random() - 0.5, math.random() * 0.8, math.random() - 0.5).Unit
		local p = part(Vector3.one * (0.3 + math.random() * 0.4), CFrame.new(pos) * CFrame.Angles(math.random() * 6, math.random() * 6, 0), color)
		fade(p, 0.5, { CFrame = CFrame.new(pos + dir * speed) * CFrame.Angles(math.random() * 6, math.random() * 6, 0) })
	end
end

local function shake(intensity: number, duration: number)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	local h = hum :: Humanoid
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 < duration do
			local k = intensity * (1 - (os.clock() - t0) / duration)
			h.CameraOffset = Vector3.new((math.random() - 0.5) * k, (math.random() - 0.5) * k, 0)
			task.wait()
		end
		h.CameraOffset = Vector3.zero
	end)
end

local function nearMe(pos: Vector3, range: number): boolean
	local char = player.Character
	local r = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	return r ~= nil and (r.Position - pos).Magnitude < range
end

local function floatText(pos: Vector3, text: string, color: Color3, size: number?)
	local anchor = part(Vector3.new(0.1, 0.1, 0.1), CFrame.new(pos), color)
	anchor.Transparency = 1
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(120, 40)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 120
	gui.Parent = anchor
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = UDim2.fromScale(1, 1)
	l.Text = text
	l.TextColor3 = color
	l.TextStrokeTransparency = 0.2
	l.Font = Enum.Font.GothamBlack
	l.TextSize = size or 22
	l.Parent = gui
	local offset = Vector3.new((math.random() - 0.5) * 2, 0, 0)
	TweenService:Create(gui, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { StudsOffsetWorldSpace = Vector3.new(0, 3, 0) + offset })
		:Play()
	TweenService:Create(l, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(anchor, 0.9)
end

local function lightning(a: Vector3, b: Vector3, color: Color3)
	local segments = 6
	local prev = a
	for i = 1, segments do
		local t = i / segments
		local target = a:Lerp(b, t)
		if i < segments then
			target += Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 2.4
		end
		local len = (target - prev).Magnitude
		local p = part(Vector3.new(0.25, 0.25, len), CFrame.lookAt((prev + target) / 2, target), color)
		fade(p, 0.3)
		prev = target
	end
end

--------------------------------------------------------------------------------
-- Schwung-Animation über die Schulter (funktioniert ohne Animations-Assets)
--------------------------------------------------------------------------------
local originals: { [Motor6D]: CFrame } = setmetatable({}, { __mode = "k" }) :: any

local function shoulder(char: Model): Motor6D?
	local upper = char:FindFirstChild("RightUpperArm")
	if upper then
		return upper:FindFirstChild("RightShoulder") :: Motor6D?
	end
	local torso = char:FindFirstChild("Torso")
	return torso and torso:FindFirstChild("Right Shoulder") :: Motor6D?
end

local function swingAnim(char: Model, heavy: boolean)
	local m = shoulder(char)
	if not m then
		return
	end
	local motor = m :: Motor6D
	local base = originals[motor]
	if not base then
		base = motor.C0
		originals[motor] = base
	end
	local r15 = motor.Name == "RightShoulder"
	local raise = if r15 then CFrame.Angles(math.rad(150), 0, math.rad(-20)) else CFrame.Angles(0, 0, math.rad(150))
	local strike = if r15 then CFrame.Angles(math.rad(-30), 0, math.rad(20)) else CFrame.Angles(0, 0, math.rad(-20))
	local up = if heavy then 0.18 else 0.08
	local down = if heavy then 0.14 else 0.1
	TweenService:Create(motor, TweenInfo.new(up, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { C0 = base * raise }):Play()
	task.delay(up, function()
		TweenService:Create(motor, TweenInfo.new(down, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { C0 = base * strike }):Play()
		task.delay(down + 0.08, function()
			TweenService:Create(motor, TweenInfo.new(0.2), { C0 = base }):Play()
		end)
	end)
end

local function slashArc(char: Model, heavy: boolean, form: string, color: Color3?)
	local r = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not r then
		return
	end
	local c = color or Color3.fromRGB(235, 240, 245)
	local range = Config.Forms[form].range
	task.delay(if heavy then 0.18 else 0.06, function()
		if form == "Spear" then
			local p = part(Vector3.new(0.4, 0.4, range), r.CFrame * CFrame.new(0, 0.5, -range / 2 - 0.5), c)
			p.Transparency = 0.3
			fade(p, 0.2)
			return
		end
		local radius = range * 0.75
		local n = if heavy then 9 else 7
		for i = 0, n do
			local a = math.rad(-70 + 140 * i / n)
			local pos = r.CFrame * CFrame.new(math.sin(a) * radius, 0.4 - i * 0.12, -math.cos(a) * radius)
			local p = part(
				Vector3.new(0.25, if heavy then 0.8 else 0.5, radius * 0.35),
				CFrame.lookAt(pos.Position, r.Position) * CFrame.Angles(0, math.rad(90), 0),
				c
			)
			p.Transparency = 0.35
			fade(p, 0.18 + i * 0.01)
		end
		if heavy and form == "Hammer" then
			ring(r.Position + r.CFrame.LookVector * (range * 0.6) - Vector3.new(0, 2.5, 0), range * 0.8, c, 0.35)
		end
	end)
end

--------------------------------------------------------------------------------
-- Ereignisse vom Server
--------------------------------------------------------------------------------
local handlers: { [string]: (...any) -> () } = {}

handlers.Swing = function(p: Player, heavy: boolean, form: string, color: Color3?)
	local char = p.Character
	if not char then
		return
	end
	swingAnim(char, heavy)
	slashArc(char, heavy, form, color)
end

handlers.Damage = function(pos: Vector3, amount: number, color: Color3?)
	floatText(pos, tostring(amount), color or Color3.fromRGB(255, 255, 255), if amount >= 30 then 26 else 20)
end

handlers.Immune = function(pos: Vector3)
	floatText(pos + Vector3.new(0, 3, 0), "IMMUN", Color3.fromRGB(160, 170, 180), 18)
end

handlers.Death = function(pos: Vector3, isBoss: boolean)
	burst(pos, Config.Colors.Rift, if isBoss then 30 else 10, if isBoss then 18 else 7)
	if isBoss then
		sphere(pos, 25, Config.Colors.Rift, 1.2)
		shake(1.2, 1)
	end
end

handlers.Windup = function(model: Model, t: number)
	if not model or not model.Parent then
		return
	end
	local h = Instance.new("Highlight")
	h.FillColor = Color3.fromRGB(255, 60, 40)
	h.OutlineColor = Color3.fromRGB(255, 120, 80)
	h.FillTransparency = 0.7
	h.DepthMode = Enum.HighlightDepthMode.Occluded
	h.Parent = model
	Debris:AddItem(h, t)
end

handlers.EnemyStrike = function(model: Model)
	local root = model and model.PrimaryPart
	if root then
		burst(root.Position + root.CFrame.LookVector * 3, Color3.fromRGB(255, 120, 80), 4, 3)
	end
end

handlers.PlayerHit = function(p: Player, amount: number)
	if p == player then
		flash(Color3.fromRGB(255, 0, 0))
		shake(0.4 + amount / 40, 0.2)
	end
	local char = p.Character
	local r = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if r then
		floatText(r.Position + Vector3.new(0, 3, 0), "-" .. math.floor(amount), Color3.fromRGB(255, 90, 90), 18)
	end
end

handlers.PerfectDodge = function(p: Player)
	local char = p.Character
	local r = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if r then
		floatText(r.Position + Vector3.new(0, 4, 0), "PERFEKT!", Config.Colors.Rift, 22)
	end
end

handlers.Dodge = function(p: Player)
	local char = p.Character
	local r = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if r then
		ring(r.Position - Vector3.new(0, 2.8, 0), 3, Color3.fromRGB(220, 230, 240), 0.3)
	end
end

handlers.Freeze = function(pos: Vector3)
	burst(pos, Config.Elements.Frost.color, 8, 4)
end

handlers.Roots = function(pos: Vector3, radius: number)
	for i = 1, 8 do
		local a = i / 8 * math.pi * 2
		local p = part(
			Vector3.new(0.6, 4, 0.6),
			CFrame.new(pos + Vector3.new(math.cos(a) * radius * 0.6, 2, math.sin(a) * radius * 0.6)) * CFrame.Angles(math.rad(15), a, 0),
			Color3.fromRGB(110, 80, 50)
		)
		p.Material = Enum.Material.Wood
		fade(p, 1.2)
	end
end

handlers.Slam = function(pos: Vector3, radius: number)
	ring(pos, radius, Color3.fromRGB(255, 120, 80), 0.5)
	burst(pos + Vector3.new(0, 1, 0), Color3.fromRGB(120, 110, 100), 12, radius * 0.5)
	if nearMe(pos, radius + 30) then
		shake(1, 0.4)
	end
end

handlers.RootLine = function(cf: CFrame, length: number)
	for i = 0, 8 do
		local pos = (cf * CFrame.new(0, 0, -length / 2 + length * i / 8)).Position
		local p = part(
			Vector3.new(1, 5, 1),
			CFrame.new(pos + Vector3.new(0, 2.5, 0)) * CFrame.Angles(math.rad(math.random(-15, 15)), 0, math.rad(math.random(-15, 15))),
			Color3.fromRGB(110, 80, 50)
		)
		p.Material = Enum.Material.Wood
		fade(p, 1)
	end
end

handlers.BossRoar = function(pos: Vector3)
	if nearMe(pos, 150) then
		shake(0.8, 0.8)
	end
	ring(pos, 30, Config.Colors.Rift, 0.8)
end

handlers.MimicReveal = function(model: Model)
	local root = model and model.PrimaryPart
	if root then
		floatText(root.Position + Vector3.new(0, 4, 0), "MIMIC!", Color3.fromRGB(255, 100, 100), 26)
	end
end

handlers.Shards = function(pos: Vector3, radius: number)
	burst(pos, Color3.fromRGB(255, 200, 220), 10, radius)
	ring(pos - Vector3.new(0, 2, 0), radius, Color3.fromRGB(255, 180, 200), 0.3)
end

handlers.Nova = function(pos: Vector3, radius: number, color: Color3)
	ring(pos - Vector3.new(0, 2.5, 0), radius, color, 0.45)
	sphere(pos, radius * 0.8, color, 0.4)
end

handlers.Explosion = function(pos: Vector3, radius: number, color: Color3)
	sphere(pos, radius, color, 0.45)
	burst(pos, color, 10, radius)
	if nearMe(pos, 40) then
		shake(0.5, 0.25)
	end
end

handlers.Chain = function(a: Vector3, b: Vector3, color: Color3)
	lightning(a, b, color)
	burst(b, color, 4, 3)
end

handlers.Teleport = function(a: Vector3, b: Vector3, color: Color3)
	lightning(a, b, color)
	sphere(a, 3, color, 0.3)
	sphere(b, 3, color, 0.3)
end

handlers.Echo = function(pos: Vector3, color: Color3)
	for _, angle in { 45, -45 } do
		local p = part(Vector3.new(0.4, 7, 0.4), CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(angle)), color)
		p.Transparency = 0.1
		fade(p, 0.35)
	end
end

handlers.Trail = function(points: { Vector3 }, radius: number, duration: number)
	for _, pos in points do
		local p = part(
			Vector3.new(0.2, radius * 2, radius * 2),
			CFrame.new(pos - Vector3.new(0, 2.6, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Config.Elements.Ember.color,
			Enum.PartType.Cylinder
		)
		p.Transparency = 0.45
		local f = Instance.new("Fire")
		f.Size = 4
		f.Heat = 6
		f.Parent = p
		task.delay(duration - 0.4, function()
			f.Enabled = false
			fade(p, 0.4)
		end)
	end
end

handlers.Ability = function(p: Player, el: string)
	local char = p.Character
	local r = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if r then
		local color = Config.Elements[el].color
		burst(r.Position, color, 12, 6)
		if p == player then
			flash(color)
		end
	end
end

handlers.Harvest = function(pos: Vector3)
	burst(pos + Vector3.new(0, 1.5, 0), Color3.fromRGB(200, 170, 120), 8, 4)
end

handlers.ChestOpen = function(model: Model)
	if model and model.Parent then
		local cf = model:GetBoundingBox()
		burst(cf.Position + Vector3.new(0, 1, 0), Color3.fromRGB(255, 220, 120), 12, 5)
	end
end

handlers.Smelt = function() end

function Fx.Init(flashFn: (Color3) -> ())
	flash = flashFn
	Net.Event("Fx").OnClientEvent:Connect(function(kind: string, ...)
		local h = handlers[kind]
		if h then
			local ok, err = pcall(h, ...)
			if not ok then
				warn("[RIFTBOUND] Fx-Fehler", kind, err)
			end
		end
	end)
end

return Fx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[--!nonstrict
-- HUD: Leben, Ausdauer, Elementladung, Bossleiste, Ziel, Hinweise, Menü- und Handy-Tasten.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local UI = require(script.Parent.UI)
local Store = require(script.Parent.Store)

local player = Players.LocalPlayer

local Hud = {}

local gui: ScreenGui
local toastList: Frame
local objective: TextLabel
local weaponLabel: TextLabel
local chargeBack: Frame
local bossFrame: Frame
local bossFill: Frame
local bossText: TextLabel
local burstText: TextLabel
local runFrame: Frame
local runTime: TextLabel
local runBag: TextLabel
local downedFrame: Frame
local vignette: Frame

local TOAST_COLORS = {
	info = UI.C.Card,
	good = Color3.fromRGB(34, 74, 52),
	bad = Color3.fromRGB(86, 34, 34),
	loot = Color3.fromRGB(30, 50, 62),
	loot_protected = Color3.fromRGB(70, 56, 24),
	milestone = Color3.fromRGB(24, 78, 72),
	boss = Color3.fromRGB(80, 30, 70),
}

function Hud.Toast(text: string, kind: string?)
	local color = TOAST_COLORS[kind or "info"] or UI.C.Card
	local card = UI.new("Frame", {
		BackgroundColor3 = color,
		BackgroundTransparency = 0.08,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = -math.floor(os.clock() * 100),
		Parent = toastList,
	}, { UI.Corner(8), UI.Pad(8), UI.Stroke(if kind == "milestone" then UI.C.Rift else UI.C.Stroke) })
	UI.Label(text, 14, UI.C.Text, if kind == "milestone" or kind == "boss" then UI.FontBold else UI.Font, { Parent = card })
	local children = toastList:GetChildren()
	local frames = {}
	for _, c in children do
		if c:IsA("Frame") then
			table.insert(frames, c)
		end
	end
	if #frames > 6 then
		table.sort(frames, function(a, b)
			return a.LayoutOrder > b.LayoutOrder
		end)
		frames[1]:Destroy()
	end
	task.delay(if kind == "milestone" or kind == "boss" then 6 else 4, function()
		if card.Parent then
			TweenService:Create(card, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
			task.wait(0.4)
			card:Destroy()
		end
	end)
end

function Hud.Flash(color: Color3)
	vignette.BackgroundColor3 = color
	vignette.BackgroundTransparency = 0.6
	TweenService:Create(vignette, TweenInfo.new(0.35), { BackgroundTransparency = 1 }):Play()
end

local function nextObjective(): string
	local s = Store.state
	for _, m in Config.Milestones do
		if not s.milestones[m.id] then
			return "<b>Ziel:</b> " .. m.hint
		end
	end
	return "<b>Ziel:</b> Probiere neue Kombinationen und fordere den Warden auf <b>Hart</b> heraus."
end

local function refresh()
	local s = Store.state
	objective.Text = nextObjective()
	local w = Store.Equipped()
	if w then
		local q = Config.Quality[w.quality or 1]
		local colored = UI.WeaponName(w)
		if w.e1 then
			colored = UI.Colored(colored, Config.Elements[w.e1].color)
		end
		weaponLabel.Text = colored .. '  <font color="#8CA0AC">(' .. (q and q.name or "") .. (if w.part then ", " .. UI.ItemName(w.part) else "") .. ")</font>"
	else
		weaponLabel.Text = UI.Colored("Keine Waffe – geh zur Schmiede!", UI.C.Danger)
	end
	runFrame.Visible = s.inRun
	if s.inRun then
		local total = 0
		for _, n in s.backpack do
			total += n
		end
		local prot = 0
		for _, n in s.protectedLoot do
			prot += n
		end
		runBag.Text = "Rucksack: <b>" .. total .. "</b> ungesichert" .. (if prot > 0 then "  ·  " .. prot .. " Bossbeute" else "")
	end
end

local function makeBars(parent: Instance)
	local box = UI.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(16, 16),
		Size = UDim2.fromOffset(300, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = parent,
	}, { UI.List(5) })
	local title = UI.Label("RIFTBOUND", 16, UI.C.Rift, UI.FontBlack, { LayoutOrder = 0, Parent = box })
	title.TextStrokeTransparency = 0.6
	local hpBack, hpFill, hpText = UI.Bar(UI.C.Danger, { LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 18), Parent = box })
	local _, stFill, _ = UI.Bar(UI.C.Stamina, { LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 8), Parent = box })
	local chBack, chFill, chText = UI.Bar(UI.C.Rift, { LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 12), Parent = box })
	chargeBack = chBack
	weaponLabel = UI.Label("", 13, UI.C.Text, UI.FontBold, { LayoutOrder = 4, Parent = box })
	weaponLabel.TextStrokeTransparency = 0.6

	RunService.RenderStepped:Connect(function()
		local hp = player:GetAttribute("HP") or 100
		local maxHp = player:GetAttribute("MaxHP") or 100
		local st = player:GetAttribute("Stamina") or 100
		local ch = player:GetAttribute("Charge") or 0
		hpFill.Size = UDim2.fromScale(math.clamp(hp / maxHp, 0, 1), 1)
		hpText.Text = hp .. " / " .. maxHp
		stFill.Size = UDim2.fromScale(math.clamp(st / Config.Player.MaxStamina, 0, 1), 1)
		chargeBack.Visible = player:GetAttribute("HasElement") == true
		chFill.Size = UDim2.fromScale(math.clamp(ch / 100, 0, 1), 1)
		local w = Store.Equipped()
		if w and w.e1 then
			chFill.BackgroundColor3 = Config.Elements[w.e1].color
		end
		chText.Text = if ch >= 100 then "ELEMENT BEREIT  [F]" else ""
		hpBack.Visible = true
	end)
end

local function makeBoss(parent: Instance)
	bossFrame = UI.new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 14),
		Size = UDim2.new(0.44, 0, 0, 46),
		Visible = false,
		Parent = parent,
	})
	bossText = UI.Label("Hollow Warden", 16, UI.C.Text, UI.FontBlack, { Parent = bossFrame, TextXAlignment = Enum.TextXAlignment.Center })
	bossText.TextStrokeTransparency = 0.4
	local _, fill = UI.Bar(Color3.fromRGB(200, 60, 80), { Position = UDim2.fromOffset(0, 22), Size = UDim2.new(1, 0, 0, 14), Parent = bossFrame })
	bossFill = fill
	burstText =
		UI.Label("", 15, UI.C.Rift, UI.FontBlack, { Position = UDim2.fromOffset(0, 40), Parent = bossFrame, TextXAlignment = Enum.TextXAlignment.Center })
	burstText.TextStrokeTransparency = 0.3

	RunService.Heartbeat:Connect(function()
		local active = ReplicatedStorage:GetAttribute("BossActive") == true and Store.state.inRun
		bossFrame.Visible = active
		if active then
			local hp = ReplicatedStorage:GetAttribute("BossHP") or 0
			local maxHp = ReplicatedStorage:GetAttribute("BossMaxHP") or 1
			bossFill.Size = UDim2.fromScale(math.clamp(hp / maxHp, 0, 1), 1)
			bossText.Text = (ReplicatedStorage:GetAttribute("BossName") or "Boss") .. "  ·  " .. hp .. " / " .. maxHp
			local burst = ReplicatedStorage:GetAttribute("BossBurst") or 0
			burstText.Text = if burst > 0 then "RIFT-AUSBRUCH in " .. burst .. " s – Kristalle zerstören!" else ""
		end
		if runFrame.Visible then
			local start = ReplicatedStorage:GetAttribute("RunStart") or 0
			if start > 0 then
				local t = math.max(0, workspace:GetServerTimeNow() - start)
				runTime.Text = string.format("Expedition  %02d:%02d", math.floor(t / 60), math.floor(t % 60))
				runTime.TextColor3 = if t > 15 * 60 then UI.C.Stamina else UI.C.Text
			end
		end
	end)
end

local function makeRunInfo(parent: Instance)
	runFrame = UI.new("Frame", {
		BackgroundColor3 = UI.C.Panel,
		BackgroundTransparency = 0.2,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 16),
		Size = UDim2.fromOffset(250, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Visible = false,
		Parent = parent,
	}, { UI.Corner(8), UI.Pad(8), UI.List(3), UI.Stroke() })
	runTime = UI.Label("Expedition 00:00", 15, UI.C.Text, UI.FontBlack, { Parent = runFrame })
	runBag = UI.Label("", 13, UI.C.Dim, UI.Font, { Parent = runFrame })
	UI.Label("Beute am <b>Rückkehrportal</b> sichern.", 12, UI.C.Dim, UI.Font, { Parent = runFrame })
end

local function makeDowned(parent: Instance)
	downedFrame = UI.new("Frame", {
		BackgroundColor3 = Color3.fromRGB(60, 0, 0),
		BackgroundTransparency = 0.65,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 5,
		Parent = parent,
	})
	local text = UI.Label("", 26, UI.C.Text, UI.FontBlack, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.4),
		Size = UDim2.new(0.8, 0, 0, 0),
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 6,
		Parent = downedFrame,
	})
	local since = 0
	player:GetAttributeChangedSignal("Downed"):Connect(function()
		local d = player:GetAttribute("Downed") == true
		downedFrame.Visible = d
		since = os.clock()
	end)
	RunService.Heartbeat:Connect(function()
		if downedFrame.Visible then
			local left = math.max(0, Config.Player.BleedoutTime - (os.clock() - since))
			text.Text = 'NIEDERGESCHLAGEN\n<font size="18">Ein Teammitglied kann dich wiederbeleben · ' .. math.ceil(left) .. " s</font>"
		end
	end)
end

export type Actions = {
	openPanel: (string) -> (),
	action: (string) -> (),
}

local function makeMenuButtons(parent: Instance, actions: Actions)
	local bar = UI.new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 16, 1, -16),
		Size = UDim2.fromOffset(0, 40),
		AutomaticSize = Enum.AutomaticSize.X,
		Parent = parent,
	}, { UI.List(8, true) })
	UI.Button("Arsenal [I]", UI.C.Panel, function()
		actions.openPanel("Inventory")
	end, { Size = UDim2.fromOffset(120, 40), Parent = bar })
	UI.Button("Aufgaben [J]", UI.C.Panel, function()
		actions.openPanel("Quests")
	end, { Size = UDim2.fromOffset(120, 40), Parent = bar })
	UI.Button("Hilfe [H]", UI.C.Panel, function()
		actions.openPanel("Help")
	end, { Size = UDim2.fromOffset(90, 40), Parent = bar })
end

local function makeTouchButtons(parent: Instance, actions: Actions)
	local holder = UI.new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -20, 1, -150),
		Size = UDim2.fromOffset(220, 200),
		Parent = parent,
	})
	local function btn(text: string, pos: UDim2, size: number, color: Color3, action: string)
		local b = UI.new("TextButton", {
			Text = text,
			Font = UI.FontBlack,
			TextSize = if size > 80 then 16 else 12,
			TextColor3 = UI.C.Text,
			BackgroundColor3 = color,
			BackgroundTransparency = 0.15,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = pos,
			Size = UDim2.fromOffset(size, size),
			Parent = holder,
		}, { UI.Corner(size), UI.Stroke(Color3.fromRGB(255, 255, 255), 1.5) })
		b.Activated:Connect(function()
			actions.action(action)
		end)
		return b
	end
	btn("ANGRIFF", UDim2.fromOffset(150, 140), 92, Color3.fromRGB(70, 80, 92), "Light")
	btn("SCHWER", UDim2.fromOffset(60, 150), 64, Color3.fromRGB(120, 70, 50), "Heavy")
	btn("AUS-\nWEICHEN", UDim2.fromOffset(170, 50), 62, Color3.fromRGB(60, 90, 70), "Dodge")
	local el = btn("ELEMENT", UDim2.fromOffset(80, 64), 60, Color3.fromRGB(30, 110, 100), "Ability")
	RunService.Heartbeat:Connect(function()
		el.Visible = player:GetAttribute("HasElement") == true
		el.BackgroundTransparency = if (player:GetAttribute("Charge") or 0) >= 100 then 0 else 0.6
	end)
end

function Hud.Init(actions: Actions)
	gui = UI.new("ScreenGui", {
		Name = "RiftboundHUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	vignette = UI.new("Frame", {
		BackgroundColor3 = Color3.new(1, 0, 0),
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 0,
		Parent = gui,
	})
	makeBars(gui)
	makeBoss(gui)
	makeRunInfo(gui)
	makeDowned(gui)
	makeMenuButtons(gui, actions)

	objective = UI.Label("", 14, UI.C.Text, UI.Font, {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -70),
		Size = UDim2.new(0.5, 0, 0, 0),
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = gui,
	})
	objective.TextStrokeTransparency = 0.4

	toastList = UI.new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 120),
		Size = UDim2.fromOffset(300, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = gui,
	}, { UI.List(6) })

	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	if touch then
		makeTouchButtons(gui, actions)
	else
		local hint = UI.Label("Linksklick: leicht · R / Rechtsklick: schwer · Q: ausweichen · F: Element · E: interagieren", 12, UI.C.Dim, UI.Font, {
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -8),
			Size = UDim2.new(0.6, 0, 0, 0),
			TextXAlignment = Enum.TextXAlignment.Center,
			Parent = gui,
		})
		hint.TextStrokeTransparency = 0.6
	end

	Net.Event("Notify").OnClientEvent:Connect(Hud.Toast)
	Store.Changed:Connect(refresh)
	refresh()
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Input</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Eingaben (Maus/Tastatur, Controller, Touch) → Kampfabsichten an den Server.
-- Ausweichen bewegt den eigenen Charakter sofort (Client besitzt die Physik),
-- Unverwundbarkeit und Ausdauer prüft der Server.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local Store = require(script.Parent.Store)

local player = Players.LocalPlayer
local ActionEvent = Net.Event("Action")

local Input = {}

local isOpen: () -> boolean = function()
	return false
end
local lastAttack = 0
local lastDodge = 0
local rightDownAt = 0

local function root(): BasePart?
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function canAct(): boolean
	if isOpen() or player:GetAttribute("Downed") == true then
		return false
	end
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	return hum ~= nil and hum.Health > 0
end

-- Richtet den Charakter aus: PC → zur Maus, sonst zum nächsten Gegner vor dir.
local function aim(range: number)
	local r = root()
	if not r then
		return
	end
	local targetPos: Vector3? = nil
	if UserInputService.MouseEnabled and not UserInputService.TouchEnabled then
		local mouse = player:GetMouse()
		local hit = mouse.Hit.Position
		if (hit - r.Position).Magnitude < 300 then
			targetPos = hit
		end
	end
	if not targetPos then
		local folder = workspace:FindFirstChild("Entities")
		local best, bestD = nil, range + 6
		if folder then
			local look = r.CFrame.LookVector
			for _, m in folder:GetChildren() do
				if m:IsA("Model") and m.PrimaryPart then
					local offset = m.PrimaryPart.Position - r.Position
					local d = offset.Magnitude
					local flatOff = Vector3.new(offset.X, 0, offset.Z)
					if d < bestD and flatOff.Magnitude > 0.1 and look:Dot(flatOff.Unit) > 0.2 then
						best, bestD = m.PrimaryPart.Position, d
					end
				end
			end
		end
		targetPos = best
	end
	if targetPos then
		local flatTarget = Vector3.new(targetPos.X, r.Position.Y, targetPos.Z)
		if (flatTarget - r.Position).Magnitude > 0.5 then
			r.CFrame = CFrame.lookAt(r.Position, flatTarget)
		end
	end
end

local function attack(heavy: boolean)
	if not canAct() then
		return
	end
	local w = Store.Equipped()
	if not w then
		ActionEvent:FireServer("Light") -- Server meldet "keine Waffe"
		return
	end
	local form = Config.Forms[w.form]
	local cd = if heavy then form.heavyCd else form.lightCd
	local now = os.clock()
	if now - lastAttack < cd then
		return
	end
	local cost = if heavy then Config.Player.HeavyStamina else Config.Player.LightStamina
	if (player:GetAttribute("Stamina") or 0) < cost then
		return
	end
	lastAttack = now
	aim(form.range)
	ActionEvent:FireServer(if heavy then "Heavy" else "Light")
end

local function dodge()
	if not canAct() then
		return
	end
	local now = os.clock()
	if now - lastDodge < Config.Player.DodgeCooldown then
		return
	end
	if (player:GetAttribute("Stamina") or 0) < Config.Player.DodgeStamina then
		return
	end
	local r = root()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not r or not hum or hum.WalkSpeed <= 0 then
		return
	end
	lastDodge = now
	ActionEvent:FireServer("Dodge")
	local dir = hum.MoveDirection
	if dir.Magnitude < 0.1 then
		dir = -r.CFrame.LookVector
	end
	dir = Vector3.new(dir.X, 0, dir.Z).Unit
	local att = Instance.new("Attachment")
	att.Parent = r
	local lv = Instance.new("LinearVelocity")
	lv.Attachment0 = att
	lv.MaxForce = 1e5
	lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.VectorVelocity = dir * 62
	lv.Parent = r
	task.delay(0.2, function()
		lv:Destroy()
		att:Destroy()
	end)
end

local function ability()
	if not canAct() then
		return
	end
	if (player:GetAttribute("Charge") or 0) < 100 then
		return
	end
	local w = Store.Equipped()
	aim(if w then Config.Forms[w.form].range else 8)
	ActionEvent:FireServer("Ability")
end

function Input.Action(action: string)
	if action == "Light" then
		attack(false)
	elseif action == "Heavy" then
		attack(true)
	elseif action == "Dodge" then
		dodge()
	elseif action == "Ability" then
		ability()
	end
end

export type Callbacks = {
	isOpen: () -> boolean,
	toggle: (string) -> (),
	close: () -> (),
}

function Input.Init(cb: Callbacks)
	isOpen = cb.isOpen
	UserInputService.InputBegan:Connect(function(input, processed)
		local key = input.KeyCode
		-- Menütasten funktionieren auch, wenn ein Menü offen ist
		if not processed or input.UserInputType == Enum.UserInputType.Keyboard then
			if key == Enum.KeyCode.I or key == Enum.KeyCode.ButtonSelect then
				if not UserInputService:GetFocusedTextBox() then
					cb.toggle("Inventory")
				end
				return
			elseif key == Enum.KeyCode.J then
				if not UserInputService:GetFocusedTextBox() then
					cb.toggle("Quests")
				end
				return
			elseif key == Enum.KeyCode.H then
				if not UserInputService:GetFocusedTextBox() then
					cb.toggle("Help")
				end
				return
			elseif key == Enum.KeyCode.Escape or key == Enum.KeyCode.ButtonB and isOpen() then
				cb.close()
				return
			end
		end
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			attack(false)
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
			rightDownAt = os.clock()
		elseif key == Enum.KeyCode.R or key == Enum.KeyCode.ButtonR1 then
			attack(true)
		elseif key == Enum.KeyCode.ButtonR2 then
			attack(false)
		elseif key == Enum.KeyCode.Q or key == Enum.KeyCode.ButtonB or key == Enum.KeyCode.LeftControl then
			dodge()
		elseif key == Enum.KeyCode.F or key == Enum.KeyCode.ButtonY then
			ability()
		end
	end)
	UserInputService.InputEnded:Connect(function(input, processed)
		-- Kurzer Rechtsklick = schwerer Angriff (langes Halten dreht weiterhin die Kamera)
		if input.UserInputType == Enum.UserInputType.MouseButton2 and not processed then
			if os.clock() - rightDownAt < 0.22 then
				attack(true)
			end
		end
	end)
end

return Input
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="26">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!nonstrict
-- RIFTBOUND – Client-Einstiegspunkt.

local Store = require(script.Parent.Store)
local Hud = require(script.Parent.Hud)
local Panels = require(script.Parent.Panels)
local Input = require(script.Parent.Input)
local Fx = require(script.Parent.Fx)

Panels.Init(Hud.Toast)
Hud.Init({
	openPanel = Panels.Toggle,
	action = Input.Action,
})
Input.Init({
	isOpen = Panels.IsOpen,
	toggle = Panels.Toggle,
	close = Panels.Close,
})
Fx.Init(Hud.Flash)

local _ = Store
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Panels</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Menüs: Schmiede (mit Härtungsschritt), Schmelzofen, Forschung, Lagerkiste,
-- Expeditionstafel, Arsenal, Aufgaben und Hilfe.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local UI = require(script.Parent.UI)
local Store = require(script.Parent.Store)

local player = Players.LocalPlayer
local Request = Net.Event("Request")

local Panels = {}

local gui: ScreenGui
local window: Frame
local titleLabel: TextLabel
local content: Frame
local current: string? = nil
local hardeningActive = false
local toast: (string, string?) -> () = function() end

local TITLES = {
	Forge = "Schmiede",
	Furnace = "Schmelzofen",
	Research = "Forschungstisch",
	Chest = "Gemeinsame Lagerkiste",
	Board = "Expeditionstafel",
	Inventory = "Arsenal & Inventar",
	Quests = "Aufgaben & Meilensteine",
	Help = "So spielst du RIFTBOUND",
}

local function send(action: string, a: any?, b: any?)
	Request:FireServer(action, a, b)
end

local function section(parent: Instance, text: string, order: number)
	UI.Label(text, 13, UI.C.Rift, UI.FontBlack, { LayoutOrder = order, Parent = parent })
end

local function row(parent: Instance, order: number, height: number?): Frame
	local r = UI.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, height or 34),
		LayoutOrder = order,
		Parent = parent,
	}, { UI.List(6, true) })
	return r
end

local function costText(cost: { [string]: number }): string
	local parts = {}
	for _, id in Config.ItemOrder do
		local need = cost[id]
		if need then
			local have = Store.Count(id)
			local color = if have >= need then UI.C.Good else UI.C.Danger
			table.insert(parts, UI.Colored(UI.ItemName(id) .. " " .. have .. "/" .. need, color))
		end
	end
	return table.concat(parts, "   ")
end

local function hasAll(cost: { [string]: number }): boolean
	for id, n in cost do
		if Store.Count(id) < n then
			return false
		end
	end
	return true
end

local function twoColumns(): (ScrollingFrame, Frame)
	local left = UI.Scroll({ Size = UDim2.new(0.56, -6, 1, 0), Parent = content })
	UI.List(8).Parent = left
	UI.new("UIPadding", { PaddingRight = UDim.new(0, 8), Parent = left })
	local right = UI.new("Frame", {
		BackgroundColor3 = UI.C.Bg,
		Position = UDim2.new(0.56, 6, 0, 0),
		Size = UDim2.new(0.44, -6, 1, 0),
		Parent = content,
	}, { UI.Corner(8), UI.Pad(10) })
	return left, right
end

--------------------------------------------------------------------------------
-- Schmiede
--------------------------------------------------------------------------------
local sel = { form = "Sword", e1 = nil :: string?, e2 = nil :: string?, part = nil :: string?, blueprint = nil :: number? }

local function recipeCost(): { [string]: number }
	local cost: { [string]: number } = {}
	for k, v in Config.Forms[sel.form].cost do
		cost[k] = (cost[k] or 0) + v
	end
	for _, el in { sel.e1, sel.e2 } do
		if el then
			local core = Config.Elements[el].core
			cost[core] = (cost[core] or 0) + 1
			for k, v in Config.ElementCost do
				cost[k] = (cost[k] or 0) + v
			end
		end
	end
	if sel.part then
		cost[sel.part] = (cost[sel.part] or 0) + 1
	end
	return cost
end

local function startHardening()
	if hardeningActive then
		return
	end
	local result = Net.Function("ForgeBegin"):InvokeServer({ form = sel.form, e1 = sel.e1, e2 = sel.e2, part = sel.part, blueprint = sel.blueprint })
	if not result or not result.ok then
		toast(if result then result.msg else "Fehler", "bad")
		return
	end
	hardeningActive = true
	local start = result.start
	local overlay = UI.new("Frame", {
		BackgroundColor3 = Color3.fromRGB(8, 10, 14),
		BackgroundTransparency = 0.1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 20,
		Active = true,
		Parent = window,
	}, { UI.Corner(12) })
	local info = UI.Label("<b>Härten:</b> Schlag, wenn der Marker in der Mitte ist! (Leertaste, Klick oder Knopf)", 16, UI.C.Text, UI.Font, {
		Position = UDim2.new(0.1, 0, 0.14, 0),
		Size = UDim2.new(0.8, 0, 0, 0),
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 21,
		Parent = overlay,
	})
	local bar = UI.new("Frame", {
		BackgroundColor3 = Color3.fromRGB(40, 30, 26),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.new(0.8, 0, 0, 34),
		ZIndex = 21,
		Parent = overlay,
	}, { UI.Corner(6), UI.Stroke(UI.C.Copper, 2) })
	UI.new("Frame", {
		BackgroundColor3 = Color3.fromRGB(200, 120, 50),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromScale(Config.Hardening.Good * 2, 1),
		ZIndex = 22,
		Parent = bar,
	})
	UI.new("Frame", {
		BackgroundColor3 = Color3.fromRGB(255, 230, 140),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromScale(Config.Hardening.Perfect * 2, 1),
		ZIndex = 23,
		Parent = bar,
	})
	local marker = UI.new("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.new(0, 6, 1, 16),
		ZIndex = 24,
		Parent = bar,
	}, { UI.Corner(3) })
	local feedback = UI.Label("", 20, UI.C.Text, UI.FontBlack, {
		Position = UDim2.new(0.1, 0, 0.52, 0),
		Size = UDim2.new(0.8, 0, 0, 0),
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 21,
		Parent = overlay,
	})
	local strikeButton = UI.Button("SCHLAG!", UI.C.Copper, nil, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.66),
		Size = UDim2.fromOffset(220, 56),
		TextSize = 22,
		ZIndex = 21,
		Parent = overlay,
	})
	local times: { number } = {}
	local words = {}
	local done = false
	local conns: { RBXScriptConnection } = {}

	local function finish()
		if done then
			return
		end
		done = true
		for _, c in conns do
			c:Disconnect()
		end
		strikeButton.Visible = false
		info.Text = "Die Klinge kühlt ab ..."
		local res = Net.Function("ForgeFinish"):InvokeServer(times)
		if res and res.ok then
			feedback.Text = UI.Colored(res.msg, UI.C.Rift)
			toast(res.msg, "milestone")
		else
			feedback.Text = UI.Colored(if res then res.msg else "Fehler", UI.C.Danger)
		end
		task.wait(1.6)
		overlay:Destroy()
		hardeningActive = false
	end

	local function strike()
		if done or #times >= Config.Hardening.Strikes then
			return
		end
		local now = workspace:GetServerTimeNow()
		if now < start then
			return
		end
		table.insert(times, now)
		local off = math.abs(Config.HardeningPos(now - start) - 0.5)
		local word = if off <= Config.Hardening.Perfect
			then UI.Colored("PERFEKT", Color3.fromRGB(255, 230, 140))
			elseif off <= Config.Hardening.Good then UI.Colored("GUT", UI.C.Copper)
			else UI.Colored("daneben", UI.C.Dim)
		table.insert(words, word)
		feedback.Text = table.concat(words, "  ·  ")
		if #times >= Config.Hardening.Strikes then
			task.spawn(finish)
		end
	end
	strikeButton.Activated:Connect(strike)
	table.insert(
		conns,
		UserInputService.InputBegan:Connect(function(input, processed)
			if input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.ButtonA then
				strike()
			elseif input.UserInputType == Enum.UserInputType.MouseButton1 and not processed then
				strike()
			end
		end)
	)
	table.insert(
		conns,
		RunService.RenderStepped:Connect(function()
			local now = workspace:GetServerTimeNow()
			if now < start then
				marker.Position = UDim2.fromScale(0, 0.5)
				return
			end
			marker.Position = UDim2.fromScale(Config.HardeningPos(now - start), 0.5)
			if now - start > Config.Hardening.Timeout then
				task.spawn(finish)
			end
		end)
	)
end

local function renderForge()
	local s = Store.state
	local left, right = twoColumns()
	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end

	section(left, "WAFFENFORM", nextOrder())
	local formRow = row(left, nextOrder(), 40)
	for _, id in Config.FormOrder do
		local def = Config.Forms[id]
		local unlocked = s.unlocked[id] == true
		local active = sel.form == id
		UI.Button(def.name .. (if unlocked then "" else "\n(erforschen)"), if active then UI.C.Copper elseif unlocked then UI.C.Card else UI.C.Bg, function()
			if not unlocked then
				toast(def.name .. " musst du erst am Forschungstisch freischalten.", "bad")
				return
			end
			sel.form = id
			Panels.Refresh()
		end, { Size = UDim2.new(1 / 3, -4, 1, 0), TextSize = 13, Parent = formRow })
	end

	local function elementRow(label: string, slot: string)
		section(left, label, nextOrder())
		local r = row(left, nextOrder(), 44)
		local current = (sel :: any)[slot]
		local other = if slot == "e1" then sel.e2 else sel.e1
		UI.Button("Kein", if current == nil then UI.C.Copper else UI.C.Card, function()
			(sel :: any)[slot] = nil
			if slot == "e1" then
				sel.e1, sel.e2 = sel.e2, nil
			end
			Panels.Refresh()
		end, { Size = UDim2.new(0.2, -5, 1, 0), TextSize = 12, Parent = r })
		for _, el in Config.ElementOrder do
			local def = Config.Elements[el]
			local count = Store.Count(def.core)
			local disabled = el == other or (slot == "e2" and sel.e1 == nil)
			local b = UI.Button(def.name .. "\n" .. count .. "×", if current == el then def.color else UI.C.Card, function()
				if disabled then
					return
				end
				(sel :: any)[slot] = el
				Panels.Refresh()
			end, { Size = UDim2.new(0.2, -5, 1, 0), TextSize = 12, Parent = r })
			b.TextColor3 = if current == el then Color3.fromRGB(20, 20, 20) else def.color
			if disabled or count == 0 then
				b.BackgroundTransparency = 0.5
				b.TextTransparency = 0.4
			end
		end
	end
	elementRow("ERSTER ELEMENTKERN (Haupteffekt)", "e1")
	elementRow("ZWEITER ELEMENTKERN (optional, Kombination)", "e2")

	section(left, "MONSTERTEIL (optional, jederzeit wieder entfernbar)", nextOrder())
	local partRow = UI.new(
		"Frame",
		{ BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = nextOrder(), Parent = left },
		{
			UI.new("UIGridLayout", { CellSize = UDim2.new(0.5, -4, 0, 32), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
		}
	)
	UI.Button("Kein Monsterteil", if sel.part == nil then UI.C.Copper else UI.C.Card, function()
		sel.part = nil
		Panels.Refresh()
	end, { TextSize = 12, Parent = partRow })
	for _, id in Config.ItemOrder do
		if Config.Items[id].kind == "Part" and Store.Count(id) > 0 then
			UI.Button(UI.ItemName(id) .. " (" .. Store.Count(id) .. ")", if sel.part == id then UI.C.Copper else UI.C.Card, function()
				sel.part = id
				Panels.Refresh()
			end, { TextSize = 12, Parent = partRow })
		end
	end

	section(left, "GESPEICHERTE BAUPLÄNE", nextOrder())
	if #s.blueprints == 0 then
		UI.Label("Noch keine. Speichere im Arsenal einen Bauplan deiner Lieblingswaffe.", 12, UI.C.Dim, UI.Font, { LayoutOrder = nextOrder(), Parent = left })
	end
	for i, bp in s.blueprints do
		local r = row(left, nextOrder(), 30)
		UI.Label(bp.name, 13, UI.C.Text, UI.FontBold, { Size = UDim2.new(0.6, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.None, Parent = r })
		UI.Button("Laden", UI.C.Card, function()
			if not s.unlocked[bp.form] then
				toast("Waffenform noch nicht erforscht.", "bad")
				return
			end
			sel.form, sel.e1, sel.e2, sel.blueprint = bp.form, bp.e1, bp.e2, i
			Panels.Refresh()
		end, { Size = UDim2.new(0.25, 0, 1, 0), TextSize = 12, Parent = r })
		UI.Button("✕", UI.C.Bg, function()
			send("DeleteBlueprint", i)
		end, { Size = UDim2.new(0.1, 0, 1, 0), TextSize = 12, Parent = r })
	end

	-- Vorschau
	UI.List(6).Parent = right
	local preview = { form = sel.form, e1 = sel.e1, e2 = sel.e2 }
	local nameText = UI.WeaponName(preview)
	if sel.e1 then
		nameText = UI.Colored(nameText, Config.Elements[sel.e1].color)
	end
	UI.Label(nameText, 20, UI.C.Text, UI.FontBlack, { LayoutOrder = 1, Parent = right })
	local form = Config.Forms[sel.form]
	UI.Label(form.desc, 12, UI.C.Dim, UI.Font, { LayoutOrder = 2, Parent = right })
	UI.Label(
		string.format("Schaden: leicht %d · schwer %d · Reichweite %d", form.light, form.heavy, form.range),
		12,
		UI.C.Dim,
		UI.Font,
		{ LayoutOrder = 3, Parent = right }
	)
	local lines = {}
	for _, el in { sel.e1, sel.e2 } do
		if el then
			local def = Config.Elements[el]
			table.insert(lines, UI.Colored("<b>" .. def.name .. ":</b> ", def.color) .. def.desc)
		end
	end
	if sel.e1 then
		table.insert(lines, UI.Colored("<b>Elementfähigkeit [F]:</b> ", Config.Elements[sel.e1].color) .. Config.Elements[sel.e1].ability)
	end
	local key = Config.ComboKey(sel.e1, sel.e2)
	if key then
		local c = Config.Combos[key]
		table.insert(lines, UI.Colored("<b>Kombination – " .. c.name .. ":</b> ", UI.C.Rift) .. c.desc)
	end
	if sel.part then
		table.insert(lines, UI.Colored("<b>" .. UI.ItemName(sel.part) .. ":</b> ", UI.C.Copper) .. Config.Items[sel.part].desc)
	end
	if #lines == 0 then
		table.insert(lines, "Ohne Element: solide Grundwaffe. Elementkerne findest du auf Expeditionen.")
	end
	UI.Label(table.concat(lines, "\n"), 13, UI.C.Text, UI.Font, { LayoutOrder = 4, Parent = right })
	local cost = recipeCost()
	UI.Label("<b>Kosten:</b>  " .. costText(cost), 12, UI.C.Text, UI.Font, { LayoutOrder = 5, Parent = right })
	UI.Label(
		"Danach folgt der Härtungsschritt: 3 Schläge im richtigen Moment verbessern die Qualität leicht. Misslingen kann nichts.",
		11,
		UI.C.Dim,
		UI.Font,
		{ LayoutOrder = 6, Parent = right }
	)
	local can = hasAll(cost)
	local b = UI.Button(if can then "SCHMIEDEN" else "Materialien fehlen", if can then UI.C.Copper else UI.C.Card, function()
		if can then
			task.spawn(startHardening)
		end
	end, { LayoutOrder = 7, Size = UDim2.new(1, 0, 0, 46), TextSize = 18, Parent = right })
	b.AutoButtonColor = can
end

--------------------------------------------------------------------------------
-- Schmelzofen, Forschung, Lagerkiste
--------------------------------------------------------------------------------
local function renderFurnace()
	local box = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = content }, { UI.List(10) })
	local ore, bars = Store.Count("CopperOre"), Store.Count("CopperBar")
	UI.Label("Der Schmelzofen verarbeitet Kupfererz zu Barren – dem Grundmetall jeder Waffe.", 14, UI.C.Dim, UI.Font, { Parent = box })
	UI.Label(string.format("<b>Kupfererz:</b> %d      <b>Kupferbarren:</b> %d", ore, bars), 18, UI.C.Text, UI.Font, { Parent = box })
	UI.Label(Config.Smelt.inputAmount .. " Kupfererz → 1 Kupferbarren", 14, UI.C.Copper, UI.FontBold, { Parent = box })
	local r = row(box, 10, 44)
	UI.Button("1 Barren schmelzen", UI.C.Copper, function()
		send("Smelt", 1)
	end, { Size = UDim2.new(0.5, -4, 1, 0), Parent = r })
	UI.Button("Alles schmelzen (" .. math.floor(ore / Config.Smelt.inputAmount) .. ")", UI.C.Card, function()
		send("Smelt", 999)
	end, { Size = UDim2.new(0.5, -4, 1, 0), Parent = r })
end

local function renderResearch()
	local box = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = content }, { UI.List(10) })
	UI.Label(
		"Hier schaltest du neue Waffenformen frei. Riftkristalle findest du in den Ruinen und auf dem riskanten Pfad.",
		14,
		UI.C.Dim,
		UI.Font,
		{ Parent = box }
	)
	for _, id in Config.FormOrder do
		local def = Config.Forms[id]
		local card = UI.Card({ Parent = box })
		UI.List(4).Parent = card
		UI.Label("<b>" .. def.name .. "</b>", 16, UI.C.Text, UI.Font, { Parent = card })
		UI.Label(def.desc, 12, UI.C.Dim, UI.Font, { Parent = card })
		if Store.state.unlocked[id] then
			UI.Label(UI.Colored("✔ Erforscht", UI.C.Good), 13, UI.C.Text, UI.FontBold, { Parent = card })
		elseif def.research then
			UI.Label("Forschung: " .. costText(def.research), 12, UI.C.Text, UI.Font, { Parent = card })
			UI.Button("Erforschen", if hasAll(def.research) then UI.C.Copper else UI.C.Bg, function()
				send("Research", id)
			end, { Size = UDim2.new(0, 160, 0, 32), Parent = card })
		end
	end
end

local chestTarget: number? = nil
local function renderChest()
	local left, right = twoColumns()
	UI.Label(
		"Teile Materialien mit deinem Team. Wähle rechts einen Mitspieler und gib Gegenstände einzeln ab.",
		13,
		UI.C.Dim,
		UI.Font,
		{ LayoutOrder = 0, Parent = left }
	)
	local any = false
	for i, id in Config.ItemOrder do
		local n = Store.Count(id)
		if n > 0 then
			any = true
			local r = row(left, i, 30)
			UI.Label(
				UI.Colored(UI.ItemName(id), Config.Items[id].color) .. "  ×" .. n,
				14,
				UI.C.Text,
				UI.FontBold,
				{ Size = UDim2.new(0.65, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.None, Parent = r }
			)
			UI.Button("Geben", if chestTarget then UI.C.Copper else UI.C.Bg, function()
				if chestTarget then
					send("GiveItem", chestTarget, id)
				else
					toast("Wähle zuerst rechts einen Mitspieler.", "bad")
				end
			end, { Size = UDim2.new(0.3, 0, 1, 0), TextSize = 12, Parent = r })
		end
	end
	if not any then
		UI.Label("Dein Lager ist leer.", 14, UI.C.Dim, UI.Font, { LayoutOrder = 1, Parent = left })
	end
	UI.List(6).Parent = right
	UI.Label("<b>Empfänger</b>", 14, UI.C.Text, UI.Font, { Parent = right })
	local others = 0
	for _, p in Players:GetPlayers() do
		if p ~= player then
			others += 1
			UI.Button(p.DisplayName, if chestTarget == p.UserId then UI.C.Rift else UI.C.Card, function()
				chestTarget = p.UserId
				Panels.Refresh()
			end, { Parent = right })
		end
	end
	if others == 0 then
		UI.Label("Keine Mitspieler auf dem Server.", 13, UI.C.Dim, UI.Font, { Parent = right })
	end
end

--------------------------------------------------------------------------------
-- Expeditionstafel
--------------------------------------------------------------------------------
local chosenDifficulty = "Normal"
local function renderBoard()
	local exp = Store.state.expedition or {}
	local left, right = twoColumns()
	UI.Label("<b>Verdant Scar</b>", 20, UI.C.Rift, UI.FontBlack, { LayoutOrder = 1, Parent = left })
	UI.Label(
		"Außenposten → Überwucherte Ruinen → Kupfermine (sicherer oder riskanter Pfad) → Rift-Kammer mit dem <b>Hollow Warden</b>.",
		13,
		UI.C.Text,
		UI.Font,
		{ LayoutOrder = 2, Parent = left }
	)
	UI.Label(
		"• Beute landet im Rucksack und ist erst am <b>Rückkehrportal</b> sicher.\n• Niedergeschlagen? Teammitglieder beleben dich wieder.\n• Teamwipe: die Hälfte der ungesicherten Grundmaterialien geht verloren. Kerne, Monsterteile und Bossbeute bleiben.\n• Ein <b>Frostsiegel</b> in der Mine öffnet sich nur mit Glut oder Frost.",
		12,
		UI.C.Dim,
		UI.Font,
		{ LayoutOrder = 3, Parent = left }
	)
	section(left, "SCHWIERIGKEIT", 4)
	local r = row(left, 5, 40)
	for _, id in { "Normal", "Hard" } do
		local d = Config.Difficulties[id]
		local isLeader = exp.leaderId == player.UserId
		local active = if exp.phase == "Lobby" then exp.difficulty == id else chosenDifficulty == id
		UI.Button(d.name .. (if id == "Hard" then "  (mehr Beute)" else ""), if active then UI.C.Copper else UI.C.Card, function()
			chosenDifficulty = id
			if exp.phase == "Lobby" and isLeader then
				send("ExpDifficulty", id)
			end
			Panels.Refresh()
		end, { Size = UDim2.new(0.5, -4, 1, 0), Parent = r })
	end

	UI.List(8).Parent = right
	local hasWeapon = Store.Equipped() ~= nil
	if exp.phase == "Idle" or exp.phase == nil then
		UI.Label("Keine Expedition geplant.", 15, UI.C.Text, UI.FontBold, { Parent = right })
		UI.Label("Plane eine Expedition. Mitspieler haben 20 Sekunden, um beizutreten (max. 4).", 12, UI.C.Dim, UI.Font, { Parent = right })
		UI.Button(if hasWeapon then "Expedition planen" else "Erst eine Waffe schmieden", if hasWeapon then UI.C.Copper else UI.C.Bg, function()
			send("ExpCreate", chosenDifficulty)
		end, { Size = UDim2.new(1, 0, 0, 44), Parent = right })
	elseif exp.phase == "Lobby" then
		local left_ = math.max(0, math.ceil((exp.lobbyEnds or 0) - workspace:GetServerTimeNow()))
		UI.Label("Start in <b>" .. left_ .. " s</b>  ·  " .. Config.Difficulties[exp.difficulty].name, 15, UI.C.Text, UI.Font, { Parent = right })
		UI.Label("Gruppe: " .. table.concat(exp.members, ", "), 13, UI.C.Dim, UI.Font, { Parent = right })
		local inLobby = table.find(exp.members, player.DisplayName) ~= nil
		if not inLobby then
			UI.Button("Beitreten", UI.C.Copper, function()
				send("ExpJoin")
			end, { Parent = right })
		else
			if exp.leaderId == player.UserId then
				UI.Button("Jetzt starten", UI.C.Copper, function()
					send("ExpLaunch")
				end, { Size = UDim2.new(1, 0, 0, 44), Parent = right })
			end
			UI.Button("Gruppe verlassen", UI.C.Card, function()
				send("ExpLeave")
			end, { Parent = right })
		end
	elseif exp.phase == "Running" then
		UI.Label("Expedition läuft", 15, UI.C.Text, UI.FontBold, { Parent = right })
		UI.Label("Team: " .. table.concat(exp.participants, ", "), 13, UI.C.Dim, UI.Font, { Parent = right })
		if exp.bossDead then
			UI.Label(UI.Colored("Der Warden wurde besiegt.", UI.C.Good), 13, UI.C.Text, UI.Font, { Parent = right })
		end
		if not Store.state.inRun and #exp.participants < 4 then
			UI.Button("Team beitreten", UI.C.Copper, function()
				send("ExpJoin")
			end, { Parent = right })
		end
	end
end

--------------------------------------------------------------------------------
-- Arsenal & Inventar
--------------------------------------------------------------------------------
local confirmScrap: string? = nil
local confirmAbandon = false
local partPicker: string? = nil

local function itemList(parent: Instance, items: { [string]: number }, order: number, empty: string)
	local any = false
	for i, id in Config.ItemOrder do
		local n = items[id]
		if n and n > 0 then
			any = true
			UI.Label(
				UI.Colored(UI.ItemName(id), Config.Items[id].color) .. "  ×" .. n,
				13,
				UI.C.Text,
				UI.FontBold,
				{ LayoutOrder = order + i, Parent = parent }
			)
		end
	end
	if not any then
		UI.Label(empty, 12, UI.C.Dim, UI.Font, { LayoutOrder = order, Parent = parent })
	end
end

local function renderInventory()
	local s = Store.state
	local left, right = twoColumns()
	right:Destroy()
	local weapons = UI.Scroll({ Position = UDim2.new(0.56, 6, 0, 0), Size = UDim2.new(0.44, -6, 1, 0), Parent = content })
	UI.List(8).Parent = weapons

	if s.inRun then
		section(left, "RUCKSACK (ungesichert)", 1)
		itemList(left, s.backpack, 2, "Leer.")
		section(left, "BOSSBEUTE (geschützt)", 100)
		itemList(left, s.protectedLoot, 101, "–")
		local b = UI.Button(if confirmAbandon then "Wirklich aufgeben? (Teilverlust)" else "Expedition aufgeben", UI.C.Danger, function()
			if confirmAbandon then
				confirmAbandon = false
				send("ExpAbandon")
			else
				confirmAbandon = true
				Panels.Refresh()
			end
		end, { LayoutOrder = 150, Parent = left })
		b.BackgroundTransparency = 0.3
	end
	section(left, "LAGER (gesichert)", 200)
	itemList(left, s.stash, 201, "Leer.")

	section(weapons, "WAFFEN (" .. #s.weapons .. "/" .. Config.MaxWeapons .. ")", 0)
	if #s.weapons == 0 then
		UI.Label("Noch keine Waffe. Geh zur Schmiede im Camp.", 13, UI.C.Dim, UI.Font, { LayoutOrder = 1, Parent = weapons })
	end
	for i, w in s.weapons do
		local card = UI.Card({ LayoutOrder = i, Parent = weapons })
		UI.List(5).Parent = card
		local equipped = s.equipped == w.id
		if equipped then
			UI.Stroke(UI.C.Rift, 2).Parent = card
		end
		local name = UI.WeaponName(w)
		if w.e1 then
			name = UI.Colored(name, Config.Elements[w.e1].color)
		end
		local q = Config.Quality[w.quality or 1]
		UI.Label(
			"<b>" .. name .. "</b>  " .. UI.Colored(q.name, UI.C.Dim) .. (if equipped then UI.Colored("  · ausgerüstet", UI.C.Rift) else ""),
			14,
			UI.C.Text,
			UI.Font,
			{ Parent = card }
		)
		UI.Label("Monsterteil: " .. (if w.part then UI.Colored(UI.ItemName(w.part), UI.C.Copper) else "–"), 12, UI.C.Dim, UI.Font, { Parent = card })
		if not s.inRun then
			local r = row(card, 10, 28)
			if not equipped then
				UI.Button("Ausrüsten", UI.C.Copper, function()
					send("Equip", w.id)
				end, { Size = UDim2.new(0.25, -4, 1, 0), TextSize = 11, Parent = r })
			end
			UI.Button("Monsterteil", UI.C.Card, function()
				partPicker = if partPicker == w.id then nil else w.id
				Panels.Refresh()
			end, { Size = UDim2.new(0.25, -4, 1, 0), TextSize = 11, Parent = r })
			UI.Button("Bauplan", UI.C.Card, function()
				send("SaveBlueprint", w.id)
			end, { Size = UDim2.new(0.22, -4, 1, 0), TextSize = 11, Parent = r })
			UI.Button(if confirmScrap == w.id then "Sicher?" else "Einschmelzen", UI.C.Bg, function()
				if confirmScrap == w.id then
					confirmScrap = nil
					send("Scrap", w.id)
				else
					confirmScrap = w.id
					Panels.Refresh()
				end
			end, { Size = UDim2.new(0.28, -4, 1, 0), TextSize = 11, Parent = r })
			if partPicker == w.id then
				local pr = UI.new(
					"Frame",
					{ BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 11, Parent = card },
					{
						UI.new("UIGridLayout", { CellSize = UDim2.new(0.5, -4, 0, 28), CellPadding = UDim2.fromOffset(4, 4) }),
					}
				)
				if w.part then
					UI.Button("Entfernen", UI.C.Bg, function()
						partPicker = nil
						send("SetPart", w.id, nil)
					end, { TextSize = 11, Parent = pr })
				end
				local anyPart = false
				for _, id in Config.ItemOrder do
					if Config.Items[id].kind == "Part" and Store.Count(id) > 0 then
						anyPart = true
						UI.Button(UI.ItemName(id), UI.C.Card, function()
							partPicker = nil
							send("SetPart", w.id, id)
						end, { TextSize = 11, Parent = pr })
					end
				end
				if not anyPart and not w.part then
					UI.Label("Keine Monsterteile im Lager.", 11, UI.C.Dim, UI.Font, { Parent = pr })
				end
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Aufgaben & Hilfe
--------------------------------------------------------------------------------
local function renderQuests()
	local s = Store.state
	local left, right = twoColumns()
	section(left, "AUFGABEN", 0)
	for i, q in Config.Quests do
		local status = s.quests[q.id] or "open"
		local card = UI.Card({ LayoutOrder = i, Parent = left })
		UI.List(4).Parent = card
		UI.Label("<b>" .. q.title .. "</b>", 15, UI.C.Text, UI.Font, { Parent = card })
		UI.Label(q.desc, 12, UI.C.Dim, UI.Font, { Parent = card })
		local rewards = {}
		for id, n in q.reward do
			table.insert(rewards, n .. "× " .. UI.ItemName(id))
		end
		UI.Label("Belohnung: " .. table.concat(rewards, ", "), 12, UI.C.Copper, UI.Font, { Parent = card })
		if status == "done" then
			UI.Button("Belohnung abholen", UI.C.Copper, function()
				send("ClaimQuest", q.id)
			end, { Size = UDim2.new(0, 170, 0, 30), Parent = card })
		elseif status == "claimed" then
			UI.Label(UI.Colored("✔ Abgeschlossen", UI.C.Good), 12, UI.C.Text, UI.FontBold, { Parent = card })
		end
	end
	UI.List(6).Parent = right
	UI.Label("<b>MEILENSTEINE</b>", 13, UI.C.Rift, UI.FontBlack, { Parent = right })
	for _, m in Config.Milestones do
		local done = s.milestones[m.id]
		UI.Label(
			(if done then UI.Colored("✔ ", UI.C.Good) else UI.Colored("○ ", UI.C.Dim)) .. m.text,
			13,
			if done then UI.C.Text else UI.C.Dim,
			UI.Font,
			{ Parent = right }
		)
	end
end

local function renderHelp()
	local scroll = UI.Scroll({ Parent = content })
	UI.List(8).Parent = scroll
	local text = {
		"<b>Der Kreislauf:</b> Waffe schmieden → Expedition starten → Beute und Elementkerne sammeln → rechtzeitig am Rückkehrportal sichern → neue Waffe schmieden → tiefer ins Rift.",
		"<b>Steuerung (PC):</b> Linksklick leichter Angriff · R oder Rechtsklick schwerer Angriff · Q Ausweichen (kurz unverwundbar) · F Elementfähigkeit · E interagieren · I Arsenal · J Aufgaben.",
		"<b>Controller:</b> R2 leicht · R1 schwer · B ausweichen · Y Element · X interagieren.   <b>Handy:</b> Knöpfe rechts unten.",
		"<b>Ausdauer</b> (gelb) sinkt bei Angriffen und beim Ausweichen. <b>Elementladung</b> füllt sich durch Treffer und Ausweichen – ist sie voll, drücke F.",
		"<b>Perfektes Ausweichen:</b> Weiche genau dann aus, wenn ein angekündigter Angriff (rote Fläche) trifft.",
	}
	for i, t in text do
		UI.Label(t, 13, UI.C.Text, UI.Font, { LayoutOrder = i, Parent = scroll })
	end
	UI.Label("<b>ELEMENTE</b>", 13, UI.C.Rift, UI.FontBlack, { LayoutOrder = 10, Parent = scroll })
	for i, el in Config.ElementOrder do
		local d = Config.Elements[el]
		UI.Label(UI.Colored("<b>" .. d.name .. "</b>", d.color) .. " – " .. d.desc, 12, UI.C.Text, UI.Font, { LayoutOrder = 10 + i, Parent = scroll })
	end
	UI.Label("<b>KOMBINATIONEN</b>", 13, UI.C.Rift, UI.FontBlack, { LayoutOrder = 20, Parent = scroll })
	local i = 0
	for key, c in Config.Combos do
		i += 1
		local a, b = string.match(key, "(%a+)%+(%a+)")
		local names = Config.Elements[a :: string].name .. " + " .. Config.Elements[b :: string].name
		UI.Label("<b>" .. names .. " – " .. c.name .. ":</b> " .. c.desc, 12, UI.C.Text, UI.Font, { LayoutOrder = 20 + i, Parent = scroll })
	end
end

local RENDER: { [string]: () -> () } = {
	Forge = renderForge,
	Furnace = renderFurnace,
	Research = renderResearch,
	Chest = renderChest,
	Board = renderBoard,
	Inventory = renderInventory,
	Quests = renderQuests,
	Help = renderHelp,
}

--------------------------------------------------------------------------------
-- Öffentliche API
--------------------------------------------------------------------------------
function Panels.Refresh()
	if not current or hardeningActive then
		return
	end
	UI.Clear(content)
	titleLabel.Text = TITLES[current] or current
	RENDER[current]()
end

function Panels.Open(name: string)
	if not RENDER[name] then
		return
	end
	if hardeningActive then
		return
	end
	current = name
	window.Visible = true
	Panels.Refresh()
end

function Panels.Close()
	if hardeningActive then
		return
	end
	current = nil
	window.Visible = false
	confirmScrap = nil
	confirmAbandon = false
	partPicker = nil
end

function Panels.Toggle(name: string)
	if current == name then
		Panels.Close()
	else
		Panels.Open(name)
	end
end

function Panels.IsOpen(): boolean
	return current ~= nil or hardeningActive
end

function Panels.Init(toastFn: (string, string?) -> ())
	toast = toastFn
	gui = UI.new("ScreenGui", {
		Name = "RiftboundMenus",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 5,
		Parent = player:WaitForChild("PlayerGui"),
	})
	window = UI.new("Frame", {
		BackgroundColor3 = UI.C.Panel,
		BackgroundTransparency = 0.03,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.92, 0.84),
		Visible = false,
		Active = true,
		Parent = gui,
	}, {
		UI.Corner(12),
		UI.Stroke(UI.C.Stroke, 1.5),
		UI.new("UISizeConstraint", { MaxSize = Vector2.new(860, 560) }),
	})
	titleLabel = UI.new("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(16, 10),
		Size = UDim2.new(1, -80, 0, 30),
		Font = UI.FontBlack,
		TextSize = 22,
		TextColor3 = UI.C.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
		Parent = window,
	})
	UI.Button("✕", UI.C.Card, Panels.Close, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 10),
		Size = UDim2.fromOffset(36, 32),
		Parent = window,
	})
	content = UI.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(16, 52),
		Size = UDim2.new(1, -32, 1, -68),
		Parent = window,
	})

	Net.Event("OpenUI").OnClientEvent:Connect(Panels.Open)
	Store.Changed:Connect(Panels.Refresh)

	-- Lobby-Countdown aktuell halten
	task.spawn(function()
		while true do
			task.wait(1)
			if current == "Board" and (Store.state.expedition or {}).phase == "Lobby" then
				Panels.Refresh()
			end
		end
	end)

	-- Menü schließen, wenn man sich von der Station entfernt
	RunService.Heartbeat:Connect(function()
		if current and current ~= "Inventory" and current ~= "Quests" and current ~= "Help" and not hardeningActive then
			if Store.state.inRun then
				Panels.Close()
			end
		end
	end)
end

return Panels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Store</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Letzter Profil-Snapshot vom Server + Änderungssignal.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)

local Store = {}

Store.state = {
	stash = {},
	weapons = {},
	equipped = nil,
	unlocked = { Sword = true },
	blueprints = {},
	milestones = {},
	quests = {},
	backpack = {},
	protectedLoot = {},
	inRun = false,
	expedition = { phase = "Idle", members = {}, participants = {} },
} :: { [string]: any }

Store.loaded = false

local changed = Instance.new("BindableEvent")
Store.Changed = changed.Event

function Store.Equipped(): any?
	for _, w in Store.state.weapons do
		if w.id == Store.state.equipped then
			return w
		end
	end
	return nil
end

function Store.Count(item: string): number
	return Store.state.stash[item] or 0
end

Net.Event("State").OnClientEvent:Connect(function(snapshot)
	Store.state = snapshot
	Store.loaded = true
	changed:Fire()
end)

return Store
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Kleine UI-Bibliothek: einheitlicher Look für HUD und Menüs.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local UI = {}

UI.C = {
	Bg = Color3.fromRGB(14, 20, 27),
	Panel = Config.Colors.Panel,
	Card = Config.Colors.PanelLight,
	CardHover = Color3.fromRGB(40, 56, 70),
	Stroke = Color3.fromRGB(52, 70, 84),
	Text = Config.Colors.Text,
	Dim = Config.Colors.TextDim,
	Rift = Config.Colors.Rift,
	Copper = Config.Colors.Copper,
	Danger = Config.Colors.Danger,
	Good = Config.Colors.Good,
	Stamina = Config.Colors.Stamina,
}

UI.Font = Enum.Font.GothamMedium
UI.FontBold = Enum.Font.GothamBold
UI.FontBlack = Enum.Font.GothamBlack

function UI.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for k, v in props do
			if k == "Parent" then
				parent = v
			else
				(inst :: any)[k] = v
			end
		end
	end
	if children then
		for _, c in children do
			c.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function UI.Corner(r: number?): UICorner
	return UI.new("UICorner", { CornerRadius = UDim.new(0, r or 8) })
end

function UI.Stroke(color: Color3?, thickness: number?): UIStroke
	return UI.new("UIStroke", { Color = color or UI.C.Stroke, Thickness = thickness or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

function UI.Pad(px: number): UIPadding
	local u = UDim.new(0, px)
	return UI.new("UIPadding", { PaddingTop = u, PaddingBottom = u, PaddingLeft = u, PaddingRight = u })
end

function UI.List(padding: number?, horizontal: boolean?, align: Enum.HorizontalAlignment?): UIListLayout
	return UI.new("UIListLayout", {
		Padding = UDim.new(0, padding or 6),
		FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
		VerticalAlignment = if horizontal then Enum.VerticalAlignment.Center else Enum.VerticalAlignment.Top,
	})
end

function UI.Label(text: string, size: number?, color: Color3?, font: Enum.Font?, props: { [string]: any }?): TextLabel
	local l = UI.new("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		TextSize = size or 14,
		TextColor3 = color or UI.C.Text,
		Font = font or UI.Font,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0),
		RichText = true,
	})
	if props then
		for k, v in props do
			(l :: any)[k] = v
		end
	end
	return l
end

function UI.Button(text: string, color: Color3?, onClick: (() -> ())?, props: { [string]: any }?): TextButton
	local base = color or UI.C.Card
	local b = UI.new("TextButton", {
		Text = text,
		TextSize = 14,
		Font = UI.FontBold,
		TextColor3 = UI.C.Text,
		BackgroundColor3 = base,
		AutoButtonColor = true,
		Size = UDim2.new(1, 0, 0, 34),
		TextWrapped = true,
	}, { UI.Corner(7) })
	if props then
		for k, v in props do
			(b :: any)[k] = v
		end
	end
	if onClick then
		b.Activated:Connect(onClick)
	end
	return b
end

function UI.Scroll(props: { [string]: any }?): ScrollingFrame
	local s = UI.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = UI.C.Stroke,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Size = UDim2.fromScale(1, 1),
	})
	if props then
		for k, v in props do
			(s :: any)[k] = v
		end
	end
	return s
end

function UI.Card(props: { [string]: any }?): Frame
	local f = UI.new("Frame", {
		BackgroundColor3 = UI.C.Card,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	}, { UI.Corner(8), UI.Pad(8) })
	if props then
		for k, v in props do
			(f :: any)[k] = v
		end
	end
	return f
end

function UI.Clear(frame: Instance)
	for _, c in frame:GetChildren() do
		if not c:IsA("UIListLayout") and not c:IsA("UIGridLayout") and not c:IsA("UIPadding") and not c:IsA("UICorner") and not c:IsA("UIStroke") then
			c:Destroy()
		end
	end
end

function UI.Bar(color: Color3, props: { [string]: any }?): (Frame, Frame, TextLabel)
	local back = UI.new("Frame", {
		BackgroundColor3 = Color3.fromRGB(10, 14, 18),
		BackgroundTransparency = 0.15,
		Size = UDim2.new(1, 0, 0, 16),
	}, { UI.Corner(5), UI.Stroke(UI.C.Stroke) })
	local fill = UI.new("Frame", {
		BackgroundColor3 = color,
		Size = UDim2.fromScale(1, 1),
		Parent = back,
	}, { UI.Corner(5) })
	local text = UI.new("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Text = "",
		TextSize = 11,
		Font = UI.FontBold,
		TextColor3 = UI.C.Text,
		TextStrokeTransparency = 0.5,
		ZIndex = 3,
		Parent = back,
	})
	if props then
		for k, v in props do
			(back :: any)[k] = v
		end
	end
	return back, fill, text
end

function UI.ItemName(id: string): string
	local def = Config.Items[id]
	return if def then def.name else id
end

function UI.Hex(c: Color3): string
	return string.format("#%02X%02X%02X", math.floor(c.R * 255), math.floor(c.G * 255), math.floor(c.B * 255))
end

function UI.Colored(text: string, c: Color3): string
	return string.format('<font color="%s">%s</font>', UI.Hex(c), text)
end

function UI.WeaponName(w: any): string
	local name = Config.Forms[w.form].name
	local key = Config.ComboKey(w.e1, w.e2)
	if key then
		return Config.Combos[key].name .. "-" .. name
	elseif w.e1 then
		return Config.Elements[w.e1].name .. "-" .. name
	end
	return name
end

return UI
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>